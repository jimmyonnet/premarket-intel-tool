  window.pm.importWatchlistJson = function(e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(evt) {
      try {
        var parsed = JSON.parse(evt.target.result);
        var list = Array.isArray(parsed) ? parsed : (parsed.watchlist || []);
        var validCodes = [];
        list.forEach(function(c) {
          var sc = String(c).trim();
          if (/^\d{4,5}$/.test(sc) && validCodes.indexOf(sc) < 0) {
            validCodes.push(sc);
          }
        });
        if (validCodes.length > 0) {
          localStorage.setItem(window.WATCH_KEY, JSON.stringify(validCodes));
          var inp = document.getElementById('watch-input');
          if (inp) inp.value = validCodes.join(', ');
          renderWatch();
          if (window.pm.applyWatchOnly) window.pm.applyWatchOnly();
          window.pm.closeBatchModal();
          window.pm.showToast('已成功還原 ' + validCodes.length + ' 檔自選股！');
        } else {
          window.pm.showToast('JSON 檔案內未找到有效的股票代號');
        }
      } catch(err) {
        window.pm.showToast('JSON 解析失敗，請確認檔案格式');
