<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="個人自用，勿分享">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#F8FAFC">
<title>盤前 · {{ date_check.page_says_applies_to or (data_date[5:] if data_date else '今日') }} · 警示 {{ (disposal.one_flag_from_disposal|length) + ((disposal.currently_in_disposal | rejectattr('trading_days_left', 'none') | selectattr('trading_days_left', 'in', ['0', '0天', 0, '出關']) | list)|length) }} · 今日 {{ disposal.one_flag_from_disposal|length }} 檔近處置</title>

<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js').catch(function(err) {
      console.log('SW register failed: ', err);
    });
  }
</script>

<style>
  :root {
    --bg-page: #F8FAFC;
    --bg-card: #FFFFFF;
    --bg-sub: #F1F5F9;
    --bg-hover: #E2E8F0;
    --border: #E2E8F0;
    --border-strong: #CBD5E1;
    --text-main: #0F172A;
    --text-muted: #64748B;
    --text-light: #94A3B8;
    --rise: #E11D48;
    --fall: #16A34A;
    --amber: #D97706;
    --blue: #2563EB;
    --cat-fed: #E11D48;
    --cat-econ: #D97706;
    --cat-stock: #0284C7;
    --cat-futures: #D97706;
    --cat-gen: #64748B;

    --danger-bg: #FFF1F2;
    --danger-fg: #BE123C;
    --danger-border: #FECDD3;

    --amber-bg: #FFFBEB;
    --amber-fg: #92400E;
    --amber-border: #FDE68A;

    --blue-bg: #EFF6FF;
    --blue-fg: #1D4ED8;
    --blue-border: #BFDBFE;

    --green-bg: #ECFDF5;
    --green-fg: #047857;
    --green-border: #A7F3D0;

    --row-paused-bg: rgba(217, 119, 6, 0.08);

    --font-ui: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, "PingFang TC", "Microsoft JhengHei", sans-serif;
    --font-mono: "SF Mono", "Consolas", Menlo, monospace;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -2px rgba(0, 0, 0, 0.06);
  }

  :root[data-theme="dark"] {
    --bg-page: #0B1220;
    --bg-card: #111827;
    --bg-sub: #1F2937;
    --bg-hover: #374151;
    --border: #1F2937;
    --border-strong: #374151;
    --text-main: #F8FAFC;
    --text-muted: #B4BCC8;
    --text-light: #64748B;
    --rise: #FB7185;
    --fall: #4ADE80;
    --amber: #FBBF24;
    --blue: #60A5FA;

    --danger-bg: rgba(225, 29, 72, 0.16);
    --danger-fg: #FDA4AF;
    --danger-border: rgba(225, 29, 72, 0.35);

    --amber-bg: rgba(217, 119, 6, 0.16);
    --amber-fg: #FCD34D;
    --amber-border: rgba(217, 119, 6, 0.35);

    --blue-bg: rgba(37, 99, 235, 0.16);
    --blue-fg: #93C5FD;
    --blue-border: rgba(37, 99, 235, 0.35);

    --green-bg: rgba(16, 185, 129, 0.16);
    --green-fg: #6EE7B7;
    --green-border: rgba(16, 185, 129, 0.35);

    --row-paused-bg: rgba(217, 119, 6, 0.18);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text-main);
    font-family: var(--font-ui);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .font-mono { font-family: var(--font-mono); }
  .font-bold { font-weight: 600; }
  .rise { color: var(--rise) !important; }
  .fall { color: var(--fall) !important; }
  .amber { color: var(--amber) !important; }
  .blue { color: var(--blue) !important; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-wrap { max-width: 980px; margin: 0 auto; padding: 0 16px; }

  /* HEADER */
  .page-header {
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .header-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .page-title {
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }
  .meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
  }
  .meta-val {
    color: var(--text-main);
    font-weight: 600;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .status-badge.is-ok { background: var(--green-bg); color: var(--green-fg); border: 1px solid var(--green-border); }
  .status-badge.is-info { background: var(--blue-bg); color: var(--blue-fg); border: 1px solid var(--blue-border); }
  .status-badge.is-warning { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }

  /* NAV (Sticky Anchor Bar) */
  .page-nav {
    position: sticky;
    top: 0;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    z-index: 50;
    box-shadow: var(--shadow-sm);
    padding: 2px 0;
  }
  .nav-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .nav-inner::-webkit-scrollbar { display: none; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 10px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.15s ease;
  }
  .nav-link:hover, .nav-link.is-active {
    color: var(--text-main);
    background: var(--bg-sub);
  }
  .nav-link.is-active {
    color: var(--blue);
  }
  .nav-badge {
    background: var(--rise);
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 10px;
    font-family: var(--font-mono);
  }
  .nav-actions {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .nav-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 38px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }
  .nav-btn:hover {
    background: var(--bg-hover);
    border-color: var(--text-light);
  }
  .nav-btn.filter-watch-only.is-active {
    background: var(--amber-bg);
    color: var(--amber-fg);
    border-color: var(--amber-border);
  }

  /* CONTENT SECTIONS */
  .page-main {
    max-width: 980px;
    margin: 0 auto;
    padding: 20px 16px 60px;
  }
  .content-section {
    margin-bottom: 32px;
    scroll-margin-top: 76px;
  }
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .section-title {
    font-size: 16px;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .title-icon { font-size: 16px; }
  .section-desc {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* CARDS */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 14px;
    overflow: hidden;
  }
  .card-head {
    padding: 12px 16px;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .card-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }
  .count-badge {
    background: var(--bg-sub);
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 12px;
    font-family: var(--font-mono);
  }
  .count-badge.danger { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }
  .count-badge.amber { background: var(--amber-bg); color: var(--amber-fg); border: 1px solid var(--amber-border); }
  .card-tip {
    font-size: 12px;
    color: var(--text-muted);
  }
  .data-block { padding: 14px 16px; }

  /* 1. SUMMARY GRID */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .summary-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .summary-card.alert-highlight {
    background: var(--danger-bg);
    border-color: var(--danger-border);
  }
  .card-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .card-val {
    font-size: 20px;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .card-val.rise { color: var(--rise); }
  .card-val.fall { color: var(--fall); }
  .card-val.amber { color: var(--amber); }
  .card-sub {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .inst-chips {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
  }
  .inst-chips .chip {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
  }
  .inst-chips-mobile { display: none; }

  /* STALE BANNER */
  .stale-banner {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 16px;
    background: var(--green-bg);
    color: var(--green-fg);
    border: 1px solid var(--green-border);
  }
  .stale-banner.is-warning { background: var(--amber-bg) !important; color: var(--amber-fg) !important; border-color: var(--amber-border) !important; }
  .stale-banner.is-danger  { background: var(--danger-bg) !important; color: var(--danger-fg) !important; border-color: var(--danger-border) !important; }

  /* COUNTDOWN COMPONENT */
  .open-countdown {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
    padding: 8px 0 4px;
    letter-spacing: 0.02em;
    grid-column: 1 / -1;
  }
  .open-countdown.closed { color: var(--text-light); }

  /* WATCHLIST SECTION */
  .watchlist-input-row { display: flex; gap: 8px; align-items: center; padding: 4px 0 10px; flex-wrap: wrap; }
  .watch-input { flex: 1; min-width: 240px; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text-main); font-family: var(--font-mono); font-size: 13px; outline: none; }
  .watch-input:focus { border-color: var(--blue); }
  .watch-btn { padding: 8px 14px; min-height: 38px; border-radius: 6px; border: 1px solid var(--border-strong); background: var(--bg-card); color: var(--text-main); font-size: 13px; font-weight: 600; cursor: pointer; }
  .watch-btn:hover { background: var(--bg-hover); }
  .watch-btn.ghost { background: transparent; color: var(--text-muted); }
  .watch-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .watch-chip {
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 4px 10px;
    font-size: 13px;
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .watch-chip:hover { border-color: var(--blue); }
  .watch-chip .wc-icon { font-size: 11px; }
  .watch-chip .wc-code { color: var(--blue); font-weight: 700; }
  .watch-chip .wc-name { color: var(--text-main); font-weight: 600; }
  .watch-chip.alert { border-left: 3px solid var(--rise); background: var(--danger-bg); color: var(--danger-fg); }
  .watch-chip.amber { border-left: 3px solid var(--amber); background: var(--amber-bg); color: var(--amber-fg); }
  .watch-chip.blue  { border-left: 3px solid var(--blue); background: var(--blue-bg); color: var(--blue-fg); }
  .watch-chip .wc-del { cursor: pointer; color: var(--text-light); margin-left: 2px; }
  .watch-chip .wc-del:hover { color: var(--rise); }
  .watch-hint { color: var(--text-muted); font-size: 12px; padding: 6px 0; }

  /* FLASH HIGHLIGHT */
  @keyframes flash-pulse {
    0%, 100% { outline: 2px solid transparent; }
    50% { outline: 2px solid var(--amber); background: var(--amber-bg); }
  }
  .highlight-flash {
    animation: flash-pulse 1s ease 2;
  }

  /* DATA TABLES */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }
  .data-table th {
    background: var(--bg-sub);
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
  }
  .data-table th:hover {
    color: var(--text-main);
    background: var(--bg-hover);
  }
  .data-table th .sort-arrow { font-size: 9px; margin-left: 4px; opacity: 0.5; }
  .data-table th.sorted .sort-arrow { opacity: 1; color: var(--blue); }
  .data-table td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
    color: var(--text-main);
  }
  .data-table tr:hover td { background: var(--bg-sub); }
  .data-table tr.row-paused td { background: var(--row-paused-bg); }
  .pause-icon { display: inline-block; margin-right: 4px; color: var(--amber); font-weight: 700; }
  .data-table td.num, .data-table th.num { text-align: right; }
  .empty-state {
    padding: 24px;
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
  }

  /* 2-LINE CONDITION LAYOUT */
  .cond-box {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12px;
  }
  .cond-row-1 {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }
  .cond-num-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--green-bg);
    color: var(--green-fg);
    border: 1px solid var(--green-border);
    font-size: 11px;
    font-weight: 700;
  }
  .cond-row-2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  .cond-pill {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--bg-sub);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .cond-row-3 {
    color: var(--text-light);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  /* BADGE DOTS */
  .badge-col { text-align: center; }
  .badge-dots { display: inline-flex; gap: 2px; }
  .badge-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .badge-dots .dot.filled { background: var(--amber); }
  .badge-frac { font-size: 11px; color: var(--text-muted); margin-left: 4px; }
  .mini-bar {
    display: none;
    position: relative;
    width: 48px;
    height: 14px;
    background: var(--bg-sub);
    border-radius: 3px;
    overflow: hidden;
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
    text-align: center;
    color: var(--text-main);
  }
  .mini-bar::before {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: var(--pct, 0%);
    background: var(--amber);
    opacity: 0.35;
  }

  /* BADGES */
  .badge {
    display: inline-flex;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    background: var(--bg-sub);
    color: var(--text-muted);
  }
  .badge-amber { background: var(--amber-bg); color: var(--amber-fg); border: 1px solid var(--amber-border); }
  .badge-green { background: var(--green-bg); color: var(--green-fg); border: 1px solid var(--green-border); }
  .badge-blue { background: var(--blue-bg); color: var(--blue-fg); border: 1px solid var(--blue-border); }

  /* IFRAME EMBEDS */
  .unref-accordion {
    border-bottom: 1px solid var(--border);
  }
  .unref-accordion:last-child { border-bottom: none; }
  .unref-summary {
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
    background: var(--bg-card);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .unref-summary:hover { background: var(--bg-sub); }
  .unref-content { padding: 12px 16px; background: var(--bg-sub); }
  .embed-frame {
    width: 100%;
    border: none;
    border-radius: 6px;
    background: #FFFFFF;
    transition: height 0.2s ease;
  }

  /* TILES GRID */
  .tiles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }
  .tile-card {
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .tile-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .tile-name { font-size: 12px; font-weight: 700; color: var(--text-main); }
  .tile-delay-pill {
    font-size: 10px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .pill-fresh { background: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border); }
  .pill-amber { background: var(--amber-bg); color: var(--amber-fg); border: 1px solid var(--amber-border); }
  .pill-danger { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }
  .tile-val { font-size: 15px; font-weight: 800; }
  .tile-chg { font-size: 11px; font-weight: 600; }

  /* BACK TO TOP */
  .back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    transition: all 0.2s ease;
  }
  .back-to-top:hover {
    background: var(--bg-sub);
    transform: translateY(-2px);
  }

  /* TOAST */
  .toast {
    position: fixed;
    bottom: 24px;
    left: 24px;
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-md);
    padding: 10px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    z-index: 100;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease;
    pointer-events: none;
  }
  .toast.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* SHORTCUTS MODAL */
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    z-index: 150;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .modal-overlay.open { display: flex; }
  .modal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--shadow-md);
    padding: 20px;
  }
  .modal-title { font-size: 16px; font-weight: 800; margin: 0 0 14px; color: var(--text-main); }
  .shortcut-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px; }
  .shortcut-item { display: flex; align-items: center; gap: 8px; }
  .kbd {
    display: inline-block;
    padding: 2px 6px;
    background: var(--bg-sub);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-main);
  }

  /* SNAPSHOT / PRINT MODE */
  body.snapshot-mode .page-nav,
  body.snapshot-mode .page-header,
  body.snapshot-mode .stale-banner,
  body.snapshot-mode .page-footer,
  body.snapshot-mode #news-calendar,
  body.snapshot-mode #market-context,
  body.snapshot-mode .back-to-top {
    display: none !important;
  }
  body.snapshot-mode .page-main { padding: 10px 0; max-width: 100%; }

  @media print {
    .page-nav, .stale-banner, .page-footer, .back-to-top, .watchlist-input-row, .unref-accordion { display: none !important; }
    body { background: #FFFFFF; color: #000000; }
    .card { border: 1px solid #CCCCCC; box-shadow: none; }
    .rise::before { content: '▲ '; }
    .fall::before { content: '▼ '; }
  }

  /* MOBILE RESPONSIVE (max-width: 768px) */
  @media (max-width: 768px) {
    .summary-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .tiles-grid { grid-template-columns: repeat(2, 1fr); }
    .badge-dots { display: none; }
    .mini-bar { display: inline-block; }
    
    .inst-chips { display: none; }
    .inst-chips-mobile { display: block; font-size: 12px; margin-top: 4px; }

    .data-table thead { display: none; }
    .data-table, .data-table tbody, .data-table tr, .data-table td { display: block; }
    .data-table tr {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 10px;
      background: var(--bg-card);
    }
    .data-table td {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 6px;
      padding: 4px 0;
      border-bottom: 1px solid var(--border);
    }
    .data-table td:last-child { border-bottom: none; }
    .data-table td::before {
      content: attr(data-label);
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
    }
    .data-table td.num { text-align: left; }
    .data-table td.badge-col { text-align: left; }
  }

  /* FOOTER */
  .page-footer {
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    padding: 24px 0;
    font-size: 12px;
    color: var(--text-muted);
  }
  .footer-inner { max-width: 980px; margin: 0 auto; padding: 0 16px; }
  .footer-title { font-weight: 700; color: var(--text-main); margin-bottom: 8px; }
  .footer-notes { padding-left: 18px; margin: 0 0 8px; line-height: 1.6; }
</style>
</head>
<body>

  <!-- HEADER -->
  <header class="page-header">
    <div class="header-inner">
      <div class="header-main">
        <h1 class="page-title">盤前情報準備台</h1>
      </div>
      <div class="meta-row">
        <span class="meta-item"><span class="meta-label">產生時間</span> <span class="meta-val font-mono">{{ generated_at }}</span></span>
        {% if date_check and date_check.page_says_applies_to %}
        <span class="meta-item"><span class="meta-label">資料日期</span> <span class="meta-val font-mono">{{ date_check.page_says_applies_to }}</span></span>
        {% endif %}
        <span class="meta-status" id="date-status-container">
          {% if date_check_eval %}
          <span class="status-badge {{ date_check_eval.class_name }}" title="{{ date_check_eval.tooltip }}">{{ date_check_eval.label }}</span>
          {% elif date_check %}
          <span class="status-badge is-ok">資料已就緒</span>
          {% endif %}
        </span>
      </div>
    </div>
  </header>

  <!-- NAV (Sticky Anchor Bar) -->
  <nav class="page-nav" id="sticky-nav">
    <div class="nav-inner">
      <a href="#summary" class="nav-link is-active">今日摘要</a>
      <a href="#self-watchlist" class="nav-link">我在看</a>
      {% set exiting_today = disposal.currently_in_disposal | rejectattr('trading_days_left', 'none') | selectattr('trading_days_left', 'in', ['0', '0天', 0, '出關']) | list %}
      {% set hidden_disposal = disposal.currently_in_disposal | selectattr('trading_days_left', 'none') | list %}
      {% set alert_total = (disposal.one_flag_from_disposal|length) + (exiting_today|length) %}
      <a href="#alerts" class="nav-link nav-alert tab-pill" data-count="{{ alert_total }}">今日警示 {% if alert_total > 0 %}<span class="nav-badge" id="nav-alert-badge">{{ alert_total }}</span>{% endif %}{% if stale_hours and stale_hours > 12 %}<span class="nav-badge" style="background:var(--amber); color:#FFF; margin-left:4px;">⚠️ 資料過期</span>{% endif %}</a>
      <a href="#watchlist" class="nav-link">今日候選股</a>
      <a href="#market-context" class="nav-link">市場背景</a>
      <a href="#news-calendar" class="nav-link">補充資訊</a>
      <a href="#system-info" class="nav-link">系統資訊</a>
      
      <div class="nav-actions">
        <button class="nav-btn filter-watch-only" id="filter-watch-toggle" onclick="window.pm.toggleWatchOnly()" type="button" aria-label="切換只看自選">⭐ 只看自選</button>
        <button class="nav-btn btn-snapshot" onclick="window.pm.toggleSnapshot()" type="button" aria-label="切換截圖模式">📸 截圖</button>
        <button class="nav-btn theme-toggle" onclick="window.toggleTheme()" id="theme-toggle" type="button" aria-label="切換深淺色主題">🌙 深色</button>
        <button class="nav-btn refresh-btn" onclick="location.reload(true)" type="button" title="重新載入最新版" aria-label="重新整理頁面">
          🔄 <span class="last-build">建置 {{ (meta.build_time if meta is defined and meta and meta.build_time else (build_time or '08:00')) }}</span>
        </button>
      </div>
    </div>
  </nav>

  <main class="page-main">

    <!-- Stale Banner -->
    <div class="stale-banner" data-hours="{{ ((meta.stale_hours if meta is defined and meta.stale_hours is defined else stale_hours) or 0)|int }}">
      資料時間 {{ (meta.data_date if meta is defined and meta.data_date else None) or data_date or '今日' }}，距今 {{ (meta.stale_hours if meta is defined and meta.stale_hours is defined else stale_hours) or 0 }} 小時
    </div>

    <!-- 1. 摘要 (Summary) -->
    <section id="summary" class="content-section">
      <div class="summary-grid">
        <!-- 昨收大盤 -->
        <div class="summary-card">
          <div class="card-label">加權指數 昨收</div>
          {% if twse and twse.twii %}
          <div class="card-val font-mono {% if twse.twii.change > 0 %}rise{% elif twse.twii.change < 0 %}fall{% endif %}">
            {{ "{:,.2f}".format(twse.twii.price) }}
          </div>
          <div class="card-sub font-mono {% if twse.twii.change > 0 %}rise{% elif twse.twii.change < 0 %}fall{% endif %}">
            {% if twse.twii.change > 0 %}+{% endif %}{{ twse.twii.change }} ({{ '%+.2f'|format(twse.twii.change_pct) }}%)
          </div>
          {% else %}
          <div class="card-val font-mono">—</div>
          {% endif %}
        </div>

        <!-- 三大法人買賣超 (外資 / 投信 / 自營商) -->
        <div class="summary-card">
          <div class="card-label">三大法人買賣超</div>
          <div class="inst-chips font-mono">
            {% if twse and twse.inst %}
              {% if twse.inst.foreign is not none %}
              <div class="chip"><span class="chip-label">外資</span> <span class="{% if twse.inst.foreign > 0 %}rise{% elif twse.inst.foreign < 0 %}fall{% endif %}">{% if twse.inst.foreign > 0 %}+{% endif %}{{ twse.inst.foreign }}億</span></div>
              {% endif %}
              {% if twse.inst.trust is not none %}
              <div class="chip"><span class="chip-label">投信</span> <span class="{% if twse.inst.trust > 0 %}rise{% elif twse.inst.trust < 0 %}fall{% endif %}">{% if twse.inst.trust > 0 %}+{% endif %}{{ twse.inst.trust }}億</span></div>
              {% endif %}
              {% if twse.inst.dealer is not none %}
              <div class="chip"><span class="chip-label">自營商</span> <span class="{% if twse.inst.dealer > 0 %}rise{% elif twse.inst.dealer < 0 %}fall{% endif %}">{% if twse.inst.dealer > 0 %}+{% endif %}{{ twse.inst.dealer }}億</span></div>
              {% endif %}
            {% endif %}
          </div>
          <div class="inst-chips-mobile font-mono">
            {% if twse and twse.inst %}
            外資 <span class="{% if twse.inst.foreign > 0 %}rise{% else %}fall{% endif %}">{% if twse.inst.foreign > 0 %}+{% endif %}{{ twse.inst.foreign|round(0)|int }}</span> · 投信 <span class="{% if twse.inst.trust > 0 %}rise{% else %}fall{% endif %}">{% if twse.inst.trust > 0 %}+{% endif %}{{ twse.inst.trust|round(0)|int }}</span> · 自營 <span class="{% if twse.inst.dealer > 0 %}rise{% else %}fall{% endif %}">{% if twse.inst.dealer > 0 %}+{% endif %}{{ twse.inst.dealer|round(0)|int }}</span>
            {% endif %}
          </div>
        </div>

        <!-- 市場未反映公告 -->
        {% set unref_count = (financials.att|length if financials.att else 0) + (financials.fin|length if financials.fin else 0) + (financials.rev|length if financials.rev else 0) %}
        <div class="summary-card {% if unref_count > 0 %}alert-highlight{% endif %}">
          <div class="card-label">市場未反映公告</div>
          <div class="card-val font-mono {% if unref_count > 0 %}rise{% endif %}">
            {{ unref_count }} <span class="unit" style="font-size:14px; font-weight:normal;">筆</span>
          </div>
          <div class="card-sub">{{ financials.cutoff_str or '昨日 13:30' }} 後公告</div>
        </div>

        <!-- 台指期夜盤 -->
        {% if night and night.latest %}
        <div class="summary-card">
          <div class="card-label">台指期夜盤 (05:00){% if night and night.latest and (night.latest.provider_name or night.provider_name) %} · 來源：{{ night.latest.provider_name or night.provider_name }}{% endif %}</div>
          {% if night.latest.is_fallback %}
          <div class="card-sub amber font-bold" style="font-size:10px; margin-bottom:2px;">⚠️ 抓取失敗，使用最近一次 fixtures/{{ night.date }}</div>
          {% endif %}
          <div class="card-val font-mono {% if night.latest.change > 0 %}rise{% elif night.latest.change < 0 %}fall{% endif %}">
            {{ "{:,.0f}".format(night.latest.price) if night.latest.price is not none else '—' }}
          </div>
          <div class="card-sub font-mono {% if night.latest.change > 0 %}rise{% elif night.latest.change < 0 %}fall{% endif %}">
            {% if night.latest.change is not none %}{% if night.latest.change > 0 %}+{% endif %}{{ night.latest.change }} ({{ '%+.2f'|format(night.latest.change_pct) }}%){% endif %}
          </div>
        </div>
        {% endif %}
        
        <div id="open-countdown" class="open-countdown"></div>
      </div>
    </section>

    <!-- Self Watchlist -->
    <section id="self-watchlist" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">⭐</span> 我在看</h2>
        <span class="section-desc">輸入台股代號（逗號分隔），存於 localStorage</span>
      </div>
      <div class="watchlist-input-row">
        <input id="watch-input" class="watch-input" placeholder="例如 2330, 2454, 3163（按 Enter 儲存）" autocomplete="off" aria-label="輸入自選股代號">
        <button class="watch-btn" onclick="window.saveWatch()" type="button" aria-label="儲存自選股">儲存</button>
        <button class="watch-btn ghost" onclick="window.clearWatch()" type="button" aria-label="清空自選股">清空</button>
      </div>
      <div id="watch-chips" class="watch-chips"></div>
      <div class="watch-hint" id="watch-hint"></div>
    </section>

    <!-- 2. 今日警示 (Alerts) -->
    <section id="alerts" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">⚠️</span> 今日警示</h2>
        <span class="section-desc">處置股預警、今日出關與盤後重大財務自結</span>
      </div>

      <!-- 差 1 次即處置 -->
      <div class="card alert-card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">差 1 次就處置</h3>
            <span class="count-badge danger">{{ disposal.one_flag_from_disposal|length }} 檔</span>
          </div>
          <span class="card-tip">今日若再觸發標準即進入處置</span>
        </div>

        <div class="data-block">
          {% if disposal.one_flag_from_disposal %}
          <div class="table-scroll">
            <table class="data-table disposal-table">
              <caption class="sr-only">差 1 次就處置股票清單</caption>
              <thead>
                <tr>
                  <th onclick="window.pm.sortTable(this, 0)">市場 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 1)">代號 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 2)">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 3)">收盤 <span class="sort-arrow">▲▼</span></th>
                  <th>處置標準條件</th>
                  <th class="num" onclick="window.pm.sortTable(this, 5)">最快處置 <span class="sort-arrow">▲▼</span></th>
                  <th class="badge-col" title="連續3日第1款">3①</th>
                  <th class="badge-col" title="連續5日（第1~7款）">5</th>
                  <th class="badge-col" title="10日內6次（第1~7款）">6</th>
                  <th class="badge-col" title="30日內12次（第1~7款）">12</th>
                </tr>
              </thead>
              <tbody>
                {% for row in disposal.one_flag_from_disposal %}
                {% set is_paused = ('⏸' in row.code) %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                <tr data-code="{{ clean_code }}" data-cat="alert" data-label="{{ row.name }}" class="{{ 'row-paused' if is_paused else '' }}">
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono">
                    {% if is_paused %}<span class="pause-icon" title="處置中">⏸</span>{% endif %}{{ clean_code }}
                  </td>
                  <td data-label="名稱" class="name font-bold">{{ row.name }}</td>
                  <td data-label="收盤" class="num font-mono">{{ row.close }}</td>
                  <td data-label="處置條件" class="condition">
                    <div class="cond-box">
                      {% if row.condition_segments %}
                      <div class="cond-row-2">
                        {% for seg in row.condition_segments %}
                        <span class="cond-pill font-mono"{% if seg.color %} style="color:{{ seg.color }}{{ ';font-weight:700' if seg.bold else '' }}"{% endif %}>{{ seg.text }}</span>
                        {% endfor %}
                      </div>
                      {% else %}
                      <span>{{ row.condition }}</span>
                      {% endif %}
                    </div>
                  </td>
                  <td data-label="最快處置" class="num font-mono">
                    {% set ed_parts = row.earliest_disposal.split(' ', 1) %}
                    {% if ed_parts|length == 2 %}
                      <span>{{ ed_parts[0] }}</span>
                      <span class="badge badge-amber">{{ ed_parts[1] }}</span>
                    {% else %}
                      <span>{{ row.earliest_disposal }}</span>
                    {% endif %}
                  </td>
                  {% set badge_labels = ['3① 連3第1款', '5 連5第1~7款', '6 10日內6次', '12 30日內12次'] %}
                  {% for bd in row.badges or [{}, {}, {}, {}] %}
                  <td data-label="{{ badge_labels[loop.index0] }}" class="badge-col"{% if bd.title %} title="{{ bd.title }}"{% endif %}>
                    {% if bd.threshold %}
                    <div class="badge-dots" title="{{ bd.current }}/{{ bd.threshold }}">
                      {% for i in range(bd.threshold) %}<span class="dot{{ ' filled' if i < bd.current else '' }}"></span>{% endfor %}
                      <span class="badge-frac font-mono">{{ bd.current }}/{{ bd.threshold }}</span>
                    </div>
                    <div class="mini-bar font-mono" style="--pct:{{ (bd.current / bd.threshold * 100)|round(1) }}%">{{ bd.current }}/{{ bd.threshold }}</div>
                    {% else %}
                    <span class="badge-frac">—</span>
                    {% endif %}
                  </td>
                  {% endfor %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <div class="empty-state">今日無差 1 次即處置的標的</div>
          {% endif %}
        </div>
      </div>

      <!-- 今日出關 -->
      <div class="card alert-card-amber">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">今日出關</h3>
            <span class="count-badge amber">{{ exiting_today|length }} 檔</span>
          </div>
          <span class="card-tip">處置期屆滿，今日恢復正常撮合</span>
        </div>

        <div class="data-block">
          {% if exiting_today %}
          <div class="table-scroll">
            <table class="data-table">
              <caption class="sr-only">今日出關股票清單</caption>
              <thead>
                <tr>
                  <th onclick="window.pm.sortTable(this, 0)">市場 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 1)">代號 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 2)">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 3)">原撮合 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 4)">處置起訖 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 5)">預計出關 <span class="sort-arrow">▲▼</span></th>
                  <th>處置原因</th>
                </tr>
              </thead>
              <tbody>
                {% for row in exiting_today %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                <tr data-code="{{ clean_code }}" data-cat="amber" data-label="{{ row.name }}">
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono">{{ clean_code }}</td>
                  <td data-label="名稱" class="name font-bold">{{ row.name }}</td>
                  <td data-label="原撮合"><span class="badge">{{ row.matching }}</span></td>
                  <td data-label="處置起訖" class="font-mono">{{ row.start_date }} ~ {{ row.end_date }}</td>
                  <td data-label="預計出關" class="font-mono font-bold amber">{{ row.exit_date }}</td>
                  <td data-label="處置原因" class="reason">{{ row.reason }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <div class="empty-state">今日無處置期滿出關的標的</div>
          {% endif %}
        </div>
      </div>
      {% if hidden_disposal|length > 0 %}
      <!-- 隱藏 {{ hidden_disposal|length }} 筆（資料缺欄位，請回報） -->
      {% endif %}

      <!-- 市場未反映財務公告 (Iframes) -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">市場未反映公告</h3>
            <span class="count-badge">{{ unref_count }} 筆</span>
          </div>
          <span class="card-tip">昨日 13:30 盤後即時重訊</span>
        </div>

        <div class="data-block" style="padding:0;">
          <details class="unref-accordion" open>
            <summary class="unref-summary">
              <span>即時自結（市場未反映 {{ financials.att|length if financials.att else 0 }} 筆）</span>
              <span class="badge badge-blue">{{ financials.att|length if financials.att else 0 }} 筆</span>
            </summary>
            <div class="unref-content">
              <iframe src="embed/att.html" id="embed-att" class="embed-frame" loading="lazy" importance="low" referrerpolicy="no-referrer" style="height:480px;"></iframe>
            </div>
          </details>

          <details class="unref-accordion">
            <summary class="unref-summary">
              <span>即時季報（市場未反映 {{ financials.fin|length if financials.fin else 0 }} 筆）</span>
              <span class="badge">{{ financials.fin|length if financials.fin else 0 }} 筆</span>
            </summary>
            <div class="unref-content">
              <iframe src="embed/fin.html" id="embed-fin" class="embed-frame" loading="lazy" importance="low" referrerpolicy="no-referrer" style="height:480px;"></iframe>
            </div>
          </details>

          <details class="unref-accordion">
            <summary class="unref-summary">
              <span>即時營收（市場未反映 {{ financials.rev|length if financials.rev else 0 }} 筆）</span>
              <span class="badge">{{ financials.rev|length if financials.rev else 0 }} 筆</span>
            </summary>
            <div class="unref-content">
              <iframe src="embed/rev.html" id="embed-rev" class="embed-frame" loading="lazy" importance="low" referrerpolicy="no-referrer" style="height:480px;"></iframe>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- 3. 今日候選股 (Watchlist) -->
    <section id="watchlist" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">🎯</span> 今日候選股</h2>
        <span class="section-desc">盤前族群整理、法人動向與主力當沖籌碼明細</span>
      </div>

      {% if pressplay._status == 'fetch_failed' %}
      <div class="part3-error">
        <strong>Part 3（PressPlay 摘要）收集失敗。</strong>
        請到 GitHub <code>Actions → build-premarket-page</code> 查看 Logs；其他章節照常運作，不受影響。
      </div>
      {% elif (pressplay.not_found_group.matched|length == 0 and pressplay.found_group.matched|length == 0) and (pressplay.not_found_group.unmatched|length == 0 and pressplay.found_group.unmatched|length == 0) %}
      <div class="part3-empty">尚無資料（PressPlay 收集流程跑過，但今天沒有盤前文章）。</div>
      {% else %}

      <!-- 族群聚焦標的 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">族群聚焦標的</h3>
            <span class="count-badge">{{ pressplay.found_group.matched|length }} 檔</span>
          </div>
          <span class="card-tip">已比對 {{ pressplay.found_group.raw_tokens|length }} 檔，共 {{ pressplay.found_group.matched|length }} 檔具明確族群連動</span>
        </div>

        <div class="data-block">
          {% if pressplay.found_group.matched %}
          <div class="table-scroll">
            <table class="data-table">
              <caption class="sr-only">族群聚焦標的清單</caption>
              <thead>
                <tr>
                  <th onclick="window.pm.sortTable(this, 0)">市場 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 1)">代號 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 2)">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 3)">收盤 <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 4)">量(張) <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 5)">外資(張) <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 6)">投信(張) <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 7)">自營(張) <span class="sort-arrow">▲▼</span></th>
                </tr>
              </thead>
              <tbody>
                {% for row in pressplay.found_group.matched %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                <tr data-code="{{ clean_code }}" data-cat="normal" data-label="{{ row.name }}">
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono">{{ clean_code }}</td>
                  <td data-label="名稱" class="name font-bold">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">模糊比對</span>{% endif %}</td>
                  <td data-label="收盤" class="num font-mono">{{ row.close }}</td>
                  <td data-label="量(張)" class="num font-mono">{{ row.volume }}</td>
                  <td data-label="外資(張)" class="num font-mono {% if row.foreign and '+' in row.foreign %}rise{% elif row.foreign and '-' in row.foreign %}fall{% endif %}">{{ row.foreign }}</td>
                  <td data-label="投信(張)" class="num font-mono {% if row.trust and '+' in row.trust %}rise{% elif row.trust and '-' in row.trust %}fall{% endif %}">{{ row.trust }}</td>
                  <td data-label="自營(張)" class="num font-mono {% if row.dealer and '+' in row.dealer %}rise{% elif row.dealer and '-' in row.dealer %}fall{% endif %}">{{ row.dealer }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <div class="empty-state">今日無明確族群連動標的</div>
          {% endif %}
        </div>
      </div>

      <!-- 無明確族群標的 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">無明確族群標的</h3>
            <span class="count-badge">{{ pressplay.not_found_group.matched|length }} 檔</span>
          </div>
          <span class="card-tip">獨立題材或個股動能</span>
        </div>

        <div class="data-block">
          {% if pressplay.not_found_group.matched %}
          <div class="table-scroll">
            <table class="data-table">
              <caption class="sr-only">無明確族群標的清單</caption>
              <thead>
                <tr>
                  <th onclick="window.pm.sortTable(this, 0)">市場 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 1)">代號 <span class="sort-arrow">▲▼</span></th>
                  <th onclick="window.pm.sortTable(this, 2)">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 3)">收盤 <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 4)">量(張) <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 5)">外資(張) <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 6)">投信(張) <span class="sort-arrow">▲▼</span></th>
                  <th class="num" onclick="window.pm.sortTable(this, 7)">自營(張) <span class="sort-arrow">▲▼</span></th>
                </tr>
              </thead>
              <tbody>
                {% for row in pressplay.not_found_group.matched %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                <tr data-code="{{ clean_code }}" data-cat="normal" data-label="{{ row.name }}">
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono">{{ clean_code }}</td>
                  <td data-label="名稱" class="name font-bold">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">模糊比對</span>{% endif %}</td>
                  <td data-label="收盤" class="num font-mono">{{ row.close }}</td>
                  <td data-label="量(張)" class="num font-mono">{{ row.volume }}</td>
                  <td data-label="外資(張)" class="num font-mono {% if row.foreign and '+' in row.foreign %}rise{% elif row.foreign and '-' in row.foreign %}fall{% endif %}">{{ row.foreign }}</td>
                  <td data-label="投信(張)" class="num font-mono {% if row.trust and '+' in row.trust %}rise{% elif row.trust and '-' in row.trust %}fall{% endif %}">{{ row.trust }}</td>
                  <td data-label="自營(張)" class="num font-mono {% if row.dealer and '+' in row.dealer %}rise{% elif row.dealer and '-' in row.dealer %}fall{% endif %}">{{ row.dealer }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <div class="empty-state">今日無獨立題材標的</div>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </section>

    <!-- 4. 市場背景 (Market Context) -->
    <section id="market-context" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">🌐</span> 市場背景</h2>
        <span class="section-desc">美股收盤、跨海連動 ADR 與亞股早盤概況</span>
      </div>

      <!-- 美股四大指數 & 跨海連動 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">美股四大指數與跨海連動標的</h3>
          </div>
          <span class="card-tip font-mono">美股 · 昨日收盤（美東 16:00）· 資料延遲 {{ hours_since_us_close if hours_since_us_close is defined else 18.9 }} 小時</span>
        </div>

        <div class="data-block">
          <!-- 美股四大指數 (Row 1) -->
          <div class="tiles-grid">
            {% for symbol, label in [('^GSPC', '標普 500'), ('^IXIC', '那斯達克'), ('^DJI', '道瓊工業'), ('^SOX', '費城半導體')] %}
            {% set q = us_indices[symbol] if (us_indices and symbol in us_indices) else indices.get(symbol) %}
            <div class="tile-card">
              <div class="tile-head">
                <span class="tile-name">{{ label }}</span>
                <span class="tile-delay-pill {{ 'pill-fresh' if (hours_since_us_close if hours_since_us_close is defined else 18.9) < 24 else ('pill-amber' if (hours_since_us_close if hours_since_us_close is defined else 18.9) <= 36 else 'pill-danger') }}">{{ hours_since_us_close if hours_since_us_close is defined else 18.9 }}h ago</span>
              </div>
              {% if q and q.price is not none %}
              <div class="tile-val font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{{ "{:,.2f}".format(q.price) }}</div>
              <div class="tile-chg font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{% if q.change > 0 %}+{% endif %}{{ q.change }} ({{ '%+.2f'|format(q.change_pct) }}%)</div>
              {% else %}
              <div class="tile-val font-mono">—</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>

          <!-- 跨海連動 ADR / 關鍵標的 (Row 2) -->
          <div class="tiles-grid">
            {% for symbol, label in [('TSM', '台積電 ADR'), ('NVDA', '輝達 (NVDA)'), ('AAPL', '蘋果 (AAPL)'), ('2330.TW', '台積電 現貨')] %}
            {% set q = indices.get(symbol) %}
            <div class="tile-card">
              <div class="tile-head">
                <span class="tile-name">{{ label }}</span>
              </div>
              {% if q and q.price is not none %}
              <div class="tile-val font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{{ "{:,.2f}".format(q.price) }}</div>
              <div class="tile-chg font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{% if q.change > 0 %}+{% endif %}{{ q.change }} ({{ '%+.2f'|format(q.change_pct) }}%)</div>
              {% else %}
              <div class="tile-val font-mono">—</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- 亞股開盤走勢 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">亞股開盤即時概況</h3>
          </div>
          <span class="card-tip">日韓早盤開盤表現</span>
        </div>

        <div class="data-block">
          <div class="tiles-grid" style="grid-template-columns: repeat(2, 1fr); margin-bottom:0;">
            {% for symbol, label in [('^N225', '日經 225'), ('^KS11', '韓國 KOSPI')] %}
            {% set q = asia_open[symbol] if (asia_open and symbol in asia_open) else indices.get(symbol) %}
            <div class="tile-card">
              <div class="tile-head"><span class="tile-name">{{ label }}</span></div>
              {% if q and q.price is not none %}
              <div class="tile-val font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{{ "{:,.2f}".format(q.price) }}</div>
              <div class="tile-chg font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{% if q.change > 0 %}+{% endif %}{{ q.change }} ({{ '%+.2f'|format(q.change_pct) }}%)</div>
              {% else %}
              <div class="tile-val font-mono">—</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. 補充資訊 (News & Calendar) -->
    <section id="news-calendar" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">📰</span> 補充資訊</h2>
        <span class="section-desc">隔夜重大新聞與財經行事曆</span>
      </div>

      <!-- 隔夜重大新聞 -->
      {% if news %}
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">隔夜重大新聞 Top 5</h3>
            <span class="count-badge">{{ news|length }} 則</span>
          </div>
        </div>
        <div class="data-block">
          <div class="news-list" style="display:flex; flex-direction:column; gap:8px;">
            {% for a in news %}
            <a href="{{ a.link }}" target="_blank" rel="noopener" class="news-item" style="text-decoration:none; color:inherit; padding:8px 0; border-bottom:1px solid var(--border);">
              <div class="news-title" style="font-weight:600; font-size:13px; margin-bottom:4px;">{{ a.title }}</div>
              <div class="news-meta font-mono" style="font-size:11px; color:var(--text-muted); display:flex; gap:12px;">
                <span>{{ a.source }}</span>
                <span>{{ a.time }}</span>
              </div>
            </a>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}

      <!-- 財經行事曆 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">財經行事曆</h3>
            <span class="count-badge">{{ calendar.events|length }} 筆事件</span>
          </div>
        </div>

        <div class="data-block">
          {% if calendar.events %}
          <div class="cal-list" style="display:flex; flex-direction:column; gap:10px;">
            {% for ev in calendar.events %}
            <div class="cal-event-card" style="background:var(--bg-sub); border:1px solid var(--border); border-radius:6px; padding:10px 12px;">
              <div style="display:flex; justify-content:space-between; margin-bottom:4px; font-size:12px;">
                <span class="badge badge-amber font-mono">{{ ev.date }} {{ ev.time or '全天' }}</span>
                <span class="badge">{{ ev.category_name or '事件' }}</span>
              </div>
              <div style="font-weight:700; font-size:13px; color:var(--text-main);">{{ ev.summary }}</div>
              {% if ev.description %}<div style="font-size:12px; color:var(--text-muted); margin-top:2px;">{{ ev.description }}</div>{% endif %}
            </div>
            {% endfor %}
          </div>
          {% else %}
          <div class="empty-state">近期無排定事件</div>
          {% endif %}
        </div>
      </div>
    </section>

  </main>

  <!-- BACK TO TOP BUTTON -->
  <button id="back-to-top" class="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" type="button" aria-label="回到頂部">▲</button>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="toast" role="alert" aria-live="polite"></div>

  <!-- KEYBOARD SHORTCUTS MODAL -->
  <div id="shortcuts-modal" class="modal-overlay" onclick="if(event.target===this)window.pm.toggleShortcutsModal()" role="dialog" aria-modal="true" aria-label="鍵盤快捷鍵清單">
    <div class="modal-card">
      <h3 class="modal-title">⌨️ 鍵盤快捷鍵</h3>
      <div class="shortcut-list">
        <div class="shortcut-item"><span class="kbd">1</span> <span>今日摘要</span></div>
        <div class="shortcut-item"><span class="kbd">2</span> <span>今日警示</span></div>
        <div class="shortcut-item"><span class="kbd">3</span> <span>今日候選股</span></div>
        <div class="shortcut-item"><span class="kbd">4</span> <span>市場背景</span></div>
        <div class="shortcut-item"><span class="kbd">5</span> <span>補充資訊</span></div>
        <div class="shortcut-item"><span class="kbd">6</span> <span>系統資訊</span></div>
        <div class="shortcut-item"><span class="kbd">/</span> <span>聚焦自選輸入</span></div>
        <div class="shortcut-item"><span class="kbd">d</span> <span>切換深/淺色</span></div>
        <div class="shortcut-item"><span class="kbd">w</span> <span>切換只看自選</span></div>
        <div class="shortcut-item"><span class="kbd">t</span> <span>回到頂部</span></div>
        <div class="shortcut-item"><span class="kbd">?</span> <span>開啟快捷鍵表</span></div>
        <div class="shortcut-item"><span class="kbd">Esc</span> <span>關閉彈窗</span></div>
      </div>
    </div>
  </div>

  <!-- 6. 系統資訊 (System Info Footer) -->
  <footer id="system-info" class="page-footer">
    <div class="footer-inner">
      <div class="footer-title">系統與資料說明</div>
      <ul class="footer-notes">
        <li><strong>資料來源：</strong>處置股與財務公告來自 chengwaye.com；籌碼股來自 PressPlay 每日盤前專欄；指數報價來自 Yahoo Finance；新聞聚合來自 Google News；財經行事曆來自 MacroMicro。</li>
        <li><strong>排程機制：</strong>每日 07:35（台北）自動重建；盤前可在 GitHub Actions → Build premarket page → Run workflow 手動觸發，2 分鐘內完成</li>
        <li><strong>欄位說明：</strong>個股當沖明細原「總損益」欄位因公開資料無法可靠推算，為確保數據精準故不予顯示。</li>
        <li><strong>資料範圍：</strong>法人買賣與當沖明細僅涵蓋當日重點清單；未在清單內之標的自動略過。</li>
      </ul>
      <div class="footer-note" style="font-size:11px; color:var(--text-muted); margin-top:6px; text-align:center;">摘要來源：PressPlay 文章（僅供自用，未對外發布） · GitHub Actions 上次執行成功時間：<span class="font-mono">{{ build_time or '08:00' }}</span></div>
      <div class="footer-copy" style="margin-top:4px; text-align:center;">盤前情報準備台 · 自用盤前決策工作台</div>
    </div>
  </footer>

<script>
  window.pm = window.pm || {};
  window.WATCH_KEY = 'premarket.watchlist';

  // 2026 Taiwan Holiday List
  const TW_HOLIDAYS_2026 = [
    '2026-01-01', '2026-02-16', '2026-02-17', '2026-02-18', '2026-02-19', '2026-02-20',
    '2026-02-27', '2026-04-03', '2026-04-06', '2026-05-01', '2026-06-19', '2026-09-25',
    '2026-10-09', '2026-10-10'
  ];

  // Toast Notification Helper
  window.pm.showToast = function(msg) {
    var toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(function() { toast.classList.remove('show'); }, 1500);
  };

  // Iframe Auto-Height Receiver
  window.addEventListener('message', function(e) {
    if (!e.data || e.data.type !== 'embed-height') return;
    var f = document.getElementById('embed-' + e.data.id);
    if (f) f.style.height = Math.max(480, e.data.height) + 'px';
  });

  // Theme Toggle
  window.toggleTheme = function() {
    var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? '' : 'dark';
    document.documentElement.setAttribute('data-theme', cur);
    localStorage.setItem('premarket.theme', cur);
    var metaTheme = document.querySelector('meta[name="theme-color"]');
    if (metaTheme) metaTheme.content = cur === 'dark' ? '#0B1220' : '#F8FAFC';
    var b = document.getElementById('theme-toggle');
    if (b) b.textContent = cur === 'dark' ? '☀️ 淺色' : '🌙 深色';
    if (window.pm.syncHash) window.pm.syncHash();
  };

  // Watchlist Save & Render
  window.saveWatch = function() {
    var input = document.getElementById('watch-input');
    var raw = (input.value || '').replace(/[^\d,]/g, '');
    var codes = [];
    raw.split(',').forEach(function(c) {
      c = c.trim();
      if (c && codes.indexOf(c) < 0) codes.push(c);
    });
    localStorage.setItem(window.WATCH_KEY, JSON.stringify(codes));
    renderWatch();
    if (window.pm.applyWatchOnly) window.pm.applyWatchOnly();
    window.pm.showToast('已儲存自選股清單 (' + codes.length + ' 檔)');
  };

  window.clearWatch = function() {
    localStorage.removeItem(window.WATCH_KEY);
    document.getElementById('watch-input').value = '';
    renderWatch();
    if (window.pm.applyWatchOnly) window.pm.applyWatchOnly();
    window.pm.showToast('已清空自選股');
  };

  window.delWatch = function(c) {
    var raw = localStorage.getItem(window.WATCH_KEY);
    var codes = raw ? JSON.parse(raw) : [];
    codes = codes.filter(function(x) { return x !== c; });
    localStorage.setItem(window.WATCH_KEY, JSON.stringify(codes));
    document.getElementById('watch-input').value = codes.join(', ');
    renderWatch();
    if (window.pm.applyWatchOnly) window.pm.applyWatchOnly();
  };

  function renderWatch() {
    var box = document.getElementById('watch-chips');
    var hint = document.getElementById('watch-hint');
    if (!box || !hint) return;
    box.innerHTML = '';
    var raw = localStorage.getItem(window.WATCH_KEY);
    var codes = raw ? JSON.parse(raw) : [];
    if (!codes.length) {
      hint.textContent = '目前無自選股。';
      return;
    }
    hint.textContent = codes.length + ' 檔自選標的（點擊可定位至表格）';
    
    var stockMap = {};
    document.querySelectorAll('[data-code]').forEach(function(n) {
      var code = n.getAttribute('data-code');
      if (code && !stockMap[code]) {
        stockMap[code] = {
          type: n.getAttribute('data-cat') || 'normal',
          label: n.getAttribute('data-label') || ''
        };
      }
    });

    codes.forEach(function(c) {
      var chip = document.createElement('span');
      chip.className = 'watch-chip';
      var hit = stockMap[c];
      var icon = '⚪';
      if (hit && hit.type === 'alert') { chip.classList.add('alert'); icon = '🚨'; }
      else if (hit && hit.type === 'amber') { chip.classList.add('amber'); icon = '🟡'; }
      else if (hit && hit.type === 'blue') { chip.classList.add('blue'); icon = '🔵'; }

      chip.innerHTML = '<span class="wc-icon">' + icon + '</span>'
        + '<span class="wc-code">' + c + '</span>'
        + (hit && hit.label ? '<span class="wc-name">' + hit.label + '</span>' : '')
        + '<span class="wc-del" onclick="event.stopPropagation(); window.delWatch(\'' + c + '\')" title="刪除">✕</span>';
      
      chip.onclick = function() {
        var targetRow = document.querySelector('tr[data-code="' + c + '"]');
        if (targetRow) {
          targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetRow.classList.remove('highlight-flash');
          void targetRow.offsetWidth;
          targetRow.classList.add('highlight-flash');
        } else {
          window.pm.showToast(c + ' 未出現在今日警示或候選清單中');
        }
      };
      box.appendChild(chip);
    });
  }

  // Global Watch-Only Filter
  window.pm.watchOnly = localStorage.getItem('premarket.filterWatchOnly') === '1';
  window.pm.toggleWatchOnly = function() {
    window.pm.watchOnly = !window.pm.watchOnly;
    localStorage.setItem('premarket.filterWatchOnly', window.pm.watchOnly ? '1' : '0');
    window.pm.applyWatchOnly();
    if (window.pm.syncHash) window.pm.syncHash();
  };

  window.pm.applyWatchOnly = function() {
    var btn = document.getElementById('filter-watch-toggle');
    if (btn) btn.classList.toggle('is-active', window.pm.watchOnly);
    
    var raw = localStorage.getItem(window.WATCH_KEY);
    var codes = raw ? JSON.parse(raw) : [];

    document.querySelectorAll('tr[data-code]').forEach(function(row) {
      var code = row.getAttribute('data-code');
      if (!window.pm.watchOnly) {
        row.style.display = '';
      } else {
        row.style.display = (codes.indexOf(code) >= 0) ? '' : 'none';
      }
    });

    // Update alert count badge dynamically
    var alertBadge = document.getElementById('nav-alert-badge');
    if (alertBadge) {
      var visibleAlerts = document.querySelectorAll('#alerts tr[data-code]:not([style*="display: none"])').length;
      alertBadge.textContent = visibleAlerts;
    }
  };

  // Snapshot Mode Toggle
  window.pm.toggleSnapshot = function() {
    document.body.classList.toggle('snapshot-mode');
    var isSnap = document.body.classList.contains('snapshot-mode');
    window.pm.showToast(isSnap ? '已開啟截圖模式（按 Esc 或點擊退出）' : '已關閉截圖模式');
  };

  // Shortcuts Modal Toggle
  window.pm.toggleShortcutsModal = function() {
    var m = document.getElementById('shortcuts-modal');
    if (m) m.classList.toggle('open');
  };

  // Table Column Click Sorter
  window.pm.sortTable = function(th, colIdx) {
    var table = th.closest('table');
    var tbody = table.querySelector('tbody');
    var rows = Array.from(tbody.querySelectorAll('tr'));
    var isAsc = !th.classList.contains('asc');
    
    table.querySelectorAll('th').forEach(function(h) {
      h.classList.remove('sorted', 'asc', 'desc');
    });
    th.classList.add('sorted', isAsc ? 'asc' : 'desc');

    rows.sort(function(a, b) {
      var aCell = a.children[colIdx] ? a.children[colIdx].textContent.trim() : '';
      var bCell = b.children[colIdx] ? b.children[colIdx].textContent.trim() : '';
      var aNum = parseFloat(aCell.replace(/[^0-9.-]/g, ''));
      var bNum = parseFloat(bCell.replace(/[^0-9.-]/g, ''));

      if (!isNaN(aNum) && !isNaN(bNum)) {
        return isAsc ? aNum - bNum : bNum - aNum;
      }
      return isAsc ? aCell.localeCompare(bCell, 'zh-Hant') : bCell.localeCompare(aCell, 'zh-Hant');
    });

    rows.forEach(function(r) { tbody.appendChild(r); });
  };

  // URL Hash Sync
  window.pm.syncHash = function() {
    var curTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    var watch = window.pm.watchOnly ? '1' : '0';
    var hash = window.location.hash.split('?')[0] || '#summary';
    history.replaceState(null, '', hash + '?theme=' + curTheme + '&watch=' + watch);
  };

  // Keyboard Shortcuts
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
      if (e.key === 'Enter' && e.target.id === 'watch-input') {
        window.saveWatch();
      }
      if (e.key === 'Escape') {
        e.target.blur();
      }
      return;
    }

    if (e.key === 'Escape') {
      if (document.body.classList.contains('snapshot-mode')) {
        document.body.classList.remove('snapshot-mode');
      }
      var m = document.getElementById('shortcuts-modal');
      if (m && m.classList.contains('open')) m.classList.remove('open');
    } else if (e.key === '1') {
      document.getElementById('summary')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '2') {
      document.getElementById('alerts')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '3') {
      document.getElementById('watchlist')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '4') {
      document.getElementById('market-context')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '5') {
      document.getElementById('news-calendar')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '6') {
      document.getElementById('system-info')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '/') {
      e.preventDefault();
      var inp = document.getElementById('watch-input');
      if (inp) { inp.focus(); inp.select(); }
    } else if (e.key === 'd' || e.key === 'D') {
      window.toggleTheme();
    } else if (e.key === 'w' || e.key === 'W') {
      window.pm.toggleWatchOnly();
    } else if (e.key === 't' || e.key === 'T') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (e.key === '?' || (e.shiftKey && e.key === '/')) {
      window.pm.toggleShortcutsModal();
    }
  });

  // Scroll Spy & Back to Top
  var btt = document.getElementById('back-to-top');
  window.addEventListener('scroll', function() {
    if (btt) btt.style.display = window.scrollY > 600 ? 'flex' : 'none';
  }, { passive: true });

  var sections = document.querySelectorAll('.content-section, #system-info');
  var navLinks = document.querySelectorAll('.nav-link');
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var id = entry.target.getAttribute('id');
          navLinks.forEach(function(link) {
            link.classList.toggle('is-active', link.getAttribute('href') === '#' + id);
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(function(sec) { observer.observe(sec); });
  }

  // Live Timer Throttled by Visibility
  var liveTimer = null;
  var countdownTimer = null;

  function updateLiveTimers() {
    var el = document.querySelector('.last-build');
    if (el) {
      var m = (el.textContent || '').match(/(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2})/);
      if (m) {
        var bt = new Date(m[1].replace(' ', 'T') + '+08:00').getTime();
        var hrs = (Date.now() - bt) / 36e5;
        var cls = hrs < 6 ? 'fresh' : (hrs < 12 ? 'aging' : 'stale');
        el.classList.remove('fresh', 'aging', 'stale');
        el.classList.add(cls);
        var banner = document.querySelector('.stale-banner');
        if (banner) {
          banner.textContent = '資料時間 ' + m[1] + '，距今 ' + hrs.toFixed(1) + ' 小時';
          banner.dataset.hours = String(Math.min(48, Math.floor(hrs)));
          banner.classList.toggle('is-warning', hrs >= 6 && hrs < 12);
          banner.classList.toggle('is-danger', hrs >= 12);
        }
      }
    }

    var cel = document.getElementById('open-countdown');
    if (cel) {
      var now = new Date();
      var open = new Date(now);
      open.setHours(9, 0, 0, 0);
      var dow = now.getDay();
      var weekend = (dow === 0) || (dow === 6);
      var close = new Date(now);
      close.setHours(13, 30, 0, 0);

      if (weekend || (now >= close && now.getHours() >= 13)) {
        while (open <= now) open.setDate(open.getDate() + 1);
        if (weekend) {
          do { open.setDate(open.getDate() + 1); } while (open.getDay() === 0 || open.getDay() === 6);
        }
        cel.textContent = '今日已收盤｜下次 09:00 開盤倒數 ' + fmtCountdown(open);
        cel.classList.add('closed');
      } else {
        var diff = open - now;
        if (diff > 0) {
          cel.textContent = '離 09:00 開盤還有 ' + fmtCountdown(open);
          cel.classList.remove('closed');
        } else {
          cel.textContent = '盤中｜收盤倒數 ' + fmtCountdown(close);
        }
      }
    }
  }

  function fmtCountdown(d) {
    var ms = d - new Date();
    if (ms <= 0) return '00:00:00';
    var h = String(Math.floor(ms / 36e5)).padStart(2, '0');
    var m = String(Math.floor(ms / 6e4) % 60).padStart(2, '0');
    var s = String(Math.floor(ms / 1e3) % 60).padStart(2, '0');
    return h + ':' + m + ':' + s;
  }

  function startTimers() {
    updateLiveTimers();
    if (!liveTimer) liveTimer = setInterval(updateLiveTimers, 60000);
    if (!countdownTimer) countdownTimer = setInterval(updateLiveTimers, 1000);
  }

  function stopTimers() {
    if (liveTimer) { clearInterval(liveTimer); liveTimer = null; }
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
  }

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) stopTimers();
    else startTimers();
  });

  // Initialization
  document.addEventListener('DOMContentLoaded', function() {
    // Restore Theme
    var savedTheme = localStorage.getItem('premarket.theme');
    var urlParams = new URLSearchParams(window.location.hash.split('?')[1] || '');
    if (urlParams.get('theme')) savedTheme = urlParams.get('theme');
    if (savedTheme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      var b = document.getElementById('theme-toggle');
      if (b) b.textContent = '☀️ 淺色';
      var metaTheme = document.querySelector('meta[name="theme-color"]');
      if (metaTheme) metaTheme.content = '#0B1220';
    }

    // Restore Watchlist Input & Render
    var rawWatch = localStorage.getItem(window.WATCH_KEY);
    var codes = rawWatch ? JSON.parse(rawWatch) : [];
    var inp = document.getElementById('watch-input');
    if (inp && codes.length) inp.value = codes.join(', ');
    renderWatch();

    // Restore Watch-Only
    if (urlParams.get('watch') === '1') window.pm.watchOnly = true;
    if (window.pm.watchOnly) window.pm.applyWatchOnly();

    startTimers();
  });
</script>

</body>
</html>
