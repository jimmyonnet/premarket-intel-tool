    var title = encodeURIComponent(card.getAttribute('data-title') || '財經事件');
    var utc = card.getAttribute('data-datetime-utc');
    var dtStr = '';
    if (utc && utc.length >= 16) {
      var cleanUtc = utc.replace(/[-:]/g, '').split('.')[0];
      if (!cleanUtc.endsWith('Z')) cleanUtc += 'Z';
      dtStr = cleanUtc + '/' + cleanUtc;
    }
    var url = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + title + (dtStr ? '&dates=' + dtStr : '');
    window.open(url, '_blank');
  };

  function updateEventCountdowns() {
    var nowMs = Date.now();
    document.querySelectorAll('.cal-event-card').forEach(function(card) {
      var utcStr = card.getAttribute('data-datetime-utc');
      if (!utcStr) return;
      var evTime = new Date(utcStr).getTime();
      if (isNaN(evTime)) return;
      
      var diffMs = evTime - nowMs;
      var cdBadge = card.querySelector('.cal-countdown-badge');
      
      if (diffMs > 0 && diffMs <= 2 * 3600 * 1000) {
        var mins = Math.floor(diffMs / 60000);
        var secs = Math.floor((diffMs % 60000) / 1000);
        if (cdBadge) {
          cdBadge.textContent = '倒數 ' + String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
          cdBadge.classList.add('show');
        }
      } else {
        if (cdBadge) cdBadge.classList.remove('show');
      }

      var isLive = Math.abs(diffMs) <= 15 * 60 * 1000;
      card.classList.toggle('is-live', isLive);

      var isPast = diffMs < -30 * 60 * 1000;
      card.classList.toggle('is-past', isPast);
    });
  }

