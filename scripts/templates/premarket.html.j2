<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>盤前情報準備台</title>

<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#F8FAFC">
<link rel="apple-touch-icon" href="https://www.twse.com.tw/favicon.ico">
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js').then(function(registration) {
      console.log('ServiceWorker registration successful with scope: ', registration.scope);
    }, function(err) {
      console.log('ServiceWorker registration failed: ', err);
    });
  }
</script>

<style>
  :root{
    --ink: #F8FAFC;
    --panel: #FFFFFF;
    --panel-2: #F1F5F9;
    --panel-3: #E2E8F0;
    --line: #E2E8F0;
    --text: #0F172A;
    --muted: #64748B;
    --rise: #E11D48;
    --fall: #16A34A;
    --amber: #D97706;
    --blue: #2563EB;
    --cat-fed: #E11D48;
    --cat-econ: #D97706;
    --cat-stock: #0284C7;
    --cat-futures: #D97706;
    --cat-gen: #64748B;
    --font-ui: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, "PingFang TC", "Microsoft JhengHei", sans-serif;
    --font-mono: "SF Mono", "Consolas", Menlo, monospace;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.06), 0 1px 2px -1px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.07);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--ink); color:var(--text);
    font-family:var(--font-ui); line-height:1.5; padding:32px 16px 80px;
    -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
  }
  .wrap{max-width:940px; margin:0 auto;}
  header{display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px; margin-bottom:24px; padding-bottom:16px; border-bottom:1px solid var(--line);}
  h1{font-size:24px; font-weight:800; margin:0; letter-spacing:-0.02em; color:var(--text);}
  .generated{color:var(--muted); font-size:12px; font-family:var(--font-mono); font-weight:500;}
  .part-title{font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; font-weight:700; margin:36px 0 14px; scroll-margin-top:16px;}
  .part-title:first-of-type{margin-top:0;}
  section.part{margin-bottom:12px;}

  .page-nav{display:flex; gap:8px; overflow-x:auto; -webkit-overflow-scrolling:touch; margin-bottom:20px; padding-bottom:2px;}
  .page-nav a{flex:0 0 auto; font-size:12px; font-weight:600; color:var(--muted); text-decoration:none; background:var(--panel-2); border:1px solid var(--line); padding:6px 14px; border-radius:20px; white-space:nowrap; transition:all 0.15s ease;}
  .page-nav a:hover{background:var(--panel-3); color:var(--text); border-color:#CBD5E1; text-decoration:none;}

  .warning-banner{background:#FFF1F2; border:1px solid #FECDD3; color:#BE123C; padding:12px 16px; border-radius:10px; font-size:13px; margin-bottom:16px; font-weight:500;}
  .ok-banner{background:#F0FDF4; border:1px solid #BBF7D0; color:#15803D; padding:10px 16px; border-radius:10px; font-size:12px; margin-bottom:16px; font-family:var(--font-mono); font-weight:500;}

  .card{background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:22px; margin-bottom:20px; box-shadow:var(--shadow);}
  .card h2{font-size:16px; margin:0 0 16px; color:var(--text); font-weight:700; display:flex; align-items:center;}
  .card h2 .sub{color:var(--muted); font-weight:400; font-size:12px; margin-left:8px;}

  /* stat tiles */
  .tiles{display:grid; grid-template-columns:repeat(auto-fit, minmax(140px,1fr)); gap:12px;}
  .tile{background:var(--panel-2); border:1px solid var(--line); border-radius:10px; padding:14px 16px; transition:transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;}
  .tile:hover{background:#FFFFFF; box-shadow:var(--shadow-md); transform:translateY(-1px);}
  .tile .name{font-size:12px; color:var(--muted); margin-bottom:6px; font-weight:600;}
  .tile .value{font-family:var(--font-mono); font-size:20px; font-weight:700; color:var(--text);}
  .tile .delta{font-family:var(--font-mono); font-size:12px; margin-top:4px; font-weight:600;}
  .tile .updated{font-size:10px; color:var(--muted); margin-top:6px; font-family:var(--font-mono);}
  .rise{color:var(--rise) !important;}
  .fall{color:var(--fall) !important;}
  .flat{color:var(--muted) !important;}
  .missing{color:var(--muted); font-style:italic; font-size:12px;}

  /* tables */
  table{width:100%; border-collapse:collapse; font-size:13px;}
  th{text-align:left; color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.04em; padding:10px 10px; border-bottom:1px solid var(--line); background:#FAFBFD;}
  th.num{text-align:right;}
  td{padding:10px 10px; border-bottom:1px solid #F1F5F9; vertical-align:middle; color:var(--text);}
  tr:last-child td{border-bottom:none;}
  td.code{font-family:var(--font-mono); color:var(--blue); font-weight:600;}
  td.name{font-weight:600; white-space:nowrap; color:var(--text);}
  td.num{font-family:var(--font-mono); text-align:right; font-weight:500;}
  td.exit-today{color:var(--amber); font-weight:700; font-family:var(--font-mono);}
  td.condition{color:var(--muted); font-size:12px; max-width:340px;}
  .empty-row td{color:var(--muted); font-style:italic; text-align:center; padding:20px;}
  .badge{display:inline-block; font-size:11px; padding:2px 8px; border-radius:6px; border:1px solid var(--line); color:var(--muted); font-family:var(--font-mono); font-weight:600; background:var(--panel-2);}
  .badge.exit-today-badge{border-color:#FCD34D; color:#B45309; background:#FEF3C7;}
  .source-note{color:var(--muted); font-size:12px; margin:8px 0 0;}

  .badge-col{text-align:center; white-space:nowrap;}
  .badge-dots{display:flex; gap:2px; align-items:center; justify-content:center;}
  .badge-dots .dot{width:5px; height:11px; background:#E2E8F0; border:1px solid #CBD5E1; border-radius:1px; flex-shrink:0;}
  .badge-dots .dot.filled{background:var(--amber); border-color:var(--amber);}
  .badge-frac{display:block; font-family:var(--font-mono); font-size:10px; color:var(--muted); margin-top:3px;}

  .table-scroll{overflow-x:auto; -webkit-overflow-scrolling:touch;}
  .table-scroll table{min-width:600px;}
  .table-scroll.compact table{min-width:380px;}

  .embed-scroll{overflow-x:auto; -webkit-overflow-scrolling:touch;}
  .embed-scroll iframe{min-width:860px;}

  .inst-detail{border-top:1px solid var(--line); padding:12px 0 4px;}
  .inst-detail:first-of-type{border-top:none; padding-top:0;}
  .inst-detail summary{cursor:pointer; font-size:13px; font-weight:600; padding:6px 0; color:var(--text); transition:color 0.15s;}
  .inst-detail summary:hover{color:var(--blue);}
  .inst-body{margin-top:12px;}
  .inst-body > *{margin-bottom:16px;}
  .inst-body > *:last-child{margin-bottom:0;}
  .sub-label{font-size:12px; color:var(--muted); margin-bottom:8px; font-weight:600; text-transform:uppercase; letter-spacing:0.04em;}

  .dual-panel{display:flex; gap:16px; align-items:flex-start;}
  .dual-panel-col{flex:1; min-width:0;}

  /* Part 4: financial calendar beautification */
  .cal-grid{margin-bottom:20px;}
  .cal-grid-head, .cal-grid-row{display:grid; grid-template-columns:repeat(7, 1fr); gap:6px;}
  .cal-grid-head{margin-bottom:6px;}
  .cal-grid-h{text-align:center; font-size:11px; color:var(--muted); font-weight:600; padding:4px 0;}
  .cal-grid-row{margin-bottom:6px;}
  .cal-cell{display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; aspect-ratio:1; padding:6px 2px; border-radius:8px; background:var(--panel-2); border:1px solid var(--line); text-decoration:none; transition:all 0.15s ease;}
  .cal-cell.out{opacity:.35;}
  .cal-cell.today{border-color:var(--amber); box-shadow:0 0 0 2px rgba(217,119,6,0.2); background:#FFFBEB;}
  .cal-cell.has-events{cursor:pointer;}
  .cal-cell.has-events:hover{border-color:var(--blue); background:#FFFFFF; transform:translateY(-2px); box-shadow:var(--shadow-md);}
  .cal-cell-num{font-family:var(--font-mono); font-size:12px; color:var(--text); font-weight:500;}
  .cal-cell.today .cal-cell-num{color:var(--amber); font-weight:700;}
  .cal-cell-dots{display:flex; gap:2px; align-items:center; height:5px;}
  .cal-cell-dots .dot{width:5px; height:5px; border-radius:50%; background:var(--amber);}
  .cal-cell-more{font-size:9px; color:var(--muted); font-family:var(--font-mono); margin-left:1px;}

  .cal-day{display:flex; gap:16px; padding:14px 0; border-bottom:1px solid var(--line); scroll-margin-top:12px;}
  .cal-day:last-child{border-bottom:none;}
  .cal-date{flex:0 0 80px; font-family:var(--font-mono); font-size:13px; color:var(--muted); padding-top:4px;}
  .cal-date.today{color:var(--amber); font-weight:700;}
  .cal-day-events{flex:1; min-width:0; display:flex; flex-direction:column; gap:10px;}

  .cal-event-card{background:var(--panel-2); border:1px solid var(--line); border-left:4px solid var(--cat-gen); border-radius:8px; padding:10px 14px; transition:border-color 0.2s;}
  .cal-event-card.cat-fed{border-left-color:var(--cat-fed); background:#FFF1F2;}
  .cal-event-card.cat-econ{border-left-color:var(--cat-econ); background:#FFFBEB;}
  .cal-event-card.cat-stock{border-left-color:var(--cat-stock); background:#F0F9FF;}
  .cal-event-card.cat-futures{border-left-color:var(--cat-futures); background:#FFFBEB;}

  .cal-header-row{display:flex; align-items:center; gap:8px; margin-bottom:4px; flex-wrap:wrap;}
  .cal-time-pill{display:inline-block; font-family:var(--font-mono); font-size:11px; padding:2px 8px; border-radius:12px; background:#E2E8F0; color:#334155; font-weight:600;}
  .cal-time-pill.all-day{background:#E2E8F0; color:#64748B;}
  .cal-cat-badge{font-size:10px; padding:2px 6px; border-radius:4px; font-weight:600; text-transform:uppercase; letter-spacing:0.02em;}
  .cat-fed .cal-cat-badge{background:#FFE4E6; color:#BE123C;}
  .cat-econ .cal-cat-badge{background:#FEF3C7; color:#B45309;}
  .cat-stock .cal-cat-badge{background:#E0F2FE; color:#0369A1;}
  .cat-futures .cal-cat-badge{background:#FEF3C7; color:#B45309;}
  .cat-general .cal-cat-badge{background:#F1F5F9; color:#475569;}

  .cal-summary{font-size:14px; font-weight:600; color:var(--text);}
  .cal-desc{font-size:12px; color:var(--muted); margin-top:4px; white-space:pre-line; line-height:1.4;}
  .cal-link{display:inline-flex; align-items:center; gap:4px; font-size:12px; color:var(--amber); text-decoration:none; background:#FEF3C7; border:1px solid #FDE68A; padding:4px 10px; border-radius:8px; font-weight:600; transition:all 0.15s ease;}
  .cal-link:hover{background:#FDE68A; text-decoration:none;}

  .header-btn { display:inline-flex; align-items:center; gap:4px; font-size:12px; color:var(--muted); text-decoration:none; background:var(--panel-2); border:1px solid var(--line); padding:5px 12px; border-radius:8px; font-weight:600; transition:all 0.15s ease; margin-left: auto; }
  .header-btn:hover { background:var(--panel-3); color:var(--text); text-decoration:none; border-color:#CBD5E1; }
  .card-header-flex { display: flex; align-items: center; margin-bottom: 16px; }
  .card-header-flex h2 { margin-bottom: 0; }

  @media (max-width: 480px){
    body{padding:20px 12px 56px;}
    h1{font-size:20px;}
    .card{padding:16px;}
    .tiles{grid-template-columns:repeat(auto-fit, minmax(110px,1fr));}
    table{font-size:12px;}
    th{padding:8px 8px;}
    td{padding:8px 8px;}
    td.condition{max-width:160px;}
    .dual-panel{flex-direction:column;}
    .cal-day{flex-direction:column; gap:6px;}
    .cal-grid-head, .cal-grid-row{gap:3px;}
    .cal-cell{padding:4px 1px;}
    .cal-cell-num{font-size:11px;}
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>盤前情報準備台</h1>
    <div class="generated">產生時間 {{ generated_at }}</div>
  </header>

  <nav class="page-nav">
    <a href="#sec-indices">美股四大指數</a>
    <a href="#sec-disposal">處置股</a>
    <a href="#sec-pressplay">籌碼股</a>
    <a href="#sec-financials">自結、季報、營收</a>
    <a href="#sec-calendar">財經行事曆</a>
  </nav>

  {% if date_check and date_check.applies_to_matches_today is sameas false %}
  <div class="warning-banner">
    ⚠ 處置股資料日期核對失敗 — 頁面顯示適用 {{ date_check.page_says_applies_to }}，但今天是 {{ date_check.today }}。第二部分資料可能不是最新的，請自行到 chengwaye.com 確認。
  </div>
  {% elif date_check %}
  <div class="ok-banner">✓ 處置股資料日期核對通過（下拉選單：{{ date_check.page_dropdown_selected }} → 適用 {{ date_check.page_says_applies_to }}）</div>
  {% endif %}


  {% if twse and twse.twii %}
  <div style="background:var(--panel); padding:14px 18px; border-radius:12px; border:1px solid var(--line); margin-bottom:20px; display:flex; flex-wrap:wrap; gap:16px; align-items:center; justify-content:space-between; box-shadow:var(--shadow);">
    <div style="display:flex; align-items:center; gap:12px;">
      <span style="font-size:14px; color:var(--muted); font-weight:600;">昨收大盤</span>
      <span style="font-size:16px; font-weight:700; color:{% if twse.twii.change > 0 %}var(--red){% elif twse.twii.change < 0 %}var(--green){% else %}var(--text){% endif %};">
        {{ twse.twii.price }} ({% if twse.twii.change > 0 %}+{% endif %}{{ twse.twii.change }})
      </span>
    </div>
    <div style="display:flex; gap:16px; font-size:13px; font-weight:600;">
      {% if twse.inst.foreign %}
      <div style="display:flex; gap:6px;">
        <span style="color:var(--muted);">外資</span>
        <span style="color:{% if twse.inst.foreign > 0 %}var(--red){% else %}var(--green){% endif %};">{% if twse.inst.foreign > 0 %}+{% endif %}{{ twse.inst.foreign }}億</span>
      </div>
      <div style="display:flex; gap:6px;">
        <span style="color:var(--muted);">投信</span>
        <span style="color:{% if twse.inst.trust > 0 %}var(--red){% else %}var(--green){% endif %};">{% if twse.inst.trust > 0 %}+{% endif %}{{ twse.inst.trust }}億</span>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}
  <div class="part-title" id="sec-indices">美股四大指數</div>
  <section class="part">

    <!-- Removed Broken TradingView Widget -->

    <div class="card">
      <div class="card-header-flex">
        <h2>美股四大指數 <span class="sub">前一夜收盤</span></h2>
        <a href="https://tw.stock.yahoo.com/markets/" target="_blank" rel="noopener" class="header-btn">查看 Yahoo 即時報價 ↗</a>
      </div>
      <div class="tiles">
        {% for key, tile in us_indices.items() %}
        {% if tile %}
        <div class="tile">
          <div class="name">{{ tile.name }}</div>
          <div class="value">{{ '{:,.2f}'.format(tile.value) }}</div>
          <div class="delta {{ 'rise' if tile.change_pct >= 0 else 'fall' }}">{{ '%+.2f'|format(tile.change) }} ({{ '%+.2f'|format(tile.change_pct) }}%)</div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
      <div class="tiles" style="margin-top: 12px;">
        {% if night and night.latest %}
        <div class="tile">
          <div class="name">台指期夜盤 <span style="font-size:10px; font-weight:normal; color:var(--muted);">(05:00)</span></div>
          <div class="value">{{ "{:,.0f}".format(night.latest.price) }}</div>
          <div class="delta {{ 'rise' if night.latest.change >= 0 else 'fall' }}">{{ '%+.0f'|format(night.latest.change) }} ({{ '%+.2f'|format(night.latest.change_pct) }}%)</div>
        </div>
        {% endif %}
        {% if indices and indices.adrs and indices.adrs.tsmc %}
        <div class="tile">
          <div class="name">{{ indices.adrs.tsmc.name }}</div>
          <div class="value">{{ '{:,.2f}'.format(indices.adrs.tsmc.value) }}</div>
          <div class="delta {{ 'rise' if indices.adrs.tsmc.change_pct >= 0 else 'fall' }}">{{ '%+.2f'|format(indices.adrs.tsmc.change) }} ({{ '%+.2f'|format(indices.adrs.tsmc.change_pct) }}%)</div>
        </div>
        {% endif %}
        {% if indices and indices.adrs and indices.adrs.umc %}
        <div class="tile">
          <div class="name">{{ indices.adrs.umc.name }}</div>
          <div class="value">{{ '{:,.2f}'.format(indices.adrs.umc.value) }}</div>
          <div class="delta {{ 'rise' if indices.adrs.umc.change_pct >= 0 else 'fall' }}">{{ '%+.2f'|format(indices.adrs.umc.change) }} ({{ '%+.2f'|format(indices.adrs.umc.change_pct) }}%)</div>
        </div>
        {% endif %}
        {% if indices and indices.adrs and indices.adrs.ase %}
        <div class="tile">
          <div class="name">{{ indices.adrs.ase.name }}</div>
          <div class="value">{{ '{:,.2f}'.format(indices.adrs.ase.value) }}</div>
          <div class="delta {{ 'rise' if indices.adrs.ase.change_pct >= 0 else 'fall' }}">{{ '%+.2f'|format(indices.adrs.ase.change) }} ({{ '%+.2f'|format(indices.adrs.ase.change_pct) }}%)</div>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="card">
      <h2>日股／韓股 08:00 開盤走勢</h2>
      <div class="tiles">
        {% for key, tile in asia_open.items() %}
        {% if tile %}
        <div class="tile">
          <div class="name">{{ tile.name }}</div>
          <div class="value">{{ '{:,.2f}'.format(tile.value) }}</div>
          <div class="delta {{ 'rise' if tile.change_pct >= 0 else 'fall' }}">{{ '%+.2f'|format(tile.change) }} ({{ '%+.2f'|format(tile.change_pct) }}%)</div>
          {% if tile.updated_cst %}<div class="updated">{{ tile.updated_cst }}</div>{% endif %}
        </div>
        {% endif %}
        {% endfor %}
      </div>
      {% if indices_missing %}
      <p class="missing">缺少欄位：{{ indices_missing|join('、') }}（來源頁面格式可能變了，需要人工檢查）</p>
      {% endif %}
    </div>


    {% if news %}
    <div class="card">
      <h2>📰 隔夜重大新聞 <span class="sub">昨日收盤迄今 Top 5</span></h2>
      <div style="display:flex; flex-direction:column; gap:12px;">
        {% for a in news %}
        <a href="{{ a.link }}" target="_blank" rel="noopener" style="display:flex; flex-direction:column; gap:6px; padding:12px 16px; background:var(--panel-2); border:1px solid var(--line); border-radius:10px; text-decoration:none; transition:all 0.15s ease;" onmouseover="this.style.background='#FFFFFF'; this.style.boxShadow='var(--shadow-md)'; this.style.borderColor='#CBD5E1';" onmouseout="this.style.background='var(--panel-2)'; this.style.boxShadow='none'; this.style.borderColor='var(--line)';">
          <div style="font-size:14px; font-weight:600; color:var(--text); line-height:1.5;">{{ a.title }}</div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:12px; color:var(--muted); font-family:var(--font-mono);">
            <span style="font-weight:600; color:var(--blue);">{{ a.source }}</span>
            <span>{{ a.time }}</span>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
</section>

  <div class="part-title" id="sec-disposal">處置股</div>
  <section class="part">

    <div class="card">
      <h2>🔴 差1次就處置 <span class="sub">{{ disposal.one_flag_from_disposal|length }} 檔</span></h2>
      <div class="table-scroll">
      <table>
        <thead><tr>
          <th style="white-space:nowrap;">所</th>
          <th style="white-space:nowrap;">代號</th>
          <th style="white-space:nowrap;">名稱</th>
          <th class="num" style="white-space:nowrap;">收盤</th>
          <th>{{ (date_check.page_says_applies_to.replace('/', '-') + ' ') if date_check.page_says_applies_to else '' }}處置標準條件（本站估算）</th>
          <th class="num" style="white-space:nowrap;">最快處置</th>
          <th class="badge-col" style="white-space:nowrap;" title="連續3日第1款">3①</th>
          <th class="badge-col" style="white-space:nowrap;" title="連續5日（第1~7款）">5</th>
          <th class="badge-col" style="white-space:nowrap;" title="10日內6次（第1~7款）">6</th>
          <th class="badge-col" style="white-space:nowrap;" title="30日內12次（第1~7款）">12</th>
        </tr></thead>
        <tbody>
          {% for row in disposal.one_flag_from_disposal %}
          <tr>
            <td style="white-space:nowrap;">{{ row.market }}</td>
            <td class="code" style="white-space:nowrap;">{{ row.code }}</td>
            <td class="name" style="white-space:nowrap;">{{ row.name }}</td>
            <td class="num" style="white-space:nowrap;">{{ row.close }}</td>
            <td class="condition">{% if row.condition_segments %}{% for seg in row.condition_segments %}<span{% if seg.color %} style="color:{{ seg.color }}{{ ';font-weight:700' if seg.bold else '' }}"{% endif %}>{{ seg.text }}</span>{% endfor %}{% else %}{{ row.condition }}{% endif %}</td>
            <td class="num" style="white-space:nowrap; text-align:right;">
              {% set ed_parts = row.earliest_disposal.split(' ', 1) %}
              {% if ed_parts|length == 2 %}
                <span style="font-family:var(--font-mono); font-weight:600; color:var(--text);">{{ ed_parts[0] }}</span>
                <span class="badge" style="border-color:rgba(255,183,3,0.4); color:var(--amber); font-weight:600; margin-left:3px; padding:2px 6px;">{{ ed_parts[1] }}</span>
              {% else %}
                <span style="font-family:var(--font-mono); font-weight:600;">{{ row.earliest_disposal }}</span>
              {% endif %}
            </td>
            {% for bd in row.badges or [{}, {}, {}, {}] %}
            <td class="badge-col"{% if bd.title %} title="{{ bd.title }}"{% endif %}>
              {% if bd.threshold %}
              <div class="badge-dots">{% for i in range(bd.threshold) %}<span class="dot{{ ' filled' if i < bd.current else '' }}"></span>{% endfor %}</div>
              <span class="badge-frac">{{ bd.current }}/{{ bd.threshold }}</span>
              {% else %}
              <span class="badge-frac">—</span>
              {% endif %}
            </td>
            {% endfor %}
          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="10">今天沒有差1次就處置的股票</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if disposal.one_flag_from_disposal %}{% endif %}
    </div>

    {% set exiting_today = disposal.currently_in_disposal | selectattr('trading_days_left', 'equalto', '出關') | list %}
    <div class="card">
      <h2>⚫ 今日出關 <span class="sub">{{ exiting_today|length }} 檔</span></h2>
      <div class="table-scroll">
      <table>
        <thead><tr><th>市場</th><th>代號</th><th>名稱</th><th>撮合</th><th class="num">開始</th><th class="num">結束</th><th class="num">出關日</th><th class="num">剩餘交易日</th><th>處置原因</th></tr></thead>
        <tbody>
          {% for row in exiting_today %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}</td>
            <td>{{ row.matching }}</td>
            <td class="num">{{ row.start_date }}</td>
            <td class="num">{{ row.end_date }}</td>
            <td class="num exit-today">{{ row.exit_date }}</td>
            <td class="num"><span class="badge exit-today-badge">出關</span></td>
            <td class="condition">{{ row.reason }}</td>
          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="9">今天沒有股票出關</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if exiting_today %}{% endif %}
    </div>

  </section>

  <div class="part-title" id="sec-pressplay">籌碼股</div>
  <section class="part">

    <div class="card">
      <h2>目前沒找到族群 <span class="sub">{{ pressplay.not_found_group.matched|length }}/{{ pressplay.not_found_group.raw_tokens|length }} 檔已比對</span></h2>
      {% if pressplay.source_article.title %}
      <div class="table-scroll">
      <table>
        <thead><tr><th>所</th><th>代號</th><th>名稱</th><th class="num">收盤</th><th class="num">量(張)</th><th class="num">外資</th><th class="num">投信</th><th class="num">自營</th></tr></thead>
        <tbody>
          {% for row in pressplay.not_found_group.matched %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">疑似打錯字</span>{% endif %}</td>
            <td class="num">{{ row.close }}</td>
            <td class="num">{{ row.volume }}</td>
            <td class="num">{{ row.foreign }}</td>
            <td class="num">{{ row.trust }}</td>
            <td class="num">{{ row.dealer }}</td>

          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="8">今天此區塊沒有標的</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if pressplay.not_found_group.matched %}{% endif %}
      {% if pressplay.not_found_group.unmatched %}
      <p class="missing">未比對到：{{ pressplay.not_found_group.unmatched|join('、') }}（原文可能打錯字或非台股代號，請自行到 chengwaye.com 確認）</p>
      {% endif %}
      {% else %}
      <p class="missing">尚無資料（PressPlay 收集流程還沒跑過，或今天沒有盤前文章）。</p>
      {% endif %}
    </div>

    <div class="card">
      <h2>目前發現有族群 <span class="sub">{{ pressplay.found_group.matched|length }}/{{ pressplay.found_group.raw_tokens|length }} 檔已比對</span></h2>
      {% if pressplay.source_article.title %}
      <div class="table-scroll">
      <table>
        <thead><tr><th>所</th><th>代號</th><th>名稱</th><th class="num">收盤</th><th class="num">量(張)</th><th class="num">外資</th><th class="num">投信</th><th class="num">自營</th></tr></thead>
        <tbody>
          {% for row in pressplay.found_group.matched %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">疑似打錯字</span>{% endif %}</td>
            <td class="num">{{ row.close }}</td>
            <td class="num">{{ row.volume }}</td>
            <td class="num">{{ row.foreign }}</td>
            <td class="num">{{ row.trust }}</td>
            <td class="num">{{ row.dealer }}</td>

          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="8">今天此區塊沒有標的</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if pressplay.found_group.matched %}{% endif %}
      {% if pressplay.found_group.unmatched %}
      <p class="missing">未比對到：{{ pressplay.found_group.unmatched|join('、') }}（原文可能打錯字或非台股代號，請自行到 chengwaye.com 確認）</p>
      {% endif %}
      {% else %}
      <p class="missing">尚無資料（PressPlay 收集流程還沒跑過，或今天沒有盤前文章）。</p>
      {% endif %}
    </div>

    {% if institutional.stocks %}
    <div class="card">
      <h2>個股法人買賣＋當沖明細 <span class="sub">{{ institutional.matched_count }}/{{ institutional.candidate_count }} 檔有資料{% if institutional.page_date %} · chengwaye.com 資料日期 {{ institutional.page_date }}{% endif %}</span></h2>
      {% for item in institutional.stocks %}
      <details class="inst-detail">
        <summary>{{ item.market }} {{ item.code }} {{ item.name }}　外資 {{ item.foreign }}／投信 {{ item.trust }}／自營 {{ item.dealer }}</summary>
        <div class="inst-body">

          <div class="dual-panel">
            <div class="dual-panel-col">
              <div class="sub-label">買超 Top15</div>
              <div class="table-scroll compact">
              <table>
                <thead><tr><th>券商</th><th class="num">買超</th><th class="num">買均</th><th class="num">買張</th><th class="num">賣張</th><th class="num">賣均</th></tr></thead>
                <tbody>
                  {% for r in item.buyers %}
                  <tr>
                    <td class="name">{{ r.name }}</td>
                    <td class="num rise">{{ r.net }}</td>
                    <td class="num">{{ r.buyP }}</td>
                    <td class="num">{{ r.buyV }}</td>
                    <td class="num">{{ r.sellV }}</td>
                    <td class="num">{{ r.sellP }}</td>
                  </tr>
                  {% else %}
                  <tr class="empty-row"><td colspan="6">無資料</td></tr>
                  {% endfor %}
                </tbody>
              </table>
              </div>
            </div>

            <div class="dual-panel-col">
              <div class="sub-label">賣超 Top15</div>
              <div class="table-scroll compact">
              <table>
                <thead><tr><th>券商</th><th class="num">賣超</th><th class="num">買均</th><th class="num">買張</th><th class="num">賣張</th><th class="num">賣均</th></tr></thead>
                <tbody>
                  {% for r in item.sellers %}
                  <tr>
                    <td class="name">{{ r.name }}</td>
                    <td class="num fall">{{ r.net }}</td>
                    <td class="num">{{ r.buyP }}</td>
                    <td class="num">{{ r.buyV }}</td>
                    <td class="num">{{ r.sellV }}</td>
                    <td class="num">{{ r.sellP }}</td>
                  </tr>
                  {% else %}
                  <tr class="empty-row"><td colspan="6">無資料</td></tr>
                  {% endfor %}
                </tbody>
              </table>
              </div>
            </div>
          </div>

          <div>
            <div class="sub-label">當沖 Top10</div>
            <div class="table-scroll">
            <table>
              <thead><tr><th>券商</th><th class="num">交易總數</th><th class="num">買張</th><th class="num">買均</th><th class="num">賣張</th><th class="num">賣均</th></tr></thead>
              <tbody>
                {% for r in item.daytraders %}
                <tr>
                  <td class="name">{{ r.name }}</td>
                  <td class="num">{{ r.total }}</td>
                  <td class="num">{{ r.buyV }}</td>
                  <td class="num">{{ r.buyP }}</td>
                  <td class="num">{{ r.sellV }}</td>
                  <td class="num">{{ r.sellP }}</td>
                </tr>
                {% else %}
                <tr class="empty-row"><td colspan="6">無資料</td></tr>
                {% endfor %}
              </tbody>
            </table>
            </div>
            <p class="source-note">原網頁另有「總損益」欄位；此欄位無法從可取得的資料可靠推算，避免顯示錯誤數字，故先省略。</p>
          </div>
        </div>
      </details>
      {% endfor %}
      <p class="source-note">資料來源：chengwaye.com/daily（僅涵蓋當日28檔清單，未在清單中的標的不會顯示此區塊）。</p>
    </div>
    {% endif %}

    {% if pressplay.source_article.title %}
    <p class="missing">資料來源：{{ pressplay.source_article.title }}{% if pressplay.chengwaye_date %} · chengwaye.com 適用 {{ pressplay.chengwaye_date }}{% endif %}</p>
    {% endif %}

  </section>

  <div class="part-title" id="sec-financials">自結、季報、營收</div>
  <section class="part">
    <div class="card">
      <h2 style="margin-bottom: 20px;">🔥 市場未反映 <span class="sub">自結、季報、營收 ({{ financials.cutoff_str }} 後公告)</span></h2>

      <div class="sub-label" style="font-size:14px; margin-top:8px; margin-bottom:8px; color:var(--text);">📊 即時自結</div>
      <div class="embed-scroll"><iframe src="embed/att.html" style="width:100%; height:320px; border:1px solid var(--line); border-radius:10px; background:#FFFFFF; box-shadow:var(--shadow-sm);"></iframe></div>

      <div class="sub-label" style="font-size:14px; margin-top:24px; margin-bottom:8px; color:var(--text);">🧾 即時季報</div>
      <div class="embed-scroll"><iframe src="embed/fin.html" style="width:100%; height:320px; border:1px solid var(--line); border-radius:10px; background:#FFFFFF; box-shadow:var(--shadow-sm);"></iframe></div>

      <div class="sub-label" style="font-size:14px; margin-top:24px; margin-bottom:8px; color:var(--text);">💰 即時營收</div>
      <div class="embed-scroll"><iframe src="embed/rev.html" style="width:100%; height:320px; border:1px solid var(--line); border-radius:10px; background:#FFFFFF; box-shadow:var(--shadow-sm);"></iframe></div>

    </div>
  </section>

<div class="part-title" id="sec-calendar">財經行事曆</div>
  <section class="part">

    <div class="card">
      <h2>財經行事曆 <span class="sub">{% if calendar.today and calendar.range_end %}{{ calendar.today[5:] }} ~ {{ calendar.range_end[5:] }}{% endif %}{% if calendar.events %} · {{ calendar.events|length }} 筆{% endif %}</span></h2>

      {% if calendar.grid %}
      <div class="cal-grid">
        <div class="cal-grid-head">
          {% for wl in calendar.grid.weekday_labels %}<div class="cal-grid-h">{{ wl }}</div>{% endfor %}
        </div>
        {% for week in calendar.grid.weeks %}
        <div class="cal-grid-row">
          {% for d in week %}
          {% if d.count %}
          <a class="cal-cell has-events{{ ' today' if d.is_today else '' }}" href="#cal-{{ d.date }}">
            <span class="cal-cell-num">{{ d.month_label or d.day }}</span>
            <span class="cal-cell-dots">{% for i in range([d.count, 3]|min) %}<span class="dot"></span>{% endfor %}{% if d.count > 3 %}<span class="cal-cell-more">+{{ d.count - 3 }}</span>{% endif %}</span>
          </a>
          {% else %}
          <div class="cal-cell{{ ' today' if d.is_today else '' }}{{ '' if d.in_range else ' out' }}">
            <span class="cal-cell-num">{{ d.month_label or d.day }}</span>
          </div>
          {% endif %}
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if calendar.events %}
      <div style="margin-top: 16px;">
      {% for date, evs in calendar.events|groupby('date') %}
      <div class="cal-day" id="cal-{{ date }}">
        <div class="cal-date{{ ' today' if date == calendar.today else '' }}">{{ date[5:].replace('-', '/') }}{% if date == calendar.today %}<br><span class="badge exit-today-badge">今天</span>{% endif %}</div>
        <div class="cal-day-events">
          {% for ev in evs %}
          <div class="cal-event-card cat-{{ ev.category or 'general' }}">
            <div class="cal-header-row">
              {% if ev.time %}
              <span class="cal-time-pill">{{ ev.time }}</span>
              {% else %}
              <span class="cal-time-pill all-day">全天</span>
              {% endif %}
              <span class="cal-cat-badge">{{ ev.category_name or '事件' }}</span>
            </div>
            <div class="cal-summary">{{ ev.summary }}</div>
            {% if ev.description %}<div class="cal-desc">{{ ev.description }}</div>{% endif %}
            {% if ev.mm_link %}
            <div>
              <a class="cal-link" href="{{ ev.mm_link }}" target="_blank" rel="noopener">📊 MM 圖表連結 ↗</a>
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      </div>
      {% else %}
      <p class="missing">尚無資料（行事曆來源還沒抓過，或近期沒有排定事件）。</p>
      {% endif %}
    </div>

  </section>



</div>
</body>
</html>