  window.pm.formatCalendarCountdown = function(diffMs) {
    var totalHours = Math.max(0, Math.floor(diffMs / 3600000));
    var days = Math.floor(totalHours / 24);
    var hours = totalHours % 24;
    if (days > 0) return '倒數 ' + days + ' 天 ' + hours + ' 小時';
    if (hours > 0) return '倒數 ' + hours + ' 小時';
    return '即將公布';
  };

  window.pm.findNextHighImpactEvent = function() {
    var nowMs = Date.now();
    var future = [];
    document.querySelectorAll('.cal-event-card[data-datetime-utc]').forEach(function(card) {
      var eventMs = new Date(card.getAttribute('data-datetime-utc')).getTime();
      var importance = parseInt(card.getAttribute('data-importance') || '1', 10);
      if (!isNaN(eventMs) && eventMs > nowMs && importance >= 2) {
        future.push({ card: card, eventMs: eventMs, importance: importance, diffMs: eventMs - nowMs });
      }
    });
    future.sort(function(a, b) { return a.eventMs - b.eventMs; });
    var preferred = future.find(function(item) {
      return item.importance === 3 && item.diffMs <= 7 * 24 * 3600 * 1000;
    });
    var fallback = future.find(function(item) { return item.importance === 2; });
    var chosen = preferred || fallback || null;
    if (!chosen) return null;

    var date = new Date(chosen.eventMs);
    chosen.title = chosen.card.getAttribute('data-title') || '';
    chosen.formattedDate = date.toLocaleDateString('zh-TW', {
      timeZone: 'Asia/Taipei', month: '2-digit', day: '2-digit', weekday: 'short'
    }) + ' ' + date.toLocaleTimeString('zh-TW', {
      timeZone: 'Asia/Taipei', hour: '2-digit', minute: '2-digit', hour12: false
    });
    chosen.countdown = window.pm.formatCalendarCountdown(chosen.diffMs);
    return chosen;
  };

