<!doctype html>
<html lang="zh-Hant" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="個人自用，勿分享">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#F8FAFC">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="PMIT 盤前">
<script>
  (function() {
    window.__PM_META__ = {{ (meta or {}) | tojson }};
    if (localStorage.getItem('pmit_debug') === '1') {
      var pmMeta = window.__PM_META__;
      if (pmMeta && Number(pmMeta.stale_hours) >= 24 && pmMeta.overall_status === 'ready') {
        console.warn('[PMIT] stale_hours >= 24 but overall_status=ready', pmMeta);
      }
    }
    var savedTheme = localStorage.getItem('pmit_theme') || localStorage.getItem('premarket.theme');
    var theme = (savedTheme === 'dark') ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
<title>盤前 · {{ date_check.page_says_applies_to if date_check and date_check.page_says_applies_to else ((meta.data_date if meta is defined and meta and meta.data_date else '08/24')) }} · 近處置 {{ (disposal.one_flag_from_disposal|length if disposal and disposal.one_flag_from_disposal else 5) }} · 出關 {{ (exiting_today|length if exiting_today is defined and exiting_today else 3) }}</title>

<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-180.png">
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js').catch(function(err) {
      if (localStorage.getItem('pmit_debug') === '1') console.warn('SW register info:', err);
    });
    navigator.serviceWorker.addEventListener('message', function(event) {
      if (event.data && event.data.type === 'sw-updated') {
        var toast = document.getElementById('toast');
        if (toast) {
          toast.innerHTML = '🔄 盤前資料已有新版本 <button onclick="location.reload(true)" style="background:var(--blue); color:#fff; border:none; border-radius:4px; padding:3px 8px; margin-left:6px; cursor:pointer; font-weight:700;">點此更新</button>';
          toast.classList.add('show');
        }
      }
    });
  }
</script>

<style>
  :root {
    --bg-page: #F8FAFC;
    --bg-card: #FFFFFF;
    --bg-sub: #F1F5F9;
    --bg-hover: #E2E8F0;
    --border: #E2E8F0;
    --border-light: #F1F5F9;
    --border-strong: #CBD5E1;
    --text-main: #0F172A;
    --text-muted: #64748B;
    --text-light: #94A3B8;
    --rise: #E11D48;
    --fall: #16A34A;
    --amber: #D97706;
    --blue: #2563EB;
    --btn-bg: #FFFFFF;
    --btn-border: #E2E8F0;
    --btn-hover: #F1F5F9;

    --danger-bg: #FFF1F2;
    --danger-fg: #BE123C;
    --danger-border: #FECDD3;

    --amber-bg: #FFFBEB;
    --amber-fg: #92400E;
    --amber-border: #FDE68A;

    --blue-bg: #EFF6FF;
    --blue-fg: #1D4ED8;
    --blue-border: #BFDBFE;

    --green-bg: #ECFDF5;
    --green-fg: #047857;
    --green-border: #A7F3D0;

    --row-paused-bg: rgba(217, 119, 6, 0.08);

    --font-ui: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Text", "Segoe UI", Roboto, "PingFang TC", "Noto Sans TC", sans-serif;
    --font-mono: ui-monospace, "SF Mono", "Menlo", "Consolas", monospace;
    --shadow-sm: 0 1px 2px 0 rgba(15, 23, 42, 0.05);
    --shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.08), 0 1px 2px -1px rgba(15, 23, 42, 0.08);
    --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 2px 4px -2px rgba(15, 23, 42, 0.08);
    --safe-top: env(safe-area-inset-top, 0px);
    --safe-bottom: env(safe-area-inset-bottom, 0px);
    --safe-left: env(safe-area-inset-left, 0px);
    --safe-right: env(safe-area-inset-right, 0px);
  }

  :root[data-theme="dark"] {
    --bg-page: #090D16;
    --bg-card: #111827;
    --bg-sub: #1A2234;
    --bg-hover: #242E44;
    --border: rgba(255, 255, 255, 0.08);
    --border-light: rgba(255, 255, 255, 0.04);
    --border-strong: rgba(255, 255, 255, 0.15);
    --text-main: #F8FAFC;
    --text-muted: #94A3B8;
    --text-light: #64748B;
    --rise: #F87171;
    --fall: #34D399;
    --amber: #FBBF24;
    --blue: #60A5FA;
    --btn-bg: #1A2234;
    --btn-border: rgba(255, 255, 255, 0.1);
    --btn-hover: #242E44;

    --danger-bg: rgba(225, 29, 72, 0.14);
    --danger-fg: #FDA4AF;
    --danger-border: rgba(225, 29, 72, 0.3);

    --amber-bg: rgba(217, 119, 6, 0.14);
    --amber-fg: #FCD34D;
    --amber-border: rgba(217, 119, 6, 0.3);

    --blue-bg: rgba(37, 99, 235, 0.14);
    --blue-fg: #93C5FD;
    --blue-border: rgba(37, 99, 235, 0.3);

    --green-bg: rgba(16, 185, 129, 0.14);
    --green-fg: #6EE7B7;
    --green-border: rgba(16, 185, 129, 0.3);

    --row-paused-bg: rgba(217, 119, 6, 0.16);
    --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.3);
    --shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.4);
    --shadow-md: 0 6px 12px -2px rgba(0, 0, 0, 0.5);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text-main);
    font-family: var(--font-ui);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .font-mono { font-family: var(--font-mono); }
  .font-bold { font-weight: 600; }
  .rise { color: var(--rise) !important; }
  .fall { color: var(--fall) !important; }
  .amber { color: var(--amber) !important; }
  .blue { color: var(--blue) !important; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-wrap { max-width: 980px; margin: 0 auto; padding: 0 16px; }

  /* HEADER */
  .page-header {
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .header-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .page-title {
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }
  .meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
  }
  .meta-val {
    color: var(--text-main);
    font-weight: 600;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .status-badge.is-ok { background: var(--green-bg); color: var(--green-fg); border: 1px solid var(--green-border); }
  .status-badge.is-info { background: var(--blue-bg); color: var(--blue-fg); border: 1px solid var(--blue-border); }
  .status-badge.is-warning { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }

  /* NAV (Sticky Anchor & Tool Bar - ZERO HORIZONTAL SCROLL) */
  .page-nav {
    position: sticky;
    top: 0;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    z-index: 50;
    box-shadow: var(--shadow-sm);
    padding: 6px 0;
  }
  .nav-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .nav-sections {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    height: 28px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }
  .nav-link:hover, .nav-link.is-active {
    color: var(--text-main);
    background: var(--bg-sub);
  }
  .nav-link.is-active {
    color: var(--blue);
    font-weight: 700;
  }
  .nav-badge {
    background: var(--rise);
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    padding: 0 5px;
    height: 16px;
    line-height: 16px;
    border-radius: 8px;
    font-family: var(--font-mono);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .nav-utility-panel {
    margin-left: auto;
    position: relative;
  }
  .nav-utility-panel > summary {
    list-style: none;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0 9px;
    height: 28px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    box-sizing: border-box;
    white-space: nowrap;
  }
  .nav-utility-panel > summary::-webkit-details-marker { display: none; }
  .nav-utility-panel > summary::after { content: '▾'; color: var(--text-muted); font-size: 11px; }
  .nav-utility-panel[open] > summary { position: relative; z-index: 2; }
  .nav-utility-state { color: var(--text-muted); font-family: var(--font-mono); font-size: 10.5px; }
  .nav-utility-content {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 60;
    width: min(476px, calc(100vw - 32px));
    padding: 13px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
    box-shadow: 0 16px 34px rgba(15, 23, 42, 0.16);
  }
  .nav-utility-content::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 28px;
    width: 10px;
    height: 10px;
    background: var(--bg-card);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
    transform: rotate(45deg);
  }
  .utility-panel-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 1px 2px 11px;
    border-bottom: 1px solid var(--border-light);
  }
  .utility-panel-eyebrow {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .utility-panel-title { margin-top: 2px; color: var(--text-main); font-size: 14px; font-weight: 800; }
  .utility-panel-section { position: relative; z-index: 1; margin-top: 11px; }
  .utility-section-label {
    margin: 0 0 6px 2px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
  }
  .nav-utility-content .nav-actions {
    justify-content: flex-start;
    gap: 6px;
    margin: 0;
    padding: 9px;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    background: var(--bg-sub);
  }
  .nav-utility-content .today-briefing-details {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    background: var(--bg-sub);
  }
  .nav-utility-content .today-briefing-summary { padding: 9px 10px; background: transparent; }
  .nav-utility-content .today-briefing-card { box-shadow: none; }
  .nav-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0 9px;
    height: 28px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: all 0.15s ease;
    box-sizing: border-box;
    outline: none;
    white-space: nowrap;
  }
  .nav-btn:hover {
    background: var(--bg-hover);
    border-color: var(--text-light);
  }
  .nav-btn.filter-watch-only.is-active {
    background: var(--amber-bg);
    color: var(--amber-fg);
    border-color: var(--amber-border);
  }
  .nav-btn.btn-briefing.is-active {
    background: var(--blue-bg);
    color: var(--blue-fg);
    border-color: var(--blue-border);
  }

  @media (max-width: 768px) {
    .nav-inner {
      padding: 4px 10px;
      gap: 6px;
    }
    .nav-sections {
      width: 100%;
      justify-content: flex-start;
      gap: 2px;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .nav-link {
      flex: 0 0 auto;
      padding: 0 12px;
      font-size: 12.5px;
      height: 40px;
    }
    .nav-utility-panel {
      width: 100%;
      margin-left: 0;
      display: flex;
      justify-content: flex-end;
      border-top: 1px solid var(--border-light);
      padding-top: 4px;
    }
    .nav-utility-panel > summary { min-height: 40px; height: 40px; font-size: 12px; }
    .nav-utility-content { width: min(100vw - 20px, 476px); padding: 10px; }
    .utility-panel-header { padding-bottom: 9px; }
    .nav-utility-content .nav-actions { padding: 7px; }
    .nav-btn {
      flex: 1;
      padding: 0 6px;
      font-size: 12px;
      height: 40px;
    }
    .nav-btn .btn-text-extra {
      display: none;
    }
  }

  /* CONTENT SECTIONS */
  .page-main {
    max-width: 980px;
    margin: 0 auto;
    padding: 20px 16px 60px;
  }
  .content-section {
    margin-bottom: 32px;
    scroll-margin-top: 76px;
  }
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .section-title {
    font-size: 16px;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .title-icon { font-size: 16px; }
  .section-desc {
    font-size: 12px;
    color: var(--text-muted);
  }

  /* CARDS */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 14px;
    overflow: hidden;
  }
  .card-head {
    padding: 12px 16px;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .card-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }
  .count-badge {
    background: var(--bg-sub);
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 12px;
    font-family: var(--font-mono);
  }
  .count-badge.danger { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }
  .count-badge.amber { background: var(--amber-bg); color: var(--amber-fg); border: 1px solid var(--amber-border); }
  .card-tip {
    font-size: 12px;
    color: var(--text-muted);
  }
  .data-block { padding: 14px 16px; }

  /* 1. SUMMARY GRID (COMPACT DASHBOARD) */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 8px;
  }
  .summary-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 66px;
  }
  .summary-card.alert-highlight {
    background: var(--danger-bg);
    border-color: var(--danger-border);
  }
  .card-label {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 2px;
  }
  .card-val {
    font-size: 17px;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 2px;
  }
  .card-val.rise { color: var(--rise); }
  .card-val.fall { color: var(--fall); }
  .card-val.amber { color: var(--amber); }
  .card-sub {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .inst-chips {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 2px;
  }
  .inst-chips .chip {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
  }
  .inst-chips-mobile { display: none; }

  /* ACCESSIBLE FOCUS INDICATOR */
  :focus-visible {
    outline: 2px solid var(--blue) !important;
    outline-offset: 2px !important;
  }
  :root[data-theme="dark"] :focus-visible {
    outline: 2px solid #60A5FA !important;
    outline-offset: 2px !important;
  }

  /* HEADER STATUS BUTTON */
  .header-status-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-main);
    transition: all 0.15s ease;
  }
  .header-status-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  .header-status-btn .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .header-status-btn.is-ready {
    background: var(--green-bg);
    color: var(--green-fg);
    border-color: var(--green-border);
  }
  .header-status-btn.is-caution {
    background: var(--amber-bg);
    color: var(--amber-fg);
    border-color: var(--amber-border);
  }
  .header-status-btn.is-unsafe {
    background: var(--danger-bg);
    color: var(--danger-fg);
    border-color: var(--danger-border);
  }

  /* TODAY INTEL BRIEFING CARD */
  .today-briefing-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.2fr;
    gap: 10px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 10px;
    box-shadow: var(--shadow-sm);
  }
  .today-briefing-details {
    margin-bottom: 10px;
  }
  .today-briefing-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border: 1.5px solid var(--amber-border);
    border-radius: 8px;
    background: var(--amber-bg);
    color: var(--text-main);
    cursor: pointer;
    list-style: none;
    box-shadow: var(--shadow-sm);
  }
  .today-briefing-summary::-webkit-details-marker { display: none; }
  .today-briefing-summary::after { content: '▾'; color: var(--text-muted); font-size: 12px; }
  .today-briefing-details[open] > .today-briefing-summary { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .briefing-summary-title { font-size: 12px; font-weight: 700; }
  .briefing-summary-status { margin-left: auto; font-size: 11.5px; font-weight: 600; color: var(--text-muted); }
  .today-briefing-card.is-unsafe-alert {
    border: 2px solid var(--danger-border);
    background: var(--danger-bg);
  }
  .today-briefing-card.is-caution-alert {
    border: 1.5px solid var(--amber-border);
    background: var(--amber-bg);
  }
  .briefing-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
  }
  .briefing-col-lbl {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .briefing-status-val, .briefing-watch-val, .briefing-events-val {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .briefing-reason-summary {
    font-size: 11.5px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 180px;
  }
  .briefing-built-relative {
    display: none;
    color: var(--text-muted);
    font-size: 11px;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .briefing-watch-val .hit-count {
    color: var(--blue);
    font-weight: 700;
  }
  .briefing-watch-val .hit-count.has-hit {
    color: var(--rise);
  }
  .event-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--bg-sub);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    border: 1px solid var(--border);
  }
  .event-more-tag {
    font-size: 10.5px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .mobile-scroll-hint {
    display: none;
    font-size: 11px;
    color: var(--text-muted);
    text-align: center;
    padding: 4px 0;
    background: var(--bg-sub);
    border-radius: 4px;
    margin-bottom: 6px;
  }
  @media (max-width: 768px) {
    .today-briefing-card {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 8px 10px;
    }
    .mobile-scroll-hint {
      display: block;
    }
  }

  /* STALE BANNER */
  .stale-banner {
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 10px;
    background: var(--green-bg);
    color: var(--green-fg);
    border: 1px solid var(--green-border);
  }
  .stale-banner.is-warning { background: var(--amber-bg) !important; color: var(--amber-fg) !important; border-color: var(--amber-border) !important; }
  .stale-banner.is-danger  { background: var(--danger-bg) !important; color: var(--danger-fg) !important; border-color: var(--danger-border) !important; }

  /* WATCHLIST MODERN CARD */
  .watchlist-card {
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow: hidden;
  }
  .watchlist-details > summary {
    cursor: pointer;
    list-style: none;
  }
  .watchlist-details > summary::-webkit-details-marker { display: none; }
  .watchlist-details > summary::after {
    content: '▾';
    color: var(--text-muted);
    font-size: 12px;
    margin-left: 4px;
  }
  .watchlist-details[open] > summary { border-bottom-color: var(--border); }
  .watch-summary-hits {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 6px;
    margin-left: 8px;
    flex-wrap: wrap;
  }
  .watch-summary-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .watch-summary-chip:hover { transform: translateY(-1px); border-color: var(--border-strong); }
  .watch-summary-chip:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .watch-summary-chip.is-alert { border-color: var(--danger-border); background: var(--danger-bg); color: var(--danger-fg); }
  .watch-summary-chip.is-amber { border-color: var(--amber-border); background: var(--amber-bg); color: var(--amber-fg); }
  .watch-summary-chip.is-candidate { border-color: var(--blue-border); background: var(--blue-bg); color: var(--blue-fg); }
  .watch-summary-empty { color: var(--text-muted); font-size: 12px; white-space: nowrap; }
  .watch-summary-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    margin-left: auto;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }
  .watch-control-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .watch-input-wrapper {
    flex: 1;
    min-width: 260px;
    display: flex;
    align-items: center;
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3px 4px 3px 12px;
    transition: all 0.15s ease;
  }
  .watch-input-wrapper:focus-within {
    border-color: var(--blue);
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
    background: var(--bg-card);
  }
  .watch-input-icon {
    font-size: 13px;
    color: var(--text-muted);
    margin-right: 8px;
  }
  .watch-input-modern {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 13px;
    outline: none;
    padding: 6px 0;
  }
  .watch-input-modern::placeholder {
    color: var(--text-muted);
    opacity: 0.75;
  }
  .watch-btn-inline {
    background: var(--blue);
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }
  .watch-btn-inline:hover { opacity: 0.9; }

  .watch-actions-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .watch-btn-modern {
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .watch-btn-modern.primary {
    background: var(--blue);
    color: #FFFFFF;
    border-color: var(--blue);
  }
  .watch-btn-modern.primary:hover {
    opacity: 0.9;
  }
  .watch-btn-modern:hover {
    background: var(--bg-hover);
    border-color: var(--text-light);
  }
  .watch-btn-modern.danger-hover:hover {
    background: var(--danger-bg);
    color: var(--danger-fg);
    border-color: var(--danger-border);
  }

  .watch-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .watch-chip {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: var(--shadow-sm);
  }
  .watch-chip:hover {
    border-color: var(--blue);
    transform: translateY(-1px);
  }
  .watch-chip .wc-icon { font-size: 11px; }
  .watch-chip .wc-code { color: var(--blue); font-weight: 700; }
  .watch-chip .wc-name { color: var(--text-main); font-weight: 600; }
  .watch-chip.alert { border-left: 3px solid var(--rise); background: var(--danger-bg); color: var(--danger-fg); }
  .watch-chip.amber { border-left: 3px solid var(--amber); background: var(--amber-bg); color: var(--amber-fg); }
  .watch-chip.blue  { border-left: 3px solid var(--blue); background: var(--blue-bg); color: var(--blue-fg); }
  .watch-chip .wc-del { cursor: pointer; color: var(--text-light); margin-left: 2px; }
  .watch-chip .wc-del:hover { color: var(--rise); }
  .watch-hint { color: var(--text-muted); font-size: 12px; padding: 6px 0; }
  @media (max-width: 768px) {
    .watchlist-summary { align-items: flex-start; }
    .watch-summary-hits { order: 3; width: 100%; margin: 0; }
  }

  /* WATCHLIST ROW HIGHLIGHT */
  tr.highlight-row,
  tr.highlight-row td {
    background-color: #FEF9C3 !important;
  }
  :root[data-theme="dark"] tr.highlight-row,
  :root[data-theme="dark"] tr.highlight-row td {
    background-color: rgba(234, 179, 8, 0.16) !important;
  }
  tr.highlight-row:hover td {
    background-color: #FEF08A !important;
  }
  :root[data-theme="dark"] tr.highlight-row:hover td {
    background-color: rgba(234, 179, 8, 0.26) !important;
  }

  /* FLASH HIGHLIGHT */
  @keyframes flash-pulse {
    0%, 100% { outline: 2px solid transparent; }
    50% { outline: 2px solid var(--amber); background: var(--amber-bg); }
  }
  .highlight-flash {
    animation: flash-pulse 1s ease 2;
  }

  /* DATA TABLES */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }
  .data-table th {
    background: var(--bg-sub);
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
  }
  .data-table th:hover {
    color: var(--text-main);
    background: var(--bg-hover);
  }
  .data-table th .sort-arrow { font-size: 9px; margin-left: 4px; opacity: 0.5; }
  .data-table th.sorted .sort-arrow { opacity: 1; color: var(--blue); }
  .data-table td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
    color: var(--text-main);
  }
  .data-table tr:hover td { background: var(--bg-sub); }
  .data-table tr.row-paused td { background: var(--row-paused-bg); }
  .pause-icon { display: inline-block; margin-right: 4px; color: var(--amber); font-weight: 700; }
  .data-table td.num, .data-table th.num { text-align: right; }
  .empty-state {
    padding: 24px;
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
  }

  /* 2-LINE CONDITION LAYOUT */
  .cond-box {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12px;
  }
  .cond-row-1 {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }
  .cond-num-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--green-bg);
    color: var(--green-fg);
    border: 1px solid var(--green-border);
    font-size: 11px;
    font-weight: 700;
  }
  .cond-row-2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  .cond-pill {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--bg-sub);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .cond-row-3 {
    color: var(--text-light);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  /* BADGE DOTS */
  .badge-col { text-align: center; }
  .badge-dots { display: inline-flex; gap: 2px; }
  .badge-dots .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .badge-dots .dot.filled { background: var(--amber); }
  .badge-frac { font-size: 11px; color: var(--text-muted); margin-left: 4px; }
  .mini-bar {
    display: none;
    position: relative;
    width: 48px;
    height: 14px;
    background: var(--bg-sub);
    border-radius: 3px;
    overflow: hidden;
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
    text-align: center;
    color: var(--text-main);
  }
  .mini-bar::before {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: var(--pct, 0%);
    background: var(--amber);
    opacity: 0.35;
  }

  /* BADGES */
  .badge {
    display: inline-flex;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    background: var(--bg-sub);
    color: var(--text-muted);
  }
  .badge-amber { background: var(--amber-bg); color: var(--amber-fg); border: 1px solid var(--amber-border); }
  .badge-green { background: var(--green-bg); color: var(--green-fg); border: 1px solid var(--green-border); }
  .badge-blue { background: var(--blue-bg); color: var(--blue-fg); border: 1px solid var(--blue-border); }

  /* IFRAME EMBEDS */
  .unref-accordion {
    border-bottom: 1px solid var(--border);
  }
  .unref-accordion:last-child { border-bottom: none; }
  .unref-summary {
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
    background: var(--bg-card);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .unref-summary:hover { background: var(--bg-sub); }
  .unref-content {
    padding: 10px 14px 14px;
    background: var(--bg-card);
    resize: vertical;
    overflow: auto;
    min-height: 140px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
  }
  .embed-frame, .unref-frame {
    width: 100%;
    border: none;
    border-radius: 6px;
    background: transparent;
    display: block;
    overflow: hidden;
    transition: height 0.15s ease-out;
  }

  /* TILES GRID */
  .tiles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }
  .tile-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }
  .tile-card:hover {
    border-color: var(--border-strong);
  }
  .tile-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .tile-name { font-size: 12px; font-weight: 700; color: var(--text-main); }
  .tile-delay-pill {
    font-size: 10px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .tile-quote-time { font-size: 10.5px; letter-spacing: 0; white-space: nowrap; }
  .tile-source-row { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
  .tile-source-row .cal-link-btn { padding: 2px 6px; font-size: 10px; flex: 0 0 auto; }
  .tile-source-row .tile-quote-time { margin-left: auto; }
  .asia-quote-card { padding: 14px 16px; min-height: 116px; }
  .asia-quote-card .tile-head { order: 0; margin-bottom: 2px; }
  .asia-quote-card .tile-name { font-size: 14px; font-weight: 800; letter-spacing: 0.01em; }
  .asia-quote-card .tile-val { order: 1; margin-top: 2px; font-size: 25px; line-height: 1.12; letter-spacing: 0.01em; }
  .asia-quote-card .tile-chg { order: 2; margin-top: 3px; font-size: 13px; line-height: 1.3; font-weight: 800; }
  .asia-quote-card .tile-source-row {
    order: 3;
    margin: 10px 0 0;
    padding-top: 7px;
    border-top: 1px solid var(--border-light);
  }
  .asia-quote-card .tile-source-row .tile-quote-time { font-size: 10px; font-weight: 600; }
  .pill-fresh { background: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border); }
  .pill-amber { background: var(--amber-bg); color: var(--amber-fg); border: 1px solid var(--amber-border); }
  .pill-danger { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }
  .tile-val { font-size: 15px; font-weight: 800; }
  .tile-chg { font-size: 11px; font-weight: 600; }

  /* BACK TO TOP */
  .back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    transition: all 0.2s ease;
  }
  .back-to-top:hover {
    background: var(--bg-sub);
    transform: translateY(-2px);
  }

  /* TOAST */
  .toast {
    position: fixed;
    bottom: 24px;
    left: 24px;
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-md);
    padding: 10px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    z-index: 100;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease;
    pointer-events: none;
  }
  .toast.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* SHORTCUTS MODAL */
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    z-index: 150;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .modal-overlay.open { display: flex; }
  .modal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--shadow-md);
    padding: 20px;
  }
  .modal-title { font-size: 16px; font-weight: 800; margin: 0 0 14px; color: var(--text-main); }
  .shortcut-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px; }
  .shortcut-item { display: flex; align-items: center; gap: 8px; }
  .kbd {
    display: inline-block;
    padding: 2px 6px;
    background: var(--bg-sub);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-main);
  }

  /* SNAPSHOT / PRINT MODE */
  body.snapshot-mode .page-nav,
  body.snapshot-mode .page-header,
  body.snapshot-mode .stale-banner,
  body.snapshot-mode .page-footer,
  body.snapshot-mode #news-calendar,
  body.snapshot-mode #market-context,
  body.snapshot-mode .back-to-top {
    display: none !important;
  }
  body.snapshot-mode .page-main { padding: 10px 0; max-width: 100%; }

  @media print {
    .page-nav, .stale-banner, .page-footer, .back-to-top, .watchlist-input-row, .unref-accordion { display: none !important; }
    body { background: #FFFFFF; color: #000000; }
    .card { border: 1px solid #CCCCCC; box-shadow: none; }
    .rise::before { content: '▲ '; }
    .fall::before { content: '▼ '; }
  }

  /* MOBILE RESPONSIVE (max-width: 768px) */
  @media (max-width: 768px) {
    .data-table td .ed-cell {
      align-items: flex-start !important;
    }
    .data-table td .ed-badge {
      font-size: 10px !important;
    }
    .summary-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .tiles-grid { grid-template-columns: repeat(2, 1fr); }
    .badge-dots { display: none; }
    .mini-bar { display: inline-block; }

    .inst-chips { display: none; }
    .inst-chips-mobile { display: block; font-size: 12px; margin-top: 4px; }

    .data-table thead { display: none; }
    .data-table, .data-table tbody, .data-table tr, .data-table td { display: block; }
    .data-table tr {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 10px;
      background: var(--bg-card);
    }
    .data-table td {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 6px;
      padding: 4px 0;
      border-bottom: 1px solid var(--border);
    }
    .data-table td:last-child { border-bottom: none; }
    .data-table td::before {
      content: attr(data-label);
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
    }
    .data-table td.num { text-align: left; }
    .data-table td.badge-col { text-align: left; }
  }

  /* MOBILE OPTIMIZATIONS: preserve desktop rendering, improve phone/tablet use. */
  @media (max-width: 768px) {
    .page-nav { padding-top: calc(6px + var(--safe-top)); }
    .page-main { padding-bottom: calc(60px + var(--safe-bottom)); }
    .page-footer { padding-bottom: calc(16px + var(--safe-bottom)); }
    .back-to-top {
      bottom: calc(24px + var(--safe-bottom));
      right: calc(24px + var(--safe-right));
    }
    .toast {
      bottom: calc(24px + var(--safe-bottom));
      left: calc(24px + var(--safe-left));
    }

    .cal-chip { min-height: 36px; padding: 6px 12px; }
    .watch-input-modern,
    .cal-search-input,
    .nav-utility-content input { font-size: 16px; }
    .wc-del { width: 24px; height: 24px; min-width: 24px; font-size: 14px; }

    .data-table tr { padding: 12px 14px; }
    .data-table td.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .table-scroll {
      position: relative;
      background:
        linear-gradient(to right, var(--bg-card) 30%, rgba(255,255,255,0)) left / 40px 100% no-repeat local,
        linear-gradient(to left, var(--bg-card) 30%, rgba(255,255,255,0)) right / 40px 100% no-repeat local,
        radial-gradient(farthest-side at 0 50%, rgba(0,0,0,.18), rgba(0,0,0,0)) left / 14px 100% no-repeat local,
        radial-gradient(farthest-side at 100% 50%, rgba(0,0,0,.18), rgba(0,0,0,0)) right / 14px 100% no-repeat local;
      background-color: var(--bg-card);
    }
    .table-scroll.is-overflowing::before {
      content: '← 左右滑動查看完整欄位 →';
      display: block;
      position: sticky;
      left: 0;
      z-index: 1;
      width: 100%;
      padding: 4px 8px;
      margin-bottom: 4px;
      border-radius: 4px;
      background: var(--bg-sub);
      color: var(--text-muted);
      text-align: center;
      font-size: 11px;
      line-height: 1.35;
      pointer-events: none;
    }
    .table-scroll.is-overflowing.is-scrolled::before {
      content: '← 繼續左右滑動查看完整欄位 →';
    }
    :root[data-theme="dark"] .table-scroll {
      background:
        linear-gradient(to right, var(--bg-card) 30%, rgba(255,255,255,0)) left / 40px 100% no-repeat local,
        linear-gradient(to left, var(--bg-card) 30%, rgba(255,255,255,0)) right / 40px 100% no-repeat local,
        radial-gradient(farthest-side at 0 50%, rgba(0,0,0,.45), rgba(0,0,0,0)) left / 14px 100% no-repeat local,
        radial-gradient(farthest-side at 100% 50%, rgba(0,0,0,.45), rgba(0,0,0,0)) right / 14px 100% no-repeat local;
      background-color: var(--bg-card);
    }

    /* The actual disposal table starts with 市場, then 代號; keep the identifier visible. */
    .data-table.disposal-table {
      display: table;
      min-width: 640px;
      width: max-content;
    }
    .data-table.disposal-table thead { display: table-header-group; }
    .data-table.disposal-table tbody { display: table-row-group; }
    .data-table.disposal-table tr {
      display: table-row;
      padding: 0;
      border: 0;
      border-radius: 0;
      margin: 0;
      background: transparent;
    }
    .data-table.disposal-table th { display: table-cell; }
    .data-table.disposal-table td {
      display: table-cell;
      padding: 9px 10px;
      border-bottom: 1px solid var(--border);
    }
    .data-table.disposal-table td::before { display: none; content: none; }
    .disposal-table th:nth-child(2),
    .disposal-table td:nth-child(2) {
      position: sticky;
      left: 0;
      z-index: 3;
      min-width: 65px;
      background: var(--bg-card);
      box-shadow: 2px 0 4px rgba(0,0,0,.08);
    }
    .disposal-table th:nth-child(3),
    .disposal-table td:nth-child(3) {
      position: sticky;
      left: 65px;
      z-index: 3;
      min-width: 75px;
      background: var(--bg-card);
      border-right: 1px solid var(--border);
      box-shadow: 3px 0 5px rgba(0,0,0,.08);
    }
    .disposal-table th:nth-child(2),
    .disposal-table th:nth-child(3) {
      background: var(--bg-sub);
      z-index: 4;
    }

    .briefing-built-relative { display: inline; }
    .content-section {
      content-visibility: auto;
      contain-intrinsic-size: 1px 800px;
    }
    .nav-link:active,
    .nav-btn:active,
    .cal-chip:active,
    .watch-btn-modern:active,
    .watch-btn-inline:active,
    .wc-del:active {
      opacity: .7;
      transform: scale(.97);
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    .summary-grid, .tiles-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 480px) {
    .summary-grid, .tiles-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* DESKTOP READABILITY: retain the 280a9dc layout while easing dense text scanning. */
  @media (min-width: 769px) {
    .section-title { font-size: 17px; }
    .section-desc, .card-tip { font-size: 13px; line-height: 1.55; }
    .card-title { font-size: 15px; }
    .card-label, .briefing-col-lbl { font-size: 11px; }
    .card-sub, .inst-chips .chip { font-size: 11.5px; line-height: 1.5; }
    .briefing-summary-title, .briefing-status-val, .briefing-watch-val, .briefing-events-val { font-size: 13px; }
    .briefing-summary-status, .briefing-reason-summary { font-size: 12px; }
    .data-table { font-size: 14px; line-height: 1.5; }
    .data-table th { font-size: 11.5px; line-height: 1.4; }
    .cal-date-title, .cal-time-group { font-size: 13.5px; }
    .cal-card-title { font-size: 14px; line-height: 1.55; }
    .cal-metrics-grid { font-size: 11.5px; }
    .tile-quote-time { font-size: 11px; }
    .news-title { font-size: 14px !important; line-height: 1.55; }
    .news-meta { font-size: 11.5px !important; line-height: 1.5; }
  }

  /* Wide Table Sticky Key Columns (Desktop / Tablet Scroll) */
  @media (min-width: 769px) {
    .disposal-table th:nth-child(1),
    .disposal-table td:nth-child(1) {
      position: sticky;
      left: 0;
      z-index: 2;
      background: var(--bg-card);
      min-width: 48px;
    }
    .disposal-table th:nth-child(2),
    .disposal-table td:nth-child(2) {
      position: sticky;
      left: 48px;
      z-index: 2;
      background: var(--bg-card);
      min-width: 65px;
    }
    .disposal-table th:nth-child(3),
    .disposal-table td:nth-child(3) {
      position: sticky;
      left: 113px;
      z-index: 2;
      background: var(--bg-card);
      min-width: 75px;
      border-right: 1px solid var(--border);
      box-shadow: 3px 0 5px rgba(0, 0, 0, 0.05);
    }
    .disposal-table th:nth-child(1),
    .disposal-table th:nth-child(2),
    .disposal-table th:nth-child(3) {
      background: var(--bg-sub);
      z-index: 4;
    }
  }

  /* EMBED FRAME WRAPPER & RETRY */
  .embed-frame-wrapper {
    position: relative;
    width: 100%;
    min-height: 120px;
    transition: min-height 0.2s ease;
  }
  .embed-frame-wrapper.is-loading::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(90deg, var(--bg-sub) 25%, var(--bg-hover) 50%, var(--bg-sub) 75%);
    background-size: 200% 100%;
    animation: skeleton-pulse 1.5s infinite;
    border-radius: 8px;
    z-index: 1;
    pointer-events: none;
  }
  @keyframes skeleton-pulse {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .embed-fallback-notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px;
    font-size: 12.5px;
    color: var(--text-muted);
    background: var(--bg-sub);
    border-radius: 6px;
    margin: 8px 0;
  }
  .btn-retry {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    color: var(--blue);
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-retry:hover {
    background: var(--bg-hover);
    border-color: var(--blue);
  }

  /* FOOTER */
  .page-footer {
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    padding: 16px 0;
    font-size: 12px;
    color: var(--text-muted);
  }
  .footer-inner { max-width: 980px; margin: 0 auto; padding: 0 16px; }
  .footer-details {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-sub);
    overflow: hidden;
  }
  .footer-summary {
    padding: 9px 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    color: var(--text-main);
    user-select: none;
    transition: background 0.15s ease;
    list-style: none;
  }
  .footer-summary::-webkit-details-marker { display: none; }
  .footer-summary:hover {
    background: var(--bg-hover);
  }
  .footer-summary-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }
  .footer-summary-badge {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: normal;
  }
  .footer-details[open] .footer-summary-badge {
    color: var(--blue);
  }
  .footer-details[open] .footer-summary {
    border-bottom: 1px solid var(--border);
  }
  .footer-content {
    padding: 12px 16px;
  }
  .footer-notes { padding-left: 18px; margin: 0 0 8px; line-height: 1.6; font-size: 12px; }
  .footer-notes li { margin-bottom: 4px; }

  /* CALENDAR DASHBOARD & TIMELINE */
  .cal-dashboard-card {
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow: hidden;
  }
  .cal-dashboard-head {
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
  }
  .cal-head-tools {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .cal-tool-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s ease;
  }
  .cal-tool-btn:hover {
    background: var(--bg-hover);
    border-color: var(--text-muted);
  }
  .cal-tool-btn.ghost {
    border-color: transparent;
    color: var(--text-muted);
  }
  .cal-tool-btn.ghost:hover {
    color: var(--text-main);
    background: var(--bg-sub);
  }

  /* Sticky Filter Toolbar */
  .cal-filter-toolbar {
    background: var(--bg-sub);
    border-bottom: 1px solid var(--border);
    padding: 10px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cal-filter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cal-filter-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  .cal-filter-lbl {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    margin-right: 2px;
  }
  .cal-chip {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 3px 8px;
    border-radius: 14px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }
  .cal-chip:hover {
    background: var(--bg-hover);
    color: var(--text-main);
  }
  .cal-chip.active {
    background: var(--blue-bg);
    color: var(--blue-fg);
    border-color: var(--blue-border);
    font-weight: 700;
  }
  .cal-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 220px;
    flex: 1;
    max-width: 320px;
  }
  .cal-search-input {
    width: 100%;
    padding: 6px 28px 6px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-main);
    font-size: 12px;
    outline: none;
  }
  .cal-search-input:focus {
    border-color: var(--blue);
  }
  .cal-search-clear {
    position: absolute;
    right: 6px;
    background: none;
    border: none;
    color: var(--text-light);
    cursor: pointer;
    font-size: 12px;
    padding: 2px 4px;
  }
  .cal-search-clear:hover { color: var(--text-main); }

  /* Timeline Groups */
  .cal-timeline-container {
    padding: 16px;
  }
  .cal-date-section {
    margin-bottom: 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    overflow: hidden;
  }
  .cal-date-section.is-today-section {
    border-color: var(--blue-border);
    box-shadow: 0 0 0 1px var(--blue-border);
  }
  .cal-date-header {
    padding: 10px 14px;
    background: var(--bg-sub);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    user-select: none;
  }
  .cal-date-section.is-today-section .cal-date-header {
    background: var(--blue-bg);
    color: var(--blue-fg);
  }
  .cal-date-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
  }
  .cal-date-section.is-today-section .cal-date-title {
    color: var(--blue-fg);
  }
  .cal-date-count {
    margin-left: auto;
    font-size: 11px;
    font-family: var(--font-mono);
  }
  .cal-accordion-arrow {
    font-size: 10px;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .cal-date-body {
    display: none;
    padding: 12px 14px;
  }
  .cal-date-body.is-open {
    display: block;
  }
  .cal-date-section.open-sec .cal-accordion-arrow {
    transform: rotate(180deg);
  }

  /* Timeline Track & Cards */
  .cal-timeline-track {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cal-event-card {
    display: flex;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    position: relative;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .cal-event-card:hover {
    border-color: var(--border-strong);
    background: var(--bg-sub);
  }
  .cal-event-card.is-high-impact {
    border-left: 3px solid var(--rise);
  }
  .cal-event-card.is-past {
    opacity: 0.55;
  }
  .cal-event-card.is-past:hover {
    opacity: 0.85;
  }
  .cal-event-card.is-past .cal-card-title {
    color: var(--text-muted);
  }
  .cal-date-section.is-past-group .cal-date-title {
    color: var(--text-muted);
  }
  .cal-event-card.is-past .cal-countdown-badge {
    display: none;
  }
  .cal-event-card.is-live {
    animation: pulse-live 2s infinite;
    border-color: var(--green-border);
  }
  @keyframes pulse-live {
    0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    50% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  }

  .cal-node-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-right: 12px;
    width: 14px;
  }
  .cal-node-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
    margin-top: 4px;
  }
  .cal-node-dot.high-node {
    width: 10px;
    height: 10px;
    background: var(--rise);
  }
  .cal-node-line {
    flex: 1;
    width: 2px;
    background: var(--border);
    margin-top: 4px;
  }
  .cal-card-main {
    flex: 1;
    min-width: 0;
  }

  .cal-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 4px;
  }
  .cal-time-group {
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cal-time-origin {
    color: var(--text-muted);
  }
  .cal-time-tpe {
    color: var(--text-main);
  }
  .cal-countdown-badge {
    background: var(--green-bg);
    color: var(--green-fg);
    border: 1px solid var(--green-border);
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 4px;
    display: none;
  }
  .cal-countdown-badge.show { display: inline-block; }

  .cal-badges-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .imp-badge {
    font-size: 10px;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .imp-badge.imp-3 { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }
  .imp-badge.imp-2 { background: var(--amber-bg); color: var(--amber-fg); border: 1px solid var(--amber-border); }
  .imp-badge.imp-1 { background: var(--bg-sub); color: var(--text-muted); border: 1px solid var(--border); }

  .cal-country-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .cal-category-badge {
    background: var(--bg-sub);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 600;
    padding: 1px 5px;
    border-radius: 4px;
  }

  .cal-card-title {
    font-size: 13px;
    color: var(--text-main);
    line-height: 1.4;
    margin-bottom: 6px;
  }

  /* 3-Column Metrics */
  .cal-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    background: var(--bg-sub);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .metric-cell {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .metric-lbl {
    color: var(--text-muted);
  }
  .metric-val {
    color: var(--text-main);
    font-weight: 600;
  }
  .actual-cell.beat .metric-val { color: var(--fall); font-weight: 700; }
  .actual-cell.miss .metric-val { color: var(--rise); font-weight: 700; }
  .cmp-icon { font-size: 9px; font-weight: bold; }

  .cal-card-detail {
    display: none;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
    font-size: 12px;
  }
  .cal-card-detail.open { display: block; }
  .cal-note-text {
    color: var(--text-muted);
    white-space: pre-wrap;
    line-height: 1.5;
    margin-bottom: 8px;
  }
  .cal-action-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cal-link-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 600;
    color: var(--blue);
    text-decoration: none;
    cursor: pointer;
  }
  .cal-link-btn:hover {
    background: var(--bg-sub);
  }

  /* Status Indicators in Header */
  .health-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 4px;
  }
  .health-dot.ok { background: var(--fall); box-shadow: 0 0 4px var(--fall); }
  .health-dot.warn { background: var(--amber); }
  .health-dot.error { background: var(--rise); animation: pulse-warn 1.5s infinite; }


  /* TABLE SCROLL CONTAINER */
  .table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 8px;
  }
  .table-scroll table {
    margin-bottom: 0;
  }

  /* COND COLLAPSIBLE */
  .cond-collapsible {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cond-collapsible .cond-hidden {
    display: none;
    flex-wrap: wrap;
    gap: 4px;
  }
  .cond-collapsible.is-expanded .cond-hidden {
    display: flex;
  }
  .cond-toggle-btn {
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    color: var(--blue);
    cursor: pointer;
    align-self: flex-start;
    margin-top: 2px;
  }
  .cond-collapsible.is-expanded .cond-toggle-btn {
    color: var(--text-muted);
  }

  /* VAL MISSING BADGE */
  .val-missing {
    color: var(--amber);
    font-weight: 700;
    font-size: 13px;
  }

  /* HEALTH INDICATOR IN HEADER */
  .health-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .health-btn {
    background: none;
    border: none;
    color: var(--amber);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
  }

  /* MOBILE NAV & BADGE */
  .badge-nowrap { white-space: nowrap !important; }

  @media (max-width: 768px) {
    .cal-filter-toolbar {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .cal-filter-row {
      flex-wrap: nowrap;
      min-width: max-content;
    }
    .cal-filter-row.secondary {
      flex-wrap: wrap;
      min-width: 0;
    }
    .cal-chip {
      flex: 0 0 auto;
      min-height: 36px;
      padding: 6px 12px;
    }
    .cal-search-input {
      width: 100%;
      font-size: 16px;
    }
  }


  /* WATCHLIST LINKED HIGHLIGHTS */
  .watchlist-star-marker {
    color: var(--amber);
    font-weight: 700;
    font-size: 13px;
    margin-right: 4px;
    display: inline-block;
  }
  .watchlist-alert-banner {
    background: var(--amber-bg);
    border: 1px solid var(--amber-border);
    color: var(--amber-fg);
    border-radius: 8px;
    padding: 8px 14px;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 600;
    display: none;
    align-items: center;
    gap: 6px;
  }
  .source-warning-banner {
    background: var(--danger-bg);
    border: 1px solid var(--danger-border);
    color: var(--danger-fg);
    border-radius: 8px;
    padding: 8px 14px;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 600;
    display: none;
  }


  /* BATCH IMPORT MODAL */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .modal-overlay.is-open { display: flex; }
  .modal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    width: 100%;
    max-width: 580px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .modal-head {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .modal-title { font-size: 15px; font-weight: 700; color: var(--text-main); }
  .modal-close {
    background: transparent;
    border: none;
    font-size: 18px;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .modal-close:hover { color: var(--text-main); background: var(--bg-sub); }
  .modal-body {
    padding: 18px 20px;
    overflow-y: auto;
    flex: 1;
  }
  .batch-textarea {
    width: 100%;
    height: 140px;
    box-sizing: border-box;
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 13px;
    resize: vertical;
    outline: none;
  }
  .batch-textarea:focus { border-color: var(--blue); background: var(--bg-card); }
  .batch-preview-box {
    margin-top: 14px;
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
  }
  .batch-preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .btn-clear-preview {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
    text-decoration: underline;
  }
  .batch-preview-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-height: 100px;
    overflow-y: auto;
  }
  .batch-preview-chip {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-main);
  }
  .modal-foot {
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    background: var(--bg-sub);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }
  .watch-btn.primary {
    background: var(--blue);
    color: #FFFFFF;
    border-color: var(--blue);
  }
  .watch-btn.primary:hover {
    opacity: 0.9;
  }


  /* DISPOSAL EARLIEST DATE CELL */
  .ed-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
  }
  .ed-date {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
    font-family: var(--font-mono);
    line-height: 1.2;
  }
  .ed-badge {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
    padding: 1.5px 6px;
    border-radius: 4px;
    white-space: nowrap;
    background: rgba(217, 119, 6, 0.1);
    color: var(--amber);
    border: 1px solid rgba(217, 119, 6, 0.25);
    line-height: 1.3;
  }
  .ed-badge.badge-5m {
    background: rgba(217, 119, 6, 0.12);
    color: var(--amber);
    border: 1px solid rgba(217, 119, 6, 0.35);
  }
  .ed-badge.badge-20m {
    background: var(--danger-bg);
    color: var(--danger-fg);
    border: 1px solid var(--danger-border);
    font-weight: 700;
  }
  :root[data-theme="dark"] .ed-badge {
    background: rgba(251, 191, 36, 0.12);
    color: #FCD34D;
    border: 1px solid rgba(251, 191, 36, 0.25);
  }
  :root[data-theme="dark"] .ed-badge.badge-5m {
    background: rgba(251, 191, 36, 0.15);
    color: #FCD34D;
    border: 1px solid rgba(251, 191, 36, 0.35);
  }
  :root[data-theme="dark"] .ed-badge.badge-20m {
    background: rgba(244, 63, 94, 0.18);
    color: #FDA4AF;
    border: 1px solid rgba(244, 63, 94, 0.35);
  }


  /* WATCHLIST REDESIGN */
  .watch-main-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
  }
  .watch-stat-left {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    color: var(--text-main);
  }
  .watch-stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: 12px;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--bg-sub);
    color: var(--text-muted);
    transition: all 0.15s ease;
  }
  .watch-stat-pill:hover {
    background: var(--bg-hover);
    color: var(--text-main);
  }
  .watch-stat-pill.is-active {
    border-color: var(--blue);
    background: var(--blue-bg);
    color: var(--blue-fg);
  }
  .watch-stat-pill.danger { background: var(--danger-bg); color: var(--danger-fg); border-color: var(--danger-border); }
  .watch-stat-pill.blue { background: var(--blue-bg); color: var(--blue-fg); border-color: var(--blue-border); }
  .watch-stat-pill.gray { background: var(--bg-sub); color: var(--text-muted); border-color: var(--border); }

  .watch-toggle-btn {
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .watch-toggle-btn:hover {
    background: var(--bg-hover);
    color: var(--text-main);
  }

  .watch-hit-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 10px;
    padding: 8px 12px;
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .watch-group {
    margin-top: 10px;
  }
  .watch-group-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .watch-chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .watch-chips-scrollable {
    max-height: 120px;
    overflow-y: auto;
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 10px;
    box-sizing: border-box;
  }
  .watch-chip {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 12px;
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
    color: var(--text-main);
  }
  .watch-chip:hover {
    background: var(--bg-hover);
    border-color: var(--border-strong);
  }
  .watch-summary-chip.is-alert,
  .watch-chip.alert {
    background: var(--danger-bg);
    color: var(--danger-fg);
    border-color: var(--danger-border);
    font-weight: 700;
  }
  .watch-summary-chip.is-amber,
  .watch-chip.amber {
    background: var(--amber-bg);
    color: var(--amber-fg);
    border-color: var(--amber-border);
    font-weight: 700;
  }
  .watch-summary-chip.is-candidate,
  .watch-chip.blue {
    background: var(--blue-bg);
    color: var(--blue-fg);
    border-color: var(--blue-border);
    font-weight: 700;
  }
  button.watch-summary-chip.is-alert { color: var(--danger-fg) !important; }
  button.watch-summary-chip.is-amber { color: var(--amber) !important; }
  button.watch-summary-chip.is-candidate { color: var(--blue) !important; }
  .candidate-detail-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 27px;
    padding: 4px 9px;
    border: 1px solid var(--blue-border);
    border-radius: 6px;
    background: var(--blue-bg);
    color: var(--blue-fg);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }
  .candidate-detail-toggle:hover { background: var(--blue); border-color: var(--blue); color: #fff; }
  .candidate-detail-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .candidate-detail-unavailable { color: var(--text-light); font-size: 11px; white-space: nowrap; }
  .candidate-detail-row > td { padding: 0 !important; background: var(--bg-sub); }
  .candidate-detail-panel {
    padding: 14px;
    border-top: 1px dashed var(--blue-border);
    background: linear-gradient(180deg, var(--blue-bg), var(--bg-sub) 42%);
  }
  .candidate-detail-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .candidate-detail-title { margin: 0; font-size: 13px; font-weight: 800; color: var(--text-main); }
  .candidate-detail-meta { font-size: 11px; color: var(--text-muted); white-space: nowrap; }
  .candidate-detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; }
  .candidate-detail-card { min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-card); }
  .candidate-detail-card.is-wide { grid-column: 1 / -1; }
  .candidate-detail-card h5 { margin: 0; padding: 8px 10px; border-bottom: 1px solid var(--border); background: var(--bg-sub); color: var(--text-main); font-size: 11.5px; }
  .candidate-detail-table { width: 100%; border-collapse: collapse; font-size: 11px; font-family: var(--font-mono); }
  .candidate-detail-table th, .candidate-detail-table td { padding: 5px 7px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .candidate-detail-table th { color: var(--text-muted); font-weight: 700; background: var(--bg-card); }
  .candidate-detail-table th:first-child, .candidate-detail-table td:first-child { text-align: left; font-family: var(--font-sans); }
  .candidate-detail-table tr:last-child td { border-bottom: 0; }
  .candidate-stock-row { cursor: pointer; }
  .candidate-stock-row:hover td { background: var(--blue-bg); }
  .candidate-stock-row .stock-chart-link { position: relative; z-index: 1; }
  @media (max-width: 768px) {
    .candidate-detail-grid { grid-template-columns: 1fr; }
    .candidate-detail-card.is-wide { grid-column: auto; }
    .candidate-detail-row > td::before { content: none; }
    .candidate-detail-row > td { display: block; }
    .candidate-detail-panel { padding: 10px; }
    .candidate-detail-card { overflow-x: auto; }
  }
  .wc-code { font-weight: 700; }
  .wc-name { font-weight: 600; }
  .wc-del {
    color: var(--text-light);
    font-size: 11px;
    font-weight: 700;
    margin-left: 2px;
    cursor: pointer;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .wc-del:hover {
    color: var(--rise);
    background: rgba(225, 29, 72, 0.1);
  }


  /* EXECUTIVE BRIEFING MODE (盤前 3 分鐘速讀模式) */
  body.briefing-mode .nav-btn.btn-briefing {
    background: var(--blue) !important;
    color: #FFFFFF !important;
    border-color: var(--blue) !important;
  }
  body.briefing-mode #market-context,
  body.briefing-mode #system-info,
  body.briefing-mode .card.news-card,
  body.briefing-mode .cal-date-section:not(.is-today-section),
  body.briefing-mode .cal-event-card:not([data-importance="3"]),
  body.briefing-mode .unref-card,
  body.briefing-mode .watch-chips-scrollable,
  body.briefing-mode .watch-group:has(.watch-chips-scrollable) {
    display: none !important;
  }

  /* EXECUTIVE BRIEFING MODE (盤前 3 分鐘速讀模式) */
  .briefing-banner {
    display: none;
    background: var(--blue-bg);
    color: var(--blue-fg);
    border: 1px solid var(--blue-border);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 14px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  body.briefing-mode .briefing-banner {
    display: flex;
  }
  .clickable-stock-code {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }
  .clickable-stock-code:hover {
    color: var(--blue) !important;
  }

  /* 3-Section Batch Parser Preview */
  .batch-preview-box {
    margin-top: 12px;
    background: var(--bg-sub);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .batch-preview-sec {
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  .batch-preview-sec:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .batch-sec-head {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .batch-chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    max-height: 120px;
    overflow-y: auto;
  }
  .batch-chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 11.5px;
    font-family: var(--font-mono);
  }
  .batch-chip.is-valid {
    background: var(--success-bg);
    color: var(--success-fg);
    border: 1px solid var(--success-border);
    font-weight: 700;
  }
  .batch-chip.is-dup {
    background: var(--blue-bg);
    color: var(--blue-fg);
    border: 1px solid var(--blue-border);
  }
  .batch-chip.is-invalid {
    background: var(--warning-bg);
    color: var(--warning-fg);
    border: 1px solid var(--warning-border);
    font-size: 11px;
  }

  /* Calendar Filter Summary */
  .cal-filter-summary {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cal-filter-summary strong {
    color: var(--blue);
  }

  /* ACCESSIBILITY: REDUCED MOTION */
  @media (prefers-reduced-motion: reduce) {
    *, ::before, ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
</head>
<body>

  <!-- HEADER -->
  <header class="page-header">
    <div class="header-inner">
      <div class="header-main">
        <h1 class="page-title">盤前情報準備台</h1>
      </div>
      <div class="meta-row">
        <span class="meta-item">
          <span class="meta-icon">📅</span>
          <span class="meta-label">資料日期</span>
          <span class="meta-val font-mono font-bold">{{ data_date }}</span>
        </span>
        <span class="meta-item health-item" id="source-health-indicator">
          {% set h = health if (health is defined and health) else (meta.health if (meta is defined and meta and meta.health is defined) else {}) %}
          {% set o_status = h.overall_status or (meta.overall_status if meta is defined and meta else 'caution') %}
          {% set o_label = h.status_label or (meta.status_label if meta is defined and meta else '請先確認資料') %}
          {% set o_badge = h.status_badge_class or (meta.status_badge_class if meta is defined and meta else 'is-caution') %}
          {% set o_reasons = (h.summary_reasons if (h.summary_reasons is defined and h.summary_reasons) else (meta.summary_reasons if (meta is defined and meta and meta.summary_reasons) else [])) or [] %}
          <button type="button" class="header-status-btn {{ o_badge }}" id="source-status-btn" onclick="window.pm.openSourceStatusModal(this)" title="【{{ o_label }}】{{ o_reasons|join('；') }} · 點擊查看完整來源健康度清單" aria-label="開啟資料來源狀態清單">
            <span class="status-dot"></span><span class="status-text">{{ o_label }}</span>
          </button>
        </span>
      </div>
    </div>
  </header>

  <!-- NAV (Sticky Anchor & Tool Bar - ZERO HORIZONTAL SCROLL) -->
  <nav class="page-nav" id="sticky-nav">
    <div class="nav-inner">
      <div class="nav-sections">
        <a href="#summary" class="nav-link is-active">今日摘要</a>
        <a href="#self-watchlist" class="nav-link">我在看</a>
        {% set exiting_today = disposal.currently_in_disposal | rejectattr('trading_days_left', 'none') | selectattr('trading_days_left', 'in', ['0', '0天', 0, '出關']) | list %}
        {% set hidden_disposal = disposal.currently_in_disposal | selectattr('trading_days_left', 'none') | list %}
        {% set alert_total = (disposal.one_flag_from_disposal|length) + (exiting_today|length) %}
        {% set disposal_source = (health.sources | selectattr('source_id', 'equalto', 'disposal') | list | first) if health is defined and health.sources is defined else none %}
        {% set disposal_is_stale = disposal_source and (disposal_source.freshness in ['stale', 'expired'] or disposal_source.status in ['failed', 'missing']) %}
        <a href="#watchlist" class="nav-link">籌碼股</a>
        <a href="#alerts" class="nav-link nav-alert tab-pill" data-count="{{ alert_total }}">處置股 {% if alert_total > 0 %}<span class="nav-badge" id="nav-alert-badge">{{ alert_total }}</span>{% endif %}{% if disposal_is_stale %}<span class="nav-badge" style="background:var(--amber); color:#FFF; margin-left:4px;">⚠️ 資料過期</span>{% endif %}</a>
        <a href="#market-context" class="nav-link">市場背景</a>
        <a href="#news-calendar" class="nav-link">補充資訊</a>
        <a href="#system-info" class="nav-link">系統</a>
      </div>

      <details class="nav-utility-panel" id="nav-utility-panel">
        <summary title="展開工具與資料狀態">
          <span>⚙️ 工具與資料狀態</span>
          <span class="nav-utility-state">{{ o_label }}</span>
        </summary>
        <div class="nav-utility-content">
          <div class="utility-panel-header">
            <div>
              <div class="utility-panel-eyebrow">QUICK CONTROLS</div>
              <div class="utility-panel-title">常用工具</div>
            </div>
          </div>
          <div class="utility-panel-section">
            <div class="utility-section-label">快速操作</div>
            <div class="nav-actions">
        <button class="nav-btn theme-toggle" onclick="window.toggleTheme()" id="theme-toggle" type="button" title="切換深淺色主題 (快捷鍵 D)" aria-keyshortcuts="D">🌙 深色</button>
        <button class="nav-btn manual-update-btn" id="manual-update-button" type="button" title="安全啟動資料更新" aria-label="手動更新資料">🔄 手動更新資料</button>
        <button class="nav-btn refresh-btn" onclick="location.reload()" type="button" title="重新載入最新版" aria-label="重新整理頁面">
          🔄 重新整理
        </button>
            </div>
          </div>
          <div class="utility-panel-section">
            <div class="utility-section-label">資料狀態</div>
            <details class="today-briefing-details" id="today-briefing-details">
        <summary class="today-briefing-summary">
          <span class="briefing-summary-title">📊 資料可用性</span>
          <span class="briefing-summary-status">{{ o_label }}</span>
        </summary>
      <div class="today-briefing-card {{ 'is-unsafe-alert' if o_status == 'unsafe' else ('is-caution-alert' if o_status == 'caution' else 'is-ready-card') }}" id="today-briefing-block">
        <div class="briefing-col col-status">
          <div class="briefing-col-lbl">📊 資料可用性</div>
          <div class="briefing-status-val">
            <span class="status-badge {{ o_badge }}" style="font-weight:700;">{{ o_label }}</span>
            <span class="briefing-reason-summary" title="{{ o_reasons|join('；') }}">{{ o_reasons[0] if o_reasons else '全數來源正常且在時限內' }}</span>
            <span id="briefing-built-relative" class="briefing-built-relative" aria-live="polite"></span>
          </div>
        </div>

        <div class="briefing-col col-watchlist">
          <div class="briefing-col-lbl">⭐ 自選股優先項目</div>
          <div class="briefing-watch-val font-mono" id="briefing-watchlist-val">
            載入中...
          </div>
        </div>

        <div class="briefing-col col-events">
          <div class="briefing-col-lbl">⏰ 今日高影響事件</div>
          <div class="briefing-events-val">
            {% set today_stars = [] %}
            {% for group in calendar.date_groups if group.is_today %}
              {% for ev in group.events if ev.importance == 3 %}
                {% set _ = today_stars.append(ev) %}
              {% endfor %}
            {% endfor %}
            {% if today_stars|length > 0 %}
              <span class="event-pill font-mono">★★★ {{ today_stars[0].time_tpe_str }} {{ today_stars[0].title }}</span>
              {% if today_stars|length > 1 %}
              <span class="event-more-tag">+{{ today_stars|length - 1 }}件</span>
              {% endif %}
            {% else %}
              <span id="briefing-no-high-impact" style="color:var(--text-muted); font-size:12px;">今日無 ★★★ 重要總經事件</span>
            {% endif %}
          </div>
        </div>
      </div>
            </details>
          </div>
        </div>
      </details>
    </div>
  </nav>

  <main class="page-main">

    <!-- Executive Briefing Mode Active Banner -->
    <div class="briefing-banner" id="briefing-banner">
      <span>⚡ 目前為盤前 3 分鐘速讀模式 · 已精簡市場背景、完整新聞與詳細嵌入資料</span>
      <button type="button" onclick="window.pm.toggleBriefingMode()" style="background:transparent; border:1px solid currentColor; color:inherit; border-radius:4px; padding:2px 8px; font-size:11.5px; cursor:pointer; font-weight:700;">結束速讀</button>
    </div>

    <!-- Stale Banner -->
    <div class="stale-banner" data-hours="{{ ((meta.stale_hours if meta is defined and meta.stale_hours is defined else stale_hours) or 0)|int }}">
      資料時間 {{ (meta.data_date if meta is defined and meta.data_date else None) or data_date or '今日' }}，距今 {{ (meta.stale_hours if meta is defined and meta.stale_hours is defined else stale_hours) or 0 }} 小時
    </div>

    <!-- 1. 摘要 (Summary) -->
    <section id="summary" class="content-section">
      <span id="summary-briefing-anchor" aria-hidden="true"></span>
      <script>
        // Keep market context at the start of the summary after low-frequency
        // tools and data availability move into the utility disclosure.
        (function () {
          var moveMarketContext = function () {
            var availability = document.getElementById('summary-briefing-anchor');
            var marketContext = document.getElementById('market-context');
            if (availability && marketContext && availability.nextElementSibling !== marketContext) {
              availability.insertAdjacentElement('afterend', marketContext);
            }
          };
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', moveMarketContext, { once: true });
          } else {
            moveMarketContext();
          }
        })();
      </script>
      {% set unref_count = (financials.att|length if financials.att else 0) + (financials.fin|length if financials.fin else 0) + (financials.rev|length if financials.rev else 0) %}
      {% macro render_market_summary_cards(twse, financials, night, unref_count) %}
      <div class="summary-grid market-summary-grid">
        <!-- 昨收大盤 -->
        <div class="summary-card">
          <div class="card-label">加權指數 昨收</div>
          {% if twse and twse.twii %}
          <div class="card-val font-mono {% if twse.twii.change > 0 %}rise{% elif twse.twii.change < 0 %}fall{% endif %}" data-metric="twii-close">
            {{ "{:,.2f}".format(twse.twii.price) }}
          </div>
          <div class="card-sub font-mono {% if twse.twii.change > 0 %}rise{% elif twse.twii.change < 0 %}fall{% endif %}" data-metric="twii-change">
            {% if twse.twii.change > 0 %}+{% endif %}{{ twse.twii.change }} ({{ '%+.2f'|format(twse.twii.change_pct) }}%)
          </div>
          {% else %}
          <div class="card-val font-mono" data-metric="twii-close">—</div>
          {% endif %}
        </div>

        <!-- 三大法人買賣超 (外資 / 投信 / 自營商) -->
        <div class="summary-card">
          <div class="card-label">三大法人買賣超</div>
          <div class="inst-chips font-mono" data-metric="institutional-chips">
            {% if twse and twse.inst %}
              {% if twse.inst.foreign is not none %}
              <div class="chip"><span class="chip-label">外資</span> <span class="{% if twse.inst.foreign > 0 %}rise{% elif twse.inst.foreign < 0 %}fall{% endif %}">{% if twse.inst.foreign > 0 %}+{% endif %}{{ twse.inst.foreign }}億</span></div>
              {% endif %}
              {% if twse.inst.trust is not none %}
              <div class="chip"><span class="chip-label">投信</span> <span class="{% if twse.inst.trust > 0 %}rise{% elif twse.inst.trust < 0 %}fall{% endif %}">{% if twse.inst.trust > 0 %}+{% endif %}{{ twse.inst.trust }}億</span></div>
              {% endif %}
              {% if twse.inst.dealer is not none %}
              <div class="chip"><span class="chip-label">自營商</span> <span class="{% if twse.inst.dealer > 0 %}rise{% elif twse.inst.dealer < 0 %}fall{% endif %}">{% if twse.inst.dealer > 0 %}+{% endif %}{{ twse.inst.dealer }}億</span></div>
              {% endif %}
            {% endif %}
          </div>
          <div class="inst-chips-mobile font-mono">
            {% if twse and twse.inst %}
            外資 <span class="{% if twse.inst.foreign > 0 %}rise{% else %}fall{% endif %}">{% if twse.inst.foreign > 0 %}+{% endif %}{{ twse.inst.foreign|round(0)|int }}</span> · 投信 <span class="{% if twse.inst.trust > 0 %}rise{% else %}fall{% endif %}">{% if twse.inst.trust > 0 %}+{% endif %}{{ twse.inst.trust|round(0)|int }}</span> · 自營 <span class="{% if twse.inst.dealer > 0 %}rise{% else %}fall{% endif %}">{% if twse.inst.dealer > 0 %}+{% endif %}{{ twse.inst.dealer|round(0)|int }}</span>
            {% endif %}
          </div>
        </div>

        <!-- 市場未反映公告 -->
        <div class="summary-card {% if unref_count > 0 %}alert-highlight{% endif %}">
          <div class="card-label">市場未反映公告</div>
          <div class="card-val font-mono {% if unref_count > 0 %}rise{% endif %}" data-metric="unreflected-count">
            {{ unref_count }} <span class="unit" style="font-size:14px; font-weight:normal;">筆</span>
          </div>
          <div class="card-sub">{{ financials.cutoff_str or '昨日 13:30' }} 後公告</div>
        </div>

        <!-- 台指期夜盤 -->
        {% if night and night.latest %}
        <a class="summary-card" href="https://www.cmoney.tw/forum/futures/TXF1?s=p" target="_blank" rel="noopener noreferrer" aria-label="開啟 CMoney 台指期主連續期貨頁面" style="color:inherit; text-decoration:none; cursor:pointer;">
          <div class="card-label">台指期夜盤 (05:00){% if night and night.latest and (night.latest.provider_name or night.provider_name) %} · 來源：{{ night.latest.provider_name or night.provider_name }}{% endif %}</div>
          {% if night.latest.is_fallback %}
          <div class="card-sub amber font-bold" style="font-size:10px; margin-bottom:2px;">⚠️ 抓取失敗，使用最近一次 fixtures/{{ night.date }}</div>
          {% endif %}
          <div class="card-val font-mono {% if night.latest.change > 0 %}rise{% elif night.latest.change < 0 %}fall{% endif %}">
            {{ "{:,.0f}".format(night.latest.price) if night.latest.price is not none else '—' }}
          </div>
          <div class="card-sub font-mono {% if night.latest.change > 0 %}rise{% elif night.latest.change < 0 %}fall{% endif %}">
            {% if night.latest.change is not none %}{% if night.latest.change > 0 %}+{% endif %}{{ night.latest.change }} ({{ '%+.2f'|format(night.latest.change_pct) }}%){% endif %}
          </div>
          <div class="benchmark-note font-mono" style="font-size:11px; color:var(--text-muted); margin-top:2px;">
            基準：vs 期貨日盤收盤 (45,138)
          </div>
        </a>
        {% endif %}

      </div>
      {% endmacro %}
    </section>

    <!-- Self Watchlist -->
    <section id="self-watchlist" class="content-section">
      <details class="card watchlist-card watchlist-details">
        <summary class="card-head watchlist-summary">
          <div class="card-title-group">
            <h2 class="card-title"><span class="title-icon">⭐</span> 我在看</h2>
            <span class="count-badge" id="watch-total-badge" style="display:none;">0 檔</span>
          </div>
          <div class="watch-summary-hits" id="watch-summary-hits" aria-live="polite"></div>
          <span class="watch-summary-info" role="note" tabindex="0" title="即時比對今日處置、出關與候選清單 · 本機自動儲存" aria-label="即時比對今日處置、出關與候選清單；本機自動儲存">ⓘ</span>
        </summary>

        <div class="card-body" style="padding: 12px 14px;">
          <div class="watch-main-bar" id="watch-main-bar">
            <div class="watch-stat-left" id="watch-filter-pills"></div>
            <div class="watch-actions-group">
              <button class="watch-btn-modern primary" id="watch-edit-toggle-btn" onclick="window.pm.toggleWatchEdit()" type="button" title="展開 / 收合代號編輯輸入框">
                ✏️ 編輯清單
              </button>
              <button class="watch-btn-modern" onclick="window.pm.openBatchModal()" type="button" title="開啟 Excel / CSV 批次匯入與 JSON 備份視窗">
                📋 批次匯入 / 備份
              </button>
              <button class="watch-btn-modern danger-hover" onclick="window.clearWatch()" type="button" title="清空全部自選股">
                🗑️ 清空
              </button>
            </div>
          </div>

          <div class="watch-input-wrapper" id="watch-input-container" style="display: none; margin-top: 8px;">
            <span class="watch-input-icon">🔍</span>
            <input id="watch-input" class="watch-input-modern" placeholder="輸入台股代號（如 2330, 2454）或直接貼上 Excel 欄位..." autocomplete="off" aria-label="輸入自選股代號">
            <button class="watch-btn-inline primary" onclick="window.saveWatch()" type="button" title="儲存清單">💾 儲存</button>
          </div>

          <div id="watch-chips" class="watch-chips"></div>
          <div class="watch-hint" id="watch-hint"></div>
        </div>
      </details>
    </section>

    {% macro candidate_detail_panel(detail, code) -%}
      {%- if detail -%}
      <tr class="candidate-detail-row" id="candidate-detail-{{ code }}" hidden>
        <td colspan="8">
          <div class="candidate-detail-panel">
            <div class="candidate-detail-head">
              <h4 class="candidate-detail-title">{{ detail.code }} {{ detail.name }}</h4>
              <span class="candidate-detail-meta">資料日 {{ institutional.page_date or '—' }} · <a href="https://chengwaye.com/daily" target="_blank" rel="noopener noreferrer">Chengwaye ↗</a></span>
            </div>
            <div class="candidate-detail-grid">
              <div class="candidate-detail-card">
                <h5>法人買賣 · 買超 Top15</h5>
                <table class="candidate-detail-table"><thead><tr><th>券商</th><th>淨額(張)</th><th>買張</th><th>買均價</th><th>賣張</th><th>賣均價</th></tr></thead><tbody>
                {% for item in detail.buyers %}<tr><td>{{ item.name }}</td><td class="{{ 'rise' if item.net and item.net[0] == '+' else 'fall' }}">{{ item.net }}</td><td>{{ item.buyV }}</td><td>{{ item.buyP }}</td><td>{{ item.sellV }}</td><td>{{ item.sellP }}</td></tr>{% endfor %}
                </tbody></table>
              </div>
              <div class="candidate-detail-card">
                <h5>法人買賣 · 賣超 Top15</h5>
                <table class="candidate-detail-table"><thead><tr><th>券商</th><th>淨額(張)</th><th>買張</th><th>買均價</th><th>賣張</th><th>賣均價</th></tr></thead><tbody>
                {% for item in detail.sellers %}<tr><td>{{ item.name }}</td><td class="{{ 'rise' if item.net and item.net[0] == '+' else 'fall' }}">{{ item.net }}</td><td>{{ item.buyV }}</td><td>{{ item.buyP }}</td><td>{{ item.sellV }}</td><td>{{ item.sellP }}</td></tr>{% endfor %}
                </tbody></table>
              </div>
              <div class="candidate-detail-card is-wide">
                <h5>當沖 Top10</h5>
                <table class="candidate-detail-table"><thead><tr><th>券商</th><th>交易張數</th><th>買張</th><th>買均價</th><th>賣張</th><th>賣均價</th></tr></thead><tbody>
                {% for item in detail.daytraders %}<tr><td>{{ item.name }}</td><td>{{ item.total }}</td><td>{{ item.buyV }}</td><td>{{ item.buyP }}</td><td>{{ item.sellV }}</td><td>{{ item.sellP }}</td></tr>{% endfor %}
                </tbody></table>
              </div>
            </div>
          </div>
        </td>
      </tr>
      {%- endif -%}
    {%- endmacro %}

    <!-- 2. 籌碼股 (Watchlist) -->
    <section id="watchlist" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">🎯</span> 籌碼股</h2>
        <span class="section-desc">盤前族群整理、法人動向與主力當沖籌碼明細</span>
      </div>

      {% if pressplay._status == 'fetch_failed' %}
      <div class="part3-error">
        <strong>Part 3（PressPlay 摘要）收集失敗。</strong>
        請到 GitHub <code>Actions → build-premarket-page</code> 查看 Logs；其他章節照常運作，不受影響。
      </div>
      {% elif (pressplay.not_found_group.matched|length == 0 and pressplay.found_group.matched|length == 0) and (pressplay.not_found_group.unmatched|length == 0 and pressplay.found_group.unmatched|length == 0) %}
      <div class="part3-empty">尚無資料（PressPlay 收集流程跑過，但今天沒有盤前文章）。</div>
      {% else %}

      <!-- 族群聚焦標的 -->
      {% if pressplay.found_group.matched and pressplay.found_group.matched|length > 0 %}
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">族群聚焦標的</h3>
            <span class="count-badge">{{ pressplay.found_group.matched|length }} 檔</span>
          </div>
          <span class="card-tip">已比對 {{ pressplay.found_group.raw_tokens|length }} 檔，共 {{ pressplay.found_group.matched|length }} 檔具明確族群連動</span>
        </div>
        <div class="data-block">
          <div class="table-scroll">
            <table class="data-table">
              <caption class="sr-only">族群聚焦標的清單</caption>
              <thead>
                <tr>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="0">市場 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="1">代號 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="2">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="3">收盤 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="4">量(張) <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="5">外資(張) <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="6">投信(張) <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="7">自營(張) <span class="sort-arrow">▲▼</span></th>
                </tr>
              </thead>
              <tbody>
                {% for row in pressplay.found_group.matched %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                {% set detail = institutional.stocks_by_code.get(clean_code) if institutional else none %}
                <tr class="candidate-stock-row" data-code="{{ clean_code }}" data-cat="normal" data-label="{{ row.name }}"{% if detail %} data-detail-id="candidate-detail-{{ clean_code }}" aria-controls="candidate-detail-{{ clean_code }}" aria-expanded="false"{% endif %}>
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono"><a href="https://tw.tradingview.com/chart/?symbol={{ 'TPEX' if ('櫃' in row.market or 'OTC' in row.market or 'TPEX' in row.market) else 'TWSE' }}:{{ clean_code }}" target="_blank" rel="noopener noreferrer" class="clickable-stock-code stock-chart-link" title="前往 TradingView 即時看盤">{{ clean_code }}</a></td>
                  <td data-label="名稱" class="name font-bold">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">模糊比對</span>{% endif %}</td>
                  <td data-label="收盤" class="num font-mono" data-sort="{{ row.close }}">{{ row.close }}</td>
                  <td data-label="量(張)" class="num font-mono" data-sort="{{ row.volume }}">{{ row.volume }}</td>
                  <td data-label="外資(張)" class="num font-mono {% if row.foreign and '+' in row.foreign %}rise{% elif row.foreign and '-' in row.foreign %}fall{% endif %}" data-sort="{{ row.foreign }}">{{ row.foreign }}</td>
                  <td data-label="投信(張)" class="num font-mono {% if row.trust and '+' in row.trust %}rise{% elif row.trust and '-' in row.trust %}fall{% endif %}" data-sort="{{ row.trust }}">{{ row.trust }}</td>
                  <td data-label="自營(張)" class="num font-mono {% if row.dealer and '+' in row.dealer %}rise{% elif row.dealer and '-' in row.dealer %}fall{% endif %}" data-sort="{{ row.dealer }}">{{ row.dealer }}</td>
                </tr>
                {{ candidate_detail_panel(detail, clean_code) }}
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      {% else %}
      <details class="unref-accordion" style="margin-bottom:12px;">
        <summary class="unref-summary">
          <span>🎯 族群聚焦標的（今日無共同聚焦族群標的；下方列出 {{ pressplay.not_found_group.matched|length if (pressplay.not_found_group and pressplay.not_found_group.matched) else 0 }} 檔個別動能標的）</span>
          <span class="badge">0 檔</span>
        </summary>
        <div class="unref-content" style="padding:14px; text-align:center; color:var(--text-muted); font-size:12.5px;">
          今日盤前專欄未歸納出共同聚焦族群標的；請參考下方個別動能標的。
        </div>
      </details>
      {% endif %}

      <!-- 無明確族群標的 -->
      {% if pressplay.not_found_group.matched and pressplay.not_found_group.matched|length > 0 %}
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">無明確族群標的</h3>
            <span class="count-badge">{{ pressplay.not_found_group.matched|length }} 檔</span>
          </div>
          <span class="card-tip">獨立題材或個股動能</span>
        </div>

        <div class="data-block">
          <div class="table-scroll">
            <table class="data-table">
              <caption class="sr-only">無明確族群標的清單</caption>
              <thead>
                <tr>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="0">市場 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="1">代號 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="2">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="3">收盤 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="4">量(張) <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="5">外資(張) <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="6">投信(張) <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="7">自營(張) <span class="sort-arrow">▲▼</span></th>
                </tr>
              </thead>
              <tbody>
                {% for row in pressplay.not_found_group.matched %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                {% set detail = institutional.stocks_by_code.get(clean_code) if institutional else none %}
                <tr class="candidate-stock-row" data-code="{{ clean_code }}" data-cat="normal" data-label="{{ row.name }}"{% if detail %} data-detail-id="candidate-detail-{{ clean_code }}" aria-controls="candidate-detail-{{ clean_code }}" aria-expanded="false"{% endif %}>
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono"><a href="https://tw.tradingview.com/chart/?symbol={{ 'TPEX' if ('櫃' in row.market or 'OTC' in row.market or 'TPEX' in row.market) else 'TWSE' }}:{{ clean_code }}" target="_blank" rel="noopener noreferrer" class="clickable-stock-code stock-chart-link" title="前往 TradingView 即時看盤">{{ clean_code }}</a></td>
                  <td data-label="名稱" class="name font-bold">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">模糊比對</span>{% endif %}</td>
                  <td data-label="收盤" class="num font-mono" data-sort="{{ row.close }}">{{ row.close }}</td>
                  <td data-label="量(張)" class="num font-mono" data-sort="{{ row.volume }}">{{ row.volume }}</td>
                  <td data-label="外資(張)" class="num font-mono {% if row.foreign and '+' in row.foreign %}rise{% elif row.foreign and '-' in row.foreign %}fall{% endif %}" data-sort="{{ row.foreign }}">{{ row.foreign }}</td>
                  <td data-label="投信(張)" class="num font-mono {% if row.trust and '+' in row.trust %}rise{% elif row.trust and '-' in row.trust %}fall{% endif %}" data-sort="{{ row.trust }}">{{ row.trust }}</td>
                  <td data-label="自營(張)" class="num font-mono {% if row.dealer and '+' in row.dealer %}rise{% elif row.dealer and '-' in row.dealer %}fall{% endif %}" data-sort="{{ row.dealer }}">{{ row.dealer }}</td>
                </tr>
                {{ candidate_detail_panel(detail, clean_code) }}
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      {% else %}
      <details class="unref-accordion" style="margin-bottom:12px;">
        <summary class="unref-summary">
          <span>⚡ 無明確族群標的 · 今日無獨立題材標的</span>
          <span class="badge">0 檔</span>
        </summary>
        <div class="unref-content" style="padding:14px; text-align:center; color:var(--text-muted); font-size:12.5px;">
          今日無獨立題材標的
        </div>
      </details>
      {% endif %}
      {% endif %}

    </section>

    <!-- 3. 處置股 (Alerts) -->
    <section id="alerts" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">⚠️</span> 處置股</h2>
        <span class="section-desc">處置股預警、今日出關與盤後重大財務自結</span>
      </div>

      <!-- 差 1 次即處置 -->
      <div class="card alert-card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">差 1 次就處置</h3>
            <span class="count-badge danger">{{ disposal.one_flag_from_disposal|length }} 檔</span>
          </div>
          <span class="card-tip">今天若再達標就會進處置</span>
        </div>

        <div class="data-block">
          {% if disposal.one_flag_from_disposal %}
          <div class="table-scroll">
            <table class="data-table disposal-table">
              <caption class="sr-only">差 1 次就處置股票清單</caption>
              <thead>
                <tr>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="0">市場 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="1">代號 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="2">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="3">收盤 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col">處置標準條件</th>
                  <th scope="col" class="num" role="button" tabindex="0" aria-sort="none" data-sort-col="5">最快處置 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" class="badge-col" title="連續3日第1款">3①</th>
                  <th scope="col" class="badge-col" title="連續5日（第1~7款）">5</th>
                  <th scope="col" class="badge-col" title="10日內6次（第1~7款）">6</th>
                  <th scope="col" class="badge-col" title="30日內12次（第1~7款）">12</th>
                </tr>
              </thead>
              <tbody>
                {% for row in disposal.one_flag_from_disposal %}
                {% set is_paused = ('⏸' in row.code) %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                <tr data-code="{{ clean_code }}" data-cat="alert" data-label="{{ row.name }}" class="{{ 'row-paused' if is_paused else '' }}">
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono"><a href="https://tw.tradingview.com/chart/?symbol={{ 'TPEX' if ('櫃' in row.market or 'OTC' in row.market or 'TPEX' in row.market) else 'TWSE' }}:{{ clean_code }}" target="_blank" rel="noopener noreferrer" class="clickable-stock-code stock-chart-link" title="前往 TradingView 即時看盤">{{ clean_code }}</a></td>
                  <td data-label="名稱" class="name font-bold"><span class="watchlist-star-marker" data-code="{{ clean_code }}" style="display:none;">★</span>{{ row.name }}</td>
                  <td data-label="收盤" class="num font-mono" data-sort="{{ row.close }}">{{ row.close }}</td>
                  <td data-label="處置條件" class="condition">
                    <div class="cond-box">
                      {% if row.condition_segments %}
                        {% if row.condition_segments|length > 2 %}
                        <div class="cond-collapsible">
                          <div class="cond-pills" style="display:flex; flex-wrap:wrap; gap:4px;">
                            {% for seg in row.condition_segments[:2] %}
                            <span class="cond-pill font-mono"{% if seg.color %} style="color:{{ seg.color }}{{ ';font-weight:700' if seg.bold else '' }}"{% endif %}>{{ seg.text }}</span>
                            {% endfor %}
                          </div>
                          <div class="cond-hidden">
                            {% for seg in row.condition_segments[2:] %}
                            <span class="cond-pill font-mono"{% if seg.color %} style="color:{{ seg.color }}{{ ';font-weight:700' if seg.bold else '' }}"{% endif %}>{{ seg.text }}</span>
                            {% endfor %}
                          </div>
                          <button type="button" class="cond-toggle-btn font-mono" onclick="this.closest('.cond-collapsible').classList.toggle('is-expanded')" aria-label="展開其他條件">符合（+{{ row.condition_segments|length - 2 }} 條件）▾</button>
                        </div>
                        {% else %}
                        <div class="cond-row-2" style="display:flex; flex-wrap:wrap; gap:4px;">
                          {% for seg in row.condition_segments %}
                          <span class="cond-pill font-mono"{% if seg.color %} style="color:{{ seg.color }}{{ ';font-weight:700' if seg.bold else '' }}"{% endif %}>{{ seg.text }}</span>
                          {% endfor %}
                        </div>
                        {% endif %}
                      {% else %}
                      <span>{{ row.condition }}</span>
                      {% endif %}
                    </div>
                  </td>
                  <td data-label="最快處置" class="num" data-sort="{{ row.earliest_disposal }}">
                    <div class="ed-cell">
                      {% set ed_parts = row.earliest_disposal.split(' ', 1) %}
                      {% if ed_parts|length == 2 %}
                        <span class="ed-date">{{ ed_parts[0] }}</span>
                        {% set b_text = ed_parts[1] %}
                        {% set b_text = b_text.replace('第1次', '第1次 · ').replace('第2次', '第2次 · ').replace('··', '·').replace('·  ·', '·') %}
                        {% set is_20m = ('20分' in b_text or '25分' in b_text or '全額' in b_text) %}
                        {% set is_5m = ('5分' in b_text or '2分' in b_text) %}
                        <span class="ed-badge {{ 'badge-20m' if is_20m else ('badge-5m' if is_5m else '') }}" title="{{ '人工管制撮合（約20分撮合一盤，預收款券）' if is_20m else ('人工管制撮合（約5分撮合一盤）' if is_5m else '') }}">{{ b_text }}</span>
                      {% else %}
                        <span class="ed-date">{{ row.earliest_disposal }}</span>
                      {% endif %}
                    </div>
                  </td>
                  {% set badge_labels = ['3① 連3第1款', '5 連5第1~7款', '6 10日內6次', '12 30日內12次'] %}
                  {% for bd in row.badges or [{}, {}, {}, {}] %}
                  <td data-label="{{ badge_labels[loop.index0] }}" class="badge-col"{% if bd.title %} title="{{ bd.title }}"{% endif %}>
                    {% if bd.threshold %}
                    <div class="badge-dots" title="近 {{ bd.threshold }} 日累積觸發 {{ bd.current }} 次" aria-label="近 {{ bd.threshold }} 日累積觸發 {{ bd.current }} 次">
                      {% for i in range(bd.threshold) %}<span class="dot{{ ' filled' if i < bd.current else '' }}"></span>{% endfor %}
                      <span class="badge-frac font-mono">{{ bd.current }}/{{ bd.threshold }}</span>
                    </div>
                    <div class="mini-bar font-mono" style="--pct:{{ (bd.current / bd.threshold * 100)|round(1) }}%">{{ bd.current }}/{{ bd.threshold }}</div>
                    {% else %}
                    <span class="badge-frac">—</span>
                    {% endif %}
                  </td>
                  {% endfor %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <div class="empty-state">今日無差 1 次即處置的標的</div>
          {% endif %}
        </div>
      </div>

      <!-- 今日出關 -->
      <div class="card alert-card-amber">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">今日出關</h3>
            <span class="count-badge amber">{{ exiting_today|length }} 檔</span>
          </div>
          <span class="card-tip">處置期屆滿，今日恢復正常撮合</span>
        </div>

        <div class="data-block">
          {% if exiting_today %}
          <div class="table-scroll">
            <table class="data-table">
              <caption class="sr-only">今日出關股票清單</caption>
              <thead>
                <tr>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="0">市場 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="1">代號 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="2">名稱 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="3">原撮合 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="4">處置起訖 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col" role="button" tabindex="0" aria-sort="none" data-sort-col="5">預計出關 <span class="sort-arrow">▲▼</span></th>
                  <th scope="col">處置原因</th>
                </tr>
              </thead>
              <tbody>
                {% for row in exiting_today %}
                {% set clean_code = row.code.replace('⏸','').strip() %}
                <tr data-code="{{ clean_code }}" data-cat="amber" data-label="{{ row.name }}">
                  <td data-label="市場">{{ row.market }}</td>
                  <td data-label="代號" class="code font-mono"><a href="https://tw.tradingview.com/chart/?symbol={{ 'TPEX' if ('櫃' in row.market or 'OTC' in row.market or 'TPEX' in row.market) else 'TWSE' }}:{{ clean_code }}" target="_blank" rel="noopener noreferrer" class="clickable-stock-code stock-chart-link" title="前往 TradingView 即時看盤">{{ clean_code }}</a></td>
                  <td data-label="名稱" class="name font-bold"><span class="watchlist-star-marker" data-code="{{ clean_code }}" style="display:none;">★</span>{{ row.name }}</td>
                  <td data-label="原撮合">
                    {% set is_row_20m = ('20分' in row.matching or '25分' in row.matching or '全額' in row.matching) %}
                    {% set is_row_5m = ('5分' in row.matching or '2分' in row.matching) %}
                    <span class="badge {{ 'badge-danger' if is_row_20m else ('badge-amber' if is_row_5m else '') }}">{{ row.matching }}</span>
                  </td>
                  <td data-label="處置起訖" class="font-mono" data-sort="{{ row.start_date }}">{{ row.start_date }} ~ {{ row.end_date }}</td>
                  <td data-label="預計出關" class="font-mono font-bold amber" data-sort="{{ row.exit_date }}"><span class="badge badge-green" style="margin-right:4px;">🎉 今日出關</span>{{ row.exit_date }}</td>
                  <td data-label="處置原因" class="reason">{{ row.reason }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <div class="empty-state">今日無處置期滿出關的標的</div>
          {% endif %}
        </div>
      </div>
      {% if hidden_disposal|length > 0 %}
      <!-- 隱藏 {{ hidden_disposal|length }} 筆（資料缺欄位，請回報） -->
      {% endif %}

      {% macro render_announcements(financials, unref_count, build_version, generated_at) %}
      <!-- 市場未反映財務公告 (Iframes) -->
      {% set financial_source_status = financials.source_status or {} %}
      {% set att_state = (financial_source_status.get('att') or {}).get('state', 'fresh') %}
      {% set fin_state = (financial_source_status.get('fin') or {}).get('state', 'fresh') %}
      {% set rev_state = (financial_source_status.get('rev') or {}).get('state', 'fresh') %}
      <details class="card announcements-collapsible" open>
        <summary class="card-head" style="cursor:pointer; list-style:none;">
          <div class="card-title-group">
            <h3 class="card-title">即時公告明細</h3>
            <span class="count-badge">{{ unref_count }} 筆</span>
          </div>
        </summary>

        <div class="data-block" style="padding:0;">
          <details class="unref-accordion">
            <summary class="unref-summary">
              {% if att_state == 'fetch_failed' %}
              <span>即時自結（資料抓取失敗，無法確認市場未反映筆數）</span>
              <span class="badge badge-amber">抓取失敗</span>
              {% elif att_state == 'stale_cached' %}
              <span>即時自結（沿用前次 {{ financials.att|length if financials.att else 0 }} 筆）</span>
              <span class="badge badge-amber">沿用快取</span>
              {% else %}
              <span>即時自結（市場未反映 {{ financials.att|length if financials.att else 0 }} 筆）</span>
              <span class="badge badge-blue">{{ financials.att|length if financials.att else 0 }} 筆</span>
              {% endif %}
            </summary>
            <div class="unref-content">
              <div class="embed-frame-wrapper is-loading" id="wrapper-att">
                <iframe src="embed/att.html?v={{ build_version or (generated_at | replace(' ','_') | replace('/','') | replace(':','')) }}" id="embed-att" class="embed-frame unref-frame" onload="window.pm.onIframeLoad('att')" loading="lazy" referrerpolicy="no-referrer" style="min-height:120px; height:auto;" scrolling="no" title="市場未反映自結公告"></iframe>
                <div class="embed-fallback-notice" id="fallback-att" style="display:none;">
                  <span>⚠️ 嵌入資料載入逾時</span>
                  <button type="button" class="btn-retry" onclick="window.pm.retryEmbed('att')" aria-label="重新載入自結公告區塊">🔄 重新載入此區塊</button>
                </div>
              </div>
            </div>
          </details>

          <details class="unref-accordion">
            <summary class="unref-summary">
              {% if fin_state == 'fetch_failed' %}
              <span>即時季報（資料抓取失敗，無法確認市場未反映筆數）</span>
              <span class="badge badge-amber">抓取失敗</span>
              {% elif fin_state == 'stale_cached' %}
              <span>即時季報（沿用前次 {{ financials.fin|length if financials.fin else 0 }} 筆）</span>
              <span class="badge badge-amber">沿用快取</span>
              {% else %}
              <span>即時季報（市場未反映 {{ financials.fin|length if financials.fin else 0 }} 筆）</span>
              <span class="badge">{{ financials.fin|length if financials.fin else 0 }} 筆</span>
              {% endif %}
            </summary>
            <div class="unref-content">
              <div class="embed-frame-wrapper is-loading" id="wrapper-fin">
                <iframe src="embed/fin.html?v={{ build_version or (generated_at | replace(' ','_') | replace('/','') | replace(':','')) }}" id="embed-fin" class="embed-frame unref-frame" onload="window.pm.onIframeLoad('fin')" loading="lazy" referrerpolicy="no-referrer" style="min-height:120px; height:auto;" scrolling="no" title="市場未反映季報公告"></iframe>
                <div class="embed-fallback-notice" id="fallback-fin" style="display:none;">
                  <span>⚠️ 嵌入資料載入逾時</span>
                  <button type="button" class="btn-retry" onclick="window.pm.retryEmbed('fin')" aria-label="重新載入季報公告區塊">🔄 重新載入此區塊</button>
                </div>
              </div>
            </div>
          </details>

          <details class="unref-accordion">
            <summary class="unref-summary">
              {% if rev_state == 'fetch_failed' %}
              <span>即時營收（資料抓取失敗，無法確認市場未反映筆數）</span>
              <span class="badge badge-amber">抓取失敗</span>
              {% elif rev_state == 'stale_cached' %}
              <span>即時營收（沿用前次 {{ financials.rev|length if financials.rev else 0 }} 筆）</span>
              <span class="badge badge-amber">沿用快取</span>
              {% else %}
              <span>即時營收（市場未反映 {{ financials.rev|length if financials.rev else 0 }} 筆）</span>
              <span class="badge">{{ financials.rev|length if financials.rev else 0 }} 筆</span>
              {% endif %}
            </summary>
            <div class="unref-content">
              <div class="embed-frame-wrapper is-loading" id="wrapper-rev">
                <iframe src="embed/rev.html?v={{ build_version or (generated_at | replace(' ','_') | replace('/','') | replace(':','')) }}" id="embed-rev" class="embed-frame unref-frame" onload="window.pm.onIframeLoad('rev')" loading="lazy" referrerpolicy="no-referrer" style="min-height:120px; height:auto;" scrolling="no" title="市場未反映營收公告"></iframe>
                <div class="embed-fallback-notice" id="fallback-rev" style="display:none;">
                  <span>⚠️ 嵌入資料載入逾時</span>
                  <button type="button" class="btn-retry" onclick="window.pm.retryEmbed('rev')" aria-label="重新載入營收公告區塊">🔄 重新載入此區塊</button>
                </div>
              </div>
            </div>
          </details>
        </div>
      </details>
      {% endmacro %}
    </section>

    <!-- 4. 市場未反映公告 -->
    <section id="announcements" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">📣</span> 市場未反映公告</h2>
        <span class="section-desc">昨日 13:30 盤後即時重訊</span>
      </div>
      {{ render_announcements(financials, unref_count, build_version, generated_at) }}
    </section>

    <!-- 5. 市場背景 (Market Context) -->
    <section id="market-context" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">🌐</span> 市場背景</h2>
        <span class="section-desc">美股收盤、跨海連動 ADR 與亞股早盤概況</span>
      </div>

      <!-- 美股四大指數 & 跨海連動 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">美股四大指數與跨海連動標的</h3>
            <a class="cal-link-btn" href="https://tw.stock.yahoo.com/markets" target="_blank" rel="noopener noreferrer" title="開啟 Yahoo 股市市場頁">Yahoo 股市 ↗</a>
          </div>
          <span class="card-tip font-mono">美股 · 昨日收盤（美東 16:00）· 資料延遲 {{ hours_since_us_close if hours_since_us_close is defined else 18.9 }} 小時</span>
        </div>

        <div class="data-block">
          <!-- 美股四大指數 (Row 1) -->
          <div class="tiles-grid">
            {% for symbol, label in [('^GSPC', '標普 500'), ('^IXIC', '那斯達克'), ('^DJI', '道瓊工業'), ('^SOX', '費城半導體')] %}
            {% set q = us_indices[symbol] if (us_indices and symbol in us_indices) else indices.get(symbol) %}
            <div class="tile-card">
              <div class="tile-head">
                <span class="tile-name">{{ label }}</span>
                <span class="tile-delay-pill {{ 'pill-fresh' if (hours_since_us_close if hours_since_us_close is defined else 18.9) < 24 else ('pill-amber' if (hours_since_us_close if hours_since_us_close is defined else 18.9) <= 36 else 'pill-danger') }}">{{ hours_since_us_close if hours_since_us_close is defined else 18.9 }}h ago</span>
              </div>
              {% if q and q.price is not none %}
              <div class="tile-val font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{{ "{:,.2f}".format(q.price) }}</div>
              <div class="tile-chg font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{% if q.change > 0 %}+{% endif %}{{ q.change }} ({{ '%+.2f'|format(q.change_pct) }}%)</div>
              {% else %}
              <div class="tile-val font-mono">—</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>

          <!-- 跨海連動 ADR / 關鍵標的 (Row 2) -->
          <div class="tiles-grid">
            {% for symbol, label in [('TSM', '台積電 ADR'), ('NVDA', '輝達 (NVDA)'), ('AAPL', '蘋果 (AAPL)'), ('2330.TW', '台積電 現貨')] %}
            {% set q = indices.get(symbol) %}
            <div class="tile-card">
              <div class="tile-head">
                <span class="tile-name">{{ label }}</span>
              </div>
              {% if q and q.price is not none %}
              <div class="tile-val font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{{ "{:,.2f}".format(q.price) }}</div>
              <div class="tile-chg font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{% if q.change > 0 %}+{% endif %}{{ q.change }} ({{ '%+.2f'|format(q.change_pct) }}%)</div>
              {% else %}
              <div class="tile-val font-mono">—</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- 台股摘要與夜盤 -->
      {{ render_market_summary_cards(twse, financials, night, unref_count) }}

      <!-- 亞股開盤走勢 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">亞股開盤即時概況</h3>
          </div>
          <span class="card-tip">日韓早盤 · Yahoo 股市延遲 20 分鐘</span>
        </div>

        <div class="data-block">
          <div class="tiles-grid" style="grid-template-columns: repeat(2, 1fr); margin-bottom:0;">
            {% for symbol, label, yahoo_url in [('^N225', '日經 225', 'https://tw.stock.yahoo.com/quote/%5EN225'), ('^KS11', '韓國 KOSPI', 'https://tw.stock.yahoo.com/quote/%5EKS11')] %}
            {% set q = asia_open[symbol] if (asia_open and symbol in asia_open) else indices.get(symbol) %}
            <div class="tile-card asia-quote-card">
              <div class="tile-head">
                <span class="tile-name">{{ label }}</span>
              </div>
              <div class="tile-source-row">
                <a class="cal-link-btn" href="{{ yahoo_url }}" target="_blank" rel="noopener noreferrer" title="開啟 {{ label }} Yahoo 股市頁">Yahoo 股市 ↗</a>
                {% if q and q.updated_cst %}
                <span class="tile-delay-pill pill-fresh tile-quote-time" title="Yahoo 股市來源行情時間；非頁面建置時間">Yahoo 股市 · {{ q.updated_cst }} · 延遲 20 分鐘</span>
                {% else %}
                <span class="tile-delay-pill pill-amber tile-quote-time" title="Yahoo 股市未提供來源行情時間">Yahoo 股市 · 行情時間未提供</span>
                {% endif %}
              </div>
              {% if q and q.price is not none %}
              <div class="tile-val font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{{ "{:,.2f}".format(q.price) }}</div>
              <div class="tile-chg font-mono {% if q.change > 0 %}rise{% elif q.change < 0 %}fall{% endif %}">{% if q.change > 0 %}+{% endif %}{{ q.change }} ({{ '%+.2f'|format(q.change_pct) }}%)</div>
              {% else %}
              <div class="tile-val font-mono">—</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. 補充資訊 (News & Calendar) -->
    <section id="news-calendar" class="content-section">
      <div class="section-header">
        <h2 class="section-title"><span class="title-icon">📰</span> 補充資訊</h2>
        <span class="section-desc">隔夜重大新聞與財經行事曆</span>
      </div>

      <!-- 隔夜重大新聞 -->
      <div class="card">
        <div class="card-head">
          <div class="card-title-group">
            <h3 class="card-title">隔夜重大新聞 Top 10</h3>
            <span class="count-badge" id="news-count-badge">{{ news|length if news else 0 }} 則</span>
          </div>
        </div>
        <div class="data-block" id="news-lazy-block" data-news-src="data/news.json">
          <div class="news-list" id="news-list" style="display:flex; flex-direction:column; gap:8px;" hidden></div>
          <div class="empty" id="news-empty" style="padding:16px; text-align:center; color:var(--text-muted); font-size:12.5px;"{% if news and news|length > 0 %} hidden{% endif %}>
            ℹ️ 今日新聞來源暫時無法取得 · 系統將於下次排程自動重試
          </div>
        </div>
      </div>

      <!-- 財經行事曆 (時間軸儀表板) -->
      <div class="card cal-dashboard-card" id="cal-dashboard">
        <div class="card-head cal-dashboard-head">
          <div class="card-title-group">
            <h3 class="card-title">📅 財經行事曆</h3>
            <span class="count-badge" id="cal-count-badge">{{ calendar.events|length }} 筆</span>
            <span class="card-tip cal-next-event-tip" id="cal-next-event-tip" role="button" tabindex="0" hidden onclick="window.pm.focusNextHighImpactEvent()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.pm.focusNextHighImpactEvent()}"></span>
          </div>
          <div class="cal-head-tools">
            <button class="cal-tool-btn" onclick="window.pm.copyTodayHighImpact()" type="button" title="一鍵複製今日重要 ★★★ 事件 Markdown">📋 複製今日 ★★★</button>
            <button class="cal-tool-btn ghost" onclick="window.pm.toggleTimezoneMode()" id="cal-tz-btn" type="button" title="切換雙時區或純台北時間">🌐 雙時區 (ET/TPE)</button>
            <button class="cal-tool-btn ghost" onclick="window.pm.resetCalFilters()" type="button" title="重置行事曆篩選">↺ 重置</button>
          </div>
        </div>

        <!-- Sticky Filter Toolbar -->
        <div class="cal-filter-toolbar">
          <!-- Quick Filters -->
          <div class="cal-filter-row">
            <div class="cal-filter-group">
              <span class="cal-filter-lbl">快捷:</span>
              <button class="cal-chip active" data-filter="quick" data-val="all" onclick="window.pm.setCalQuickFilter('all')" type="button">全部</button>
              <button class="cal-chip" data-filter="quick" data-val="star3" onclick="window.pm.setCalQuickFilter('star3')" type="button">只看 ★★★</button>
              <button class="cal-chip" data-filter="quick" data-val="today" onclick="window.pm.setCalQuickFilter('today')" type="button">只看今日</button>
              <button class="cal-chip" data-filter="quick" data-val="this_week" onclick="window.pm.setCalQuickFilter('this_week')" type="button">只看本週</button>
            </div>
            <!-- Search box -->
            <div class="cal-search-wrap">
              <input type="text" id="cal-search-input" class="cal-search-input" placeholder="🔍 搜尋事件（如 CPI、GDP、非農...）" oninput="window.pm.onCalSearch(this.value)" autocomplete="off" aria-label="搜尋財經事件">
              <button class="cal-search-clear" onclick="window.pm.clearCalSearch()" type="button" aria-label="清除搜尋">✕</button>
            </div>
          </div>

          <!-- Filter chips: Country & Category -->
          <div class="cal-filter-row secondary">
            <!-- Country chips -->
            <div class="cal-filter-group">
              <span class="cal-filter-lbl">國家:</span>
              <button class="cal-chip" data-filter="country" data-val="US" onclick="window.pm.toggleCalCountry('US')" type="button">🇺🇸 US</button>
              <button class="cal-chip" data-filter="country" data-val="TW" onclick="window.pm.toggleCalCountry('TW')" type="button">🇹🇼 TW</button>
              <button class="cal-chip" data-filter="country" data-val="JP" onclick="window.pm.toggleCalCountry('JP')" type="button">🇯🇵 JP</button>
              <button class="cal-chip" data-filter="country" data-val="EU" onclick="window.pm.toggleCalCountry('EU')" type="button">🇪🇺 EU</button>
              <button class="cal-chip" data-filter="country" data-val="CN" onclick="window.pm.toggleCalCountry('CN')" type="button">🇨🇳 CN</button>
              <button class="cal-chip" data-filter="country" data-val="GB" onclick="window.pm.toggleCalCountry('GB')" type="button">🇬🇧 GB</button>
            </div>

            <!-- Category chips -->
            <div class="cal-filter-group">
              <span class="cal-filter-lbl">類別:</span>
              <button class="cal-chip" data-filter="cat" data-val="macro" onclick="window.pm.toggleCalCategory('macro')" type="button">總經</button>
              <button class="cal-chip" data-filter="cat" data-val="central_bank" onclick="window.pm.toggleCalCategory('central_bank')" type="button">央行</button>
              <button class="cal-chip" data-filter="cat" data-val="earnings" onclick="window.pm.toggleCalCategory('earnings')" type="button">財報</button>
              <button class="cal-chip" data-filter="cat" data-val="speech" onclick="window.pm.toggleCalCategory('speech')" type="button">演講</button>
              <button class="cal-chip" data-filter="cat" data-val="holiday" onclick="window.pm.toggleCalCategory('holiday')" type="button">假期</button>
            </div>
          </div>
        </div>

        <!-- Timeline Main Container -->
        <div class="data-block cal-timeline-container" id="cal-timeline-box">
          {% if calendar.date_groups %}
            {% for group in calendar.date_groups %}
            <div class="cal-date-section {{ 'is-today-section' if group.is_today else '' }}" data-date="{{ group.date_str }}">
              <div class="cal-date-header" onclick="window.pm.toggleDateGroup(this)">
                <span class="cal-date-title font-bold">{{ group.display_date }}</span>
                <span class="cal-date-count badge">{{ group.events|length }} 件</span>
                <span class="cal-accordion-arrow">▼</span>
              </div>

              <div class="cal-date-body {{ 'is-open' if group.open else '' }}">
                <div class="cal-timeline-track">
                  {% for ev in group.events %}
                  <div class="cal-event-card imp-level-{{ ev.importance }} {{ 'is-high-impact' if ev.importance == 3 else '' }}"
                       id="{{ ev.id }}"
                       data-id="{{ ev.id }}"
                       data-date="{{ ev.date }}"
                       data-datetime-utc="{{ ev.datetime_utc }}"
                       data-country="{{ ev.country }}"
                       data-category="{{ ev.category }}"
                       data-importance="{{ ev.importance }}"
                       data-title="{{ ev.title }}"
                       onclick="window.pm.toggleEventDetail('{{ ev.id }}')">

                    <!-- Left Timeline Node -->
                    <div class="cal-node-col">
                      <div class="cal-node-dot {{ 'high-node' if ev.importance == 3 else '' }}"></div>
                      <div class="cal-node-line"></div>
                    </div>

                    <!-- Right Card Content -->
                    <div class="cal-card-main">
                      <!-- Row 1: Time, Importance, Country, Category, Status -->
                      <div class="cal-card-top">
                        <div class="cal-time-group font-mono">
                          <span class="cal-time-origin">{{ ev.time_origin_str }}</span>
                          <span class="cal-time-tpe font-bold">{{ ev.time_tpe_str }}</span>
                          <span class="cal-countdown-badge" data-utc="{{ ev.datetime_utc }}"></span>
                        </div>
                        <div class="cal-badges-group">
                          {% if ev.importance == 3 %}
                          <span class="imp-badge imp-3" title="高重要性 (★★★)">★★★</span>
                          {% elif ev.importance == 2 %}
                          <span class="imp-badge imp-2" title="中重要性 (★★)">★★</span>
                          {% else %}
                          <span class="imp-badge imp-1" title="一般重要性 (★)">★</span>
                          {% endif %}
                          <span class="cal-country-badge font-mono">{{ ev.flag }} {{ ev.country }}</span>
                          <span class="cal-category-badge">{{ ev.category_name }}</span>
                        </div>
                      </div>

                      <!-- Row 2: Title -->
                      <div class="cal-card-title font-bold">{{ ev.title }}</div>

                      <!-- Row 3: 3-Column Metrics (Forecast / Previous / Actual) -->
                      <div class="cal-metrics-grid font-mono">
                        <div class="metric-cell">
                          <span class="metric-lbl">預期:</span>
                          <span class="metric-val">{{ ev.forecast or '—' }}</span>
                        </div>
                        <div class="metric-cell">
                          <span class="metric-lbl">前值:</span>
                          <span class="metric-val">{{ ev.previous or '—' }}</span>
                        </div>
                        <div class="metric-cell actual-cell {{ ev.comparison }}">
                          <span class="metric-lbl">實際:</span>
                          <span class="metric-val">
                            {% if ev.actual %}
                              {% if ev.comparison == 'beat' %}
                              <span class="cmp-icon rise">▲</span> {{ ev.actual }}
                              {% elif ev.comparison == 'miss' %}
                              <span class="cmp-icon fall">▼</span> {{ ev.actual }}
                              {% else %}
                              {{ ev.actual }}
                              {% endif %}
                            {% else %}
                              <span style="color:var(--text-muted); font-size:10px;">未公布</span>
                            {% endif %}
                          </span>
                        </div>
                      </div>

                      <!-- Expandable Details -->
                      <div class="cal-card-detail" id="detail-{{ ev.id }}">
                        {% if ev.note %}<div class="cal-note-text">{{ ev.note }}</div>{% endif %}
                        <div class="cal-action-links">
                          {% if ev.source_url %}
                          <a href="{{ ev.source_url }}" target="_blank" rel="noopener noreferrer" class="cal-link-btn" onclick="event.stopPropagation()">📊 MacroMicro 圖表 ↗</a>
                          {% endif %}
                          <button type="button" class="cal-link-btn" onclick="event.stopPropagation(); window.pm.copyEventText('{{ ev.id }}')">📋 複製事件</button>
                          <button type="button" class="cal-link-btn" onclick="event.stopPropagation(); window.pm.addToGoogleCalendar('{{ ev.id }}')">📅 加到 Google 行事曆</button>
                        </div>
                      </div>
                    </div>

                  </div>
                  {% endfor %}
                </div>
              </div>
            </div>
            {% endfor %}
          {% else %}
            <div class="empty-state">近期沒有排定的財經事件</div>
          {% endif %}
        </div>
      </div>
    </section>

  </main>

  <!-- BACK TO TOP BUTTON -->
  <button id="back-to-top" class="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" type="button" aria-label="回到頂部">▲</button>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="toast" role="alert" aria-live="polite"></div>


  <!-- KEYBOARD SHORTCUTS MODAL -->
  <div id="shortcuts-modal" class="modal-overlay" onclick="if(event.target===this)window.pm.toggleShortcutsModal()" role="dialog" aria-modal="true" aria-labelledby="shortcuts-modal-title" aria-hidden="true">
    <div class="modal-card">
      <div class="modal-head">
        <h3 class="modal-title" id="shortcuts-modal-title">⌨️ 鍵盤快捷鍵</h3>
        <button class="modal-close" type="button" onclick="window.pm.toggleShortcutsModal()" aria-label="關閉快捷鍵視窗">✕</button>
      </div>
      <div class="modal-body" style="padding:14px 16px;">
        <div class="shortcut-list">
          <div class="shortcut-item"><span class="kbd">1~6</span> <span>快速跳轉區塊</span></div>
          <div class="shortcut-item"><span class="kbd">b</span> <span>切換盤前速讀模式</span></div>
          <div class="shortcut-item"><span class="kbd">e</span> <span>匯出重點 Markdown</span></div>
          <div class="shortcut-item"><span class="kbd">c</span> <span>複製今日 ★★★ 事件</span></div>
          <div class="shortcut-item"><span class="kbd">d</span> <span>切換深/淺色</span></div>
          <div class="shortcut-item"><span class="kbd">w</span> <span>切換只看自選</span></div>
          <div class="shortcut-item"><span class="kbd">/</span> <span>聚焦自選輸入</span></div>
          <div class="shortcut-item"><span class="kbd">t</span> <span>回到頂部</span></div>
          <div class="shortcut-item"><span class="kbd">?</span> <span>開啟快捷鍵表</span></div>
          <div class="shortcut-item"><span class="kbd">Esc</span> <span>關閉所有彈窗</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- SOURCE STATUS AUDIT MODAL -->
  <div id="source-status-modal" class="modal-overlay" onclick="if(event.target===this)window.pm.closeSourceStatusModal()" role="dialog" aria-modal="true" aria-labelledby="status-modal-title" aria-hidden="true">
    <div class="modal-card modal-lg">
      <div class="modal-head">
        <h3 class="modal-title" id="status-modal-title">🛡️ 資料來源健康度與可信度稽核</h3>
        <button class="modal-close" type="button" onclick="window.pm.closeSourceStatusModal()" aria-label="關閉資料來源狀態視窗">✕</button>
      </div>
      <div class="modal-body" style="padding:16px;">
        <div class="status-modal-summary {{ o_badge }}">
          <div style="font-weight:700; font-size:14px; margin-bottom:4px;">目前狀態評級：{{ o_label }} ({{ o_status|upper }})</div>
          <ul style="margin:0; padding-left:18px; font-size:12.5px; line-height:1.5;">
            {% for r in o_reasons %}
            <li>{{ r }}</li>
            {% endfor %}
          </ul>
        </div>

        <div class="table-scroll" style="margin-top:12px;">
          <table class="data-table status-table">
            <caption class="sr-only">資料來源健康度與新鮮度清單</caption>
            <thead>
              <tr>
                <th scope="col">來源項目</th>
                <th scope="col">重要性</th>
                <th scope="col">技術狀態</th>
                <th scope="col">時效/新鮮度</th>
                <th scope="col">綜合評級</th>
                <th scope="col">取得時間</th>
                <th scope="col">適用日期</th>
                <th scope="col">對判讀影響</th>
              </tr>
            </thead>
            <tbody>
              {% set src_list = h.sources or (meta.sources if (meta is defined and meta and meta.sources is defined) else []) %}
              {% for src in src_list %}
              <tr>
                <td data-label="來源項目" class="font-bold">{{ src.name }}</td>
                <td data-label="重要性">
                  {% if src.is_required %}
                  <span class="badge badge-danger" style="background:var(--danger-bg); color:var(--danger-fg); border:1px solid var(--danger-border);">必要</span>
                  {% else %}
                  <span class="badge">非必要</span>
                  {% endif %}
                </td>
                <td data-label="技術狀態">
                  {% if src.fetch_status == 'ok' %}
                  <span class="status-badge is-ok">抓取成功</span>
                  {% elif src.fetch_status == 'fallback' or src.fallback_used %}
                  <span class="status-badge is-warning">使用備援</span>
                  {% elif src.fetch_status == 'failed' or src.status == 'failed' %}
                  <span class="status-badge is-danger">抓取失敗</span>
                  {% elif src.fetch_status == 'missing' or src.status == 'missing' %}
                  <span class="status-badge is-danger">資料缺失</span>
                  {% else %}
                  <span class="status-badge is-info">{{ src.fetch_status or src.status }}</span>
                  {% endif %}
                </td>
                <td data-label="時效/新鮮度">
                  {% if src.freshness == 'fresh' %}
                  <span class="badge badge-green" title="資料新鮮，符合當前盤前決策時效">新鮮</span>
                  {% elif src.freshness == 'stale' %}
                  <span class="badge badge-amber" title="資料已逾時（大於 12 小時）">已逾時</span>
                  {% elif src.freshness == 'expired' %}
                  <span class="badge badge-danger" title="資料嚴重過期（大於 24 小時）">嚴重過期</span>
                  {% else %}
                  <span class="badge">—</span>
                  {% endif %}
                </td>
                <td data-label="綜合評級">
                  <span class="status-badge {{ src.status_badge_class or ('is-ok' if src.status=='ok' else 'is-caution') }}">{{ src.combined_status_label or (src.status|upper) }}</span>
                </td>
                <td data-label="取得時間" class="font-mono" style="font-size:11px;">{{ src.fetched_at[11:16] if (src.fetched_at and src.fetched_at|length >= 16) else '—' }}</td>
                <td data-label="適用日期" class="font-mono" style="font-size:11.5px;">{{ src.data_date or '—' }}</td>
                <td data-label="對判讀影響" style="font-size:12px; color:var(--text-main);">{{ src.impact_desc }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-foot" style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; border-top:1px solid var(--border); flex-wrap:wrap; gap:8px;">
        <span style="font-size:11.5px; color:var(--text-muted);">建置基準時間：{{ build_time }}（每早 07:35 自動更新）</span>
        <div style="display:flex; gap:8px;">
          <button type="button" class="watch-btn" onclick="window.pm.closeSourceStatusModal()">關閉</button>
          <button type="button" class="watch-btn primary" id="btn-check-source-health" onclick="window.pm.checkSourceHealth(this)">🔄 重新整理檢查</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. 系統資訊 (System Info Footer) -->
  <footer id="system-info" class="page-footer">
    <div class="footer-inner">
      <details class="footer-details">
        <summary class="footer-summary">
          <span class="footer-summary-title">ℹ️ 系統與資料說明</span>
          <span class="footer-summary-badge">點擊展開說明 ▾</span>
        </summary>
        <div class="footer-content">
          <ul class="footer-notes">
            <li><strong>資料來源：</strong>處置股與財務公告來自 chengwaye.com；籌碼股來自 PressPlay 每日盤前專欄；指數報價來自 Yahoo Finance；新聞聚合來自 Google News；財經行事曆來自 MacroMicro。</li>
            <li><strong>排程機制：</strong>每日 07:35（台北）自動重建；盤前可在 GitHub Actions → Build premarket page → Run workflow 手動觸發，2 分鐘內完成</li>
            <li><strong>欄位說明：</strong>個股當沖明細原「總損益」欄位因公開資料無法可靠推算，為確保數據精準故不予顯示。</li>
            <li><strong>資料範圍：</strong>法人買賣與當沖明細僅涵蓋當日重點清單；未在清單內之標的自動略過。</li>
          </ul>
          <div class="footer-note" style="font-size:11px; color:var(--text-muted); margin-top:8px; text-align:center;">摘要來源：PressPlay 文章（僅供自用，未對外發布） · GitHub Actions 上次執行成功時間：<span class="font-mono">{{ build_time or '08:00' }}</span></div>
        </div>
      </details>
      <div class="footer-copy" style="margin-top:10px; text-align:center; font-size:11px; color:var(--text-muted);">盤前情報準備台 · 自用盤前決策工作台</div>
    </div>
  </footer>

<script>
  window.pm = window.pm || {};

  // Safe LocalStorage Parser with recovery toast
  function safeJsonParse(key, fallback) {
    try {
      var raw = localStorage.getItem(key);
      if (!raw) return fallback;
      var parsed = JSON.parse(raw);
      return parsed !== null && parsed !== undefined ? parsed : fallback;
    } catch(e) {
      console.warn('LocalStorage key corrupted:', key, e);
      try { localStorage.removeItem(key); } catch(ex) {}
      if (window.pm && typeof window.pm.showToast === 'function') {
        window.pm.showToast('⚠️ 本機偏好設定異常已自動修復');
      }
      return fallback;
    }
  }

  // LocalStorage Transparent Migration to pmit_ prefix
  (function() {
    try {
      if (!localStorage.getItem('pmit_theme')) {
        var oldTheme = localStorage.getItem('premarket.theme');
        if (oldTheme) { localStorage.setItem('pmit_theme', oldTheme); localStorage.removeItem('premarket.theme'); }
      }
      if (!localStorage.getItem('pmit_watchlist')) {
        var oldWatch = localStorage.getItem('premarket.watchlist');
