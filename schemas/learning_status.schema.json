{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimmyonnet.github.io/premarket-intel-tool/schemas/learning_status.schema.json",
  "title": "Opening model learning status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "model_version", "verified_days", "required_days", "stats", "confidence_breakdown", "pending_proposal", "manual_pause_remaining_days", "last_change", "message"],
  "properties": {
    "schema_version": {"const": "learning-status.v1"},
    "status": {"enum": ["warmup", "ready", "paused"]},
    "model_version": {"type": ["string", "null"]},
    "verified_days": {"type": "integer", "minimum": 0},
    "required_days": {"const": 20},
    "stats": {"anyOf": [{"$ref": "#/$defs/stats"}, {"type": "null"}]},
    "confidence_breakdown": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stats"}},
    "pending_proposal": {"type": ["object", "null"]},
    "manual_pause_remaining_days": {"type": "integer", "minimum": 0},
    "last_change": {"type": ["object", "null"]},
    "message": {"type": "string"}
  },
  "$defs": {
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_days", "direction_correct", "direction_accuracy", "mean_absolute_error_points"],
      "properties": {
        "sample_days": {"type": "integer", "minimum": 1},
        "direction_correct": {"type": "integer", "minimum": 0},
        "direction_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_absolute_error_points": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
