  window.pm.calendarCardMatchesFilters = function(card, section, ignoreTodayQuickFilter) {
    var quickVal = window.pm.calState.quick;
    var imp = parseInt(card.getAttribute('data-importance') || '1', 10);
    var country = card.getAttribute('data-country');
    var category = card.getAttribute('data-category');
    var title = (card.getAttribute('data-title') || '').toLowerCase();
    if (quickVal === 'star3' && imp < 3) return false;
    if (!ignoreTodayQuickFilter && quickVal === 'today' && !section.classList.contains('is-today-section')) return false;
    if (window.pm.calState.countries.length > 0 && window.pm.calState.countries.indexOf(country) < 0) return false;
    if (window.pm.calState.categories.length > 0 && window.pm.calState.categories.indexOf(category) < 0) return false;
    if (window.pm.calState.search && title.indexOf(window.pm.calState.search) < 0) return false;
    return true;
  };

  window.pm.findNextCalendarFallbackSection = function() {
    var nowMs = Date.now();
    var candidates = [];
    document.querySelectorAll('.cal-date-section').forEach(function(section) {
      section.querySelectorAll('.cal-event-card[data-datetime-utc]').forEach(function(card) {
        var eventMs = new Date(card.getAttribute('data-datetime-utc')).getTime();
        if (!isNaN(eventMs) && eventMs >= nowMs && window.pm.calendarCardMatchesFilters(card, section, true)) {
          candidates.push({ section: section, eventMs: eventMs });
        }
      });
    });
    candidates.sort(function(a, b) { return a.eventMs - b.eventMs; });
    return candidates.length ? candidates[0].section : null;
  };

  window.pm.applyCalendarFilters = function() {
    var quickVal = window.pm.calState.quick;
    document.querySelectorAll('.cal-chip[data-filter="quick"]').forEach(function(btn) {
      var isAct = (btn.getAttribute('data-val') === quickVal);
      btn.classList.toggle('active', isAct);
      btn.setAttribute('aria-pressed', isAct ? 'true' : 'false');
    });
    document.querySelectorAll('.cal-chip[data-filter="country"]').forEach(function(btn) {
      var isAct = (window.pm.calState.countries.indexOf(btn.getAttribute('data-val')) >= 0);
      btn.classList.toggle('active', isAct);
      btn.setAttribute('aria-pressed', isAct ? 'true' : 'false');
    });
    document.querySelectorAll('.cal-chip[data-filter="cat"]').forEach(function(btn) {
      var isAct = (window.pm.calState.categories.indexOf(btn.getAttribute('data-val')) >= 0);
      btn.classList.toggle('active', isAct);
      btn.setAttribute('aria-pressed', isAct ? 'true' : 'false');
    });

    var totalVisible = 0;
    var totalAll = 0;

    document.querySelectorAll('.cal-date-section').forEach(function(sec) {
      var visibleInSec = 0;

      sec.querySelectorAll('.cal-event-card').forEach(function(card) {
        totalAll++;
        var match = window.pm.calendarCardMatchesFilters(card, sec, false);

        card.style.display = match ? '' : 'none';
        if (match) {
          visibleInSec++;
          totalVisible++;
        }
      });

      sec.style.display = (visibleInSec > 0) ? '' : 'none';
      var countEl = sec.querySelector('.cal-date-count');
      if (countEl) countEl.textContent = visibleInSec + ' 件';
    });

    var fallbackSection = null;
    if (quickVal === 'today' && totalVisible === 0) {
      fallbackSection = window.pm.findNextCalendarFallbackSection();
      if (fallbackSection) {
        var fallbackVisible = 0;
        fallbackSection.querySelectorAll('.cal-event-card').forEach(function(card) {
          var matchFallback = window.pm.calendarCardMatchesFilters(card, fallbackSection, true);
          card.style.display = matchFallback ? '' : 'none';
          if (matchFallback) { fallbackVisible++; totalVisible++; }
        });
        fallbackSection.style.display = fallbackVisible > 0 ? '' : 'none';
        var fallbackCount = fallbackSection.querySelector('.cal-date-count');
        if (fallbackCount) fallbackCount.textContent = fallbackVisible + ' 件';
        window.pm.openCalendarDateSection(fallbackSection);
      }
    }

    // Update Header Badge & Filter Summary
    var badge = document.getElementById('cal-count-badge');
    if (badge) {
      if (fallbackSection) {
        var fallbackDate = fallbackSection.getAttribute('data-date') || '';
        badge.textContent = '今日無事件 · 顯示下一個：' + fallbackDate.slice(5).replace('-', '/');
      } else if (totalVisible === totalAll) {
        badge.textContent = totalAll + ' 筆';
      } else {
        badge.textContent = totalVisible + ' / ' + totalAll + ' 筆';
      }
    }

    var summaryEl = document.getElementById('cal-filter-summary');
    if (summaryEl) {
      var tags = [];
      if (quickVal === 'star3') tags.push('★★★ 重點');
      else if (quickVal === 'today') tags.push('今日事件');
      else if (quickVal === 'this_week') tags.push('本週事件');

      if (window.pm.calState.countries.length > 0) {
        tags.push(window.pm.calState.countries.join('/'));
      }
      if (window.pm.calState.categories.length > 0) {
        var catLabels = { macro:'總經', central_bank:'央行', earnings:'財報', speech:'演講', holiday:'假期' };
        tags.push(window.pm.calState.categories.map(function(k){ return catLabels[k] || k; }).join('/'));
      }
      if (window.pm.calState.search) {
        tags.push('搜尋 "' + window.pm.calState.search + '"');
      }

      if (tags.length > 0) {
        summaryEl.innerHTML = '📌 目前篩選：<strong>' + tags.join(' · ') + '</strong>（共 ' + totalVisible + ' 筆）';
        summaryEl.style.display = 'flex';
      } else {
        summaryEl.innerHTML = '顯示全部（共 ' + totalAll + ' 筆）';
        summaryEl.style.display = 'flex';
      }
    }

    var emptyEl = document.getElementById('cal-empty-state');
    if (emptyEl) emptyEl.style.display = (totalVisible === 0) ? 'block' : 'none';
  };

