      window.pm.showToast('未識別到有效的股票代號');
      return;
    }
    var finalCodes = [];
    if (override) {
      finalCodes = newCodes;
    } else {
      var raw = localStorage.getItem(window.WATCH_KEY);
      var curCodes = raw ? JSON.parse(raw) : [];
      finalCodes = curCodes.slice();
      newCodes.forEach(function(c) {
        if (finalCodes.indexOf(c) < 0) finalCodes.push(c);
      });
    }
    localStorage.setItem(window.WATCH_KEY, JSON.stringify(finalCodes));
    var inp = document.getElementById('watch-input');
