  function updateWatchlistStars() {
    var raw = localStorage.getItem(window.WATCH_KEY) || '[]';
    var codes = [];
    try { codes = JSON.parse(raw); } catch(e) { codes = []; }
    
    var guide = document.getElementById('watchlist-empty-guide');
    if (guide) guide.style.display = codes.length === 0 ? 'block' : 'none';

    var alertCount = 0;
    document.querySelectorAll('.watchlist-star-marker').forEach(function(star) {
      var code = star.getAttribute('data-code');
      var isWatched = codes.indexOf(code) >= 0;
      star.style.display = isWatched ? 'inline-block' : 'none';
      if (isWatched && star.closest('#alerts')) {
        alertCount++;
      }
    });

    var alertBanner = document.getElementById('watchlist-alert-banner');
    var alertCountEl = document.getElementById('watchlist-alert-count');
    if (alertBanner && alertCountEl) {
      alertCountEl.textContent = String(alertCount);
      alertBanner.style.display = alertCount > 0 ? 'flex' : 'none';
    }
  }

  function renderWatch() {
    var box = document.getElementById('watch-chips');
    var hint = document.getElementById('watch-hint');
    if (!box || !hint) return;
    box.innerHTML = '';
    
    var raw = localStorage.getItem(window.WATCH_KEY);
    var codes = raw ? JSON.parse(raw) : [];
    
    var totalBadge = document.getElementById('watch-total-badge');
    if (totalBadge) {
      totalBadge.textContent = codes.length + ' 檔';
      totalBadge.style.display = codes.length > 0 ? 'inline-flex' : 'none';
    }

    if (!codes.length) {
      hint.textContent = '💡 尚未建立自選股，請在上方搜尋框輸入代號或點擊「📋 批次匯入 / 備份」貼上 Excel 清單。';
      updateWatchlistStars();
      return;
    }
    hint.textContent = '';
    
    var stockMap = {};
    document.querySelectorAll('[data-code]').forEach(function(n) {
      var code = n.getAttribute('data-code');
      if (code && !stockMap[code]) {
        stockMap[code] = {
          type: n.getAttribute('data-cat') || 'normal',
          label: n.getAttribute('data-label') || ''
        };
      }
    });

    var hitAlerts = [];
    var hitCandidates = [];
    var otherStocks = [];

    codes.forEach(function(c) {
      var hit = stockMap[c];
      if (hit && (hit.type === 'alert' || hit.type === 'amber')) {
        hitAlerts.push({ code: c, hit: hit });
      } else if (hit && (hit.type === 'blue' || hit.type === 'normal')) {
        hitCandidates.push({ code: c, hit: hit });
      } else {
        otherStocks.push({ code: c, hit: hit });
      }
    });

    var curGrp = window.pm.watchFilterGroup || 'all';

    var statBar = document.createElement('div');
    statBar.className = 'watch-stat-bar';
    
    var statLeft = document.createElement('div');
    statLeft.className = 'watch-stat-left';
    statLeft.style.display = 'flex';
    statLeft.style.alignItems = 'center';
    statLeft.style.gap = '6px';
    statLeft.style.flexWrap = 'wrap';

    var allBtn = document.createElement('button');
    allBtn.type = 'button';
    allBtn.className = 'watch-stat-pill ' + (curGrp === 'all' ? 'is-active' : 'gray');
    allBtn.style.cursor = 'pointer';
    allBtn.style.border = 'none';
    allBtn.textContent = '⭐ 全部 (' + codes.length + ')';
    allBtn.onclick = function() { window.pm.setWatchFilterGroup('all'); };
    statLeft.appendChild(allBtn);

    var alertBtn = document.createElement('button');
    alertBtn.type = 'button';
    alertBtn.className = 'watch-stat-pill ' + (curGrp === 'alert' ? 'is-active ' : '') + (hitAlerts.length ? 'danger' : 'gray');
    alertBtn.style.cursor = 'pointer';
    alertBtn.style.border = 'none';
    alertBtn.textContent = '🚨 警示/處置 (' + hitAlerts.length + ')';
    alertBtn.onclick = function() { window.pm.setWatchFilterGroup('alert'); };
    statLeft.appendChild(alertBtn);

    var candBtn = document.createElement('button');
    candBtn.type = 'button';
    candBtn.className = 'watch-stat-pill ' + (curGrp === 'candidate' ? 'is-active ' : '') + (hitCandidates.length ? 'blue' : 'gray');
    candBtn.style.cursor = 'pointer';
    candBtn.style.border = 'none';
    candBtn.textContent = '🔵 候選觀察 (' + hitCandidates.length + ')';
    candBtn.onclick = function() { window.pm.setWatchFilterGroup('candidate'); };
    statLeft.appendChild(candBtn);

    var otherBtn = document.createElement('button');
    otherBtn.type = 'button';
    otherBtn.className = 'watch-stat-pill ' + (curGrp === 'other' ? 'is-active ' : '') + 'gray';
    otherBtn.style.cursor = 'pointer';
    otherBtn.style.border = 'none';
    otherBtn.textContent = '⚪ 其餘標的 (' + otherStocks.length + ')';
    otherBtn.onclick = function() { window.pm.setWatchFilterGroup('other'); };
    statLeft.appendChild(otherBtn);

    statBar.appendChild(statLeft);

    if (codes.length > 12 && curGrp === 'all') {
      var toggleBtn = document.createElement('button');
      toggleBtn.type = 'button';
      toggleBtn.className = 'watch-toggle-btn';
      toggleBtn.textContent = window.pm.watchlistExpanded ? '▴ 收合清單' : '▾ 展開全部 (' + codes.length + ' 檔)';
      toggleBtn.onclick = window.pm.toggleWatchlistExpand;
      statBar.appendChild(toggleBtn);
    }
    box.appendChild(statBar);

    function createChip(item) {
      var c = item.code;
      var hit = item.hit;
      var chip = document.createElement('span');
      chip.className = 'watch-chip';
      var icon = '⚪';
      if (hit && hit.type === 'alert') { chip.classList.add('alert'); icon = '🚨'; }
      else if (hit && hit.type === 'amber') { chip.classList.add('amber'); icon = '🟡'; }
      else if (hit && hit.type === 'blue') { chip.classList.add('blue'); icon = '🔵'; }

      chip.innerHTML = '<span>' + icon + '</span>'
        + '<span class="wc-code">' + c + '</span>'
        + (hit && hit.label ? '<span class="wc-name">' + hit.label + '</span>' : '')
        + '<span class="wc-del" onclick="event.stopPropagation(); window.delWatch(\'' + c + '\')" title="刪除">✕</span>';
      
      chip.onclick = function() {
        var targetRow = document.querySelector('tr[data-code="' + c + '"]');
        if (targetRow) {
          targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetRow.classList.remove('highlight-flash');
          void targetRow.offsetWidth;
          targetRow.classList.add('highlight-flash');
        } else {
          window.pm.showToast(c + ' 未出現在今日警示或候選清單中');
        }
      };
      return chip;
    }

    if ((curGrp === 'all' || curGrp === 'alert' || curGrp === 'candidate') && (hitAlerts.length || hitCandidates.length)) {
      var hitGroup = document.createElement('div');
      hitGroup.className = 'watch-group';
      hitGroup.innerHTML = '<div class="watch-group-title">🎯 盤前清單命中標的（點擊可定位至下方表格）</div>';
      var hitChips = document.createElement('div');
      hitChips.className = 'watch-chips-container';

      var targets = [];
      if (curGrp === 'all') targets = hitAlerts.concat(hitCandidates);
      else if (curGrp === 'alert') targets = hitAlerts;
      else if (curGrp === 'candidate') targets = hitCandidates;

      targets.forEach(function(item) {
        hitChips.appendChild(createChip(item));
      });
      if (targets.length > 0) {
        hitGroup.appendChild(hitChips);
        box.appendChild(hitGroup);
      }
    }

    if ((curGrp === 'all' || curGrp === 'other') && otherStocks.length) {
      var otherGroup = document.createElement('div');
      otherGroup.className = 'watch-group';
      var isCollapsible = (codes.length > 12 && curGrp === 'all');
      if (!isCollapsible || window.pm.watchlistExpanded) {
        otherGroup.innerHTML = '<div class="watch-group-title">⚪ 未觸發之自選標的 (' + otherStocks.length + ' 檔)</div>';
        var otherChips = document.createElement('div');
        otherChips.className = isCollapsible ? 'watch-chips-container watch-chips-scrollable' : 'watch-chips-container';
        otherStocks.forEach(function(item) {
          otherChips.appendChild(createChip(item));
        });
        otherGroup.appendChild(otherChips);
        box.appendChild(otherGroup);
      }
    }

    updateWatchlistStars();
  }

  // ==========================================
  // 8. Global Filters & UI Modes
  // ==========================================
  window.pm.watchOnly = localStorage.getItem('premarket.filterWatchOnly') === '1';
  window.pm.toggleWatchOnly = function() {
    window.pm.watchOnly = !window.pm.watchOnly;
    localStorage.setItem('premarket.filterWatchOnly', window.pm.watchOnly ? '1' : '0');
    window.pm.applyWatchOnly();
    if (window.pm.syncHash) window.pm.syncHash();
  };

  window.pm.applyWatchOnly = function() {
    var btn = document.getElementById('filter-watch-toggle');
    if (btn) btn.classList.toggle('is-active', window.pm.watchOnly);
    
    var raw = localStorage.getItem(window.WATCH_KEY);
    var codes = raw ? JSON.parse(raw) : [];

    document.querySelectorAll('tr[data-code]').forEach(function(row) {
      var code = row.getAttribute('data-code');
      if (!window.pm.watchOnly) {
        row.style.display = '';
      } else {
        row.style.display = (codes.indexOf(code) >= 0) ? '' : 'none';
      }
    });

    var alertBadge = document.getElementById('nav-alert-badge');
    if (alertBadge) {
      var visibleAlerts = document.querySelectorAll('#alerts tr[data-code]:not([style*="display: none"])').length;
      alertBadge.textContent = visibleAlerts;
    }
  };

  window.pm.toggleSnapshot = function() {
    document.body.classList.toggle('snapshot-mode');
    var isSnap = document.body.classList.contains('snapshot-mode');
    window.pm.showToast(isSnap ? '已開啟截圖模式（按 Esc 或點擊退出）' : '已關閉截圖模式');
  };

  window.pm.toggleMissingModal = function() {
    var m = document.getElementById('missing-modal');
    if (m) m.classList.toggle('is-open');
  };
  window.pm.showMissingModal = function() {
    var m = document.getElementById('missing-modal');
    if (m) m.classList.add('is-open');
  };

  window.pm.toggleShortcutsModal = function() {
    var m = document.getElementById('shortcuts-modal');
    if (m) m.classList.toggle('is-open');
  };

  window.toggleTheme = function() {
    var cur = document.documentElement.getAttribute('data-theme') === 'dark' ? '' : 'dark';
    document.documentElement.setAttribute('data-theme', cur);
    localStorage.setItem('premarket.theme', cur);
    var metaTheme = document.querySelector('meta[name="theme-color"]');
    if (metaTheme) metaTheme.content = cur === 'dark' ? '#0B1220' : '#F8FAFC';
    var b = document.getElementById('theme-toggle');
    if (b) b.textContent = cur === 'dark' ? '☀️ 淺色' : '🌙 深色';
    window.pm.syncIframeTheme(cur);
    if (window.pm.syncHash) window.pm.syncHash();
  };

  window.pm.syncIframeTheme = function(theme) {
    var cur = theme || document.documentElement.getAttribute('data-theme') || (localStorage.getItem('premarket.theme') === 'dark' ? 'dark' : 'light');
    if (!cur) cur = 'dark';
    
    document.querySelectorAll('iframe.unref-frame, iframe.embed-frame, iframe').forEach(function(iframe) {
      try {
        if (iframe.contentWindow) {
          iframe.contentWindow.postMessage({type: 'theme-change', theme: cur}, '*');
        }
      } catch(e){}
      try {
        if (iframe.contentDocument && iframe.contentDocument.documentElement) {
          iframe.contentDocument.documentElement.setAttribute('data-theme', cur);
          if (cur === 'dark') {
            iframe.contentDocument.documentElement.classList.add('dark');
            iframe.contentDocument.documentElement.classList.remove('light');
            if (iframe.contentDocument.body) {
              iframe.contentDocument.body.classList.add('dark');
              iframe.contentDocument.body.classList.remove('light');
            }
          } else {
            iframe.contentDocument.documentElement.classList.add('light');
            iframe.contentDocument.documentElement.classList.remove('dark');
            if (iframe.contentDocument.body) {
              iframe.contentDocument.body.classList.add('light');
              iframe.contentDocument.body.classList.remove('dark');
            }
          }
        }
      } catch(e){}
    });
  };

  window.pm.syncHash = function() {
    var curTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    var watch = window.pm.watchOnly ? '1' : '0';
    var hash = window.location.hash.split('?')[0] || '#summary';
    history.replaceState(null, '', hash + '?theme=' + curTheme + '&watch=' + watch);
  };

  window.pm.showToast = function(msg) {
    var toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(function() { toast.classList.remove('show'); }, 1500);
  };

  window.pm.toggleCondCollapsible = function(btn) {
    var box = btn.closest('.cond-collapsible');
    if (!box) return;
    var hidden = box.querySelector('.cond-hidden');
    if (!hidden) return;
    var isExp = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', !isExp);
    hidden.classList.toggle('is-open', !isExp);
    var count = btn.textContent.match(/\d+/);
    btn.textContent = !isExp ? '收合 ▲' : '+' + (count ? count[0] : '') + ' 條件 ▾';
  };

  // ==========================================
  // 9. Timers & Live Calculations
  // ==========================================
  var liveTimer = null;
  var countdownTimer = null;

  const TW_HOLIDAYS_2026 = [
    "2026-01-01", "2026-02-13", "2026-02-16", "2026-02-17", "2026-02-18", "2026-02-19",
    "2026-02-20", "2026-02-27", "2026-04-03", "2026-04-06", "2026-05-01", "2026-06-19",
    "2026-09-25", "2026-10-09", "2026-10-26"
  ];

  function isTWHoliday(d) {
    var dow = d.getDay();
    if (dow === 0 || dow === 6) return true;
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return TW_HOLIDAYS_2026.indexOf(y + '-' + m + '-' + day) >= 0;
  }

  function getNextTradingDayOpen(now) {
    var target = new Date(now.getTime());
    target.setHours(9, 0, 0, 0);
    if (!isTWHoliday(now) && now < target) {
      return target;
    }
    do {
      target.setDate(target.getDate() + 1);
    } while (isTWHoliday(target));
    return target;
  }

  function formatCountdownHuman(diffMs) {
    if (diffMs <= 0) return '00:00';
    var totalSec = Math.floor(diffMs / 1000);
    var days = Math.floor(totalSec / 86400);
    var hours = Math.floor((totalSec % 86400) / 3600);
    var mins = Math.floor((totalSec % 3600) / 60);
    var secs = totalSec % 60;

    if (days > 0) {
      return days + ' 天 ' + hours + ' 時 ' + mins + ' 分';
    } else if (hours > 0) {
      return hours + ' 時 ' + mins + ' 分';
    } else {
      return String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
    }
  }

  function updateSlowTimers() {
    var el = document.querySelector('.last-build');
    if (el) {
      var m = (el.textContent || '').match(/(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2})/);
      if (m) {
        var bt = new Date(m[1].replace(' ', 'T') + '+08:00').getTime();
        var hrs = (Date.now() - bt) / 36e5;
        var cls = hrs < 6 ? 'fresh' : (hrs < 12 ? 'aging' : 'stale');
        el.classList.remove('fresh', 'aging', 'stale');
        el.classList.add(cls);
        var banner = document.querySelector('.stale-banner');
        if (banner) {
          banner.textContent = '資料時間 ' + m[1] + '，距今 ' + hrs.toFixed(1) + ' 小時';
          banner.dataset.hours = String(Math.min(48, Math.floor(hrs)));
          banner.classList.toggle('is-warning', hrs >= 6 && hrs < 12);
          banner.classList.toggle('is-danger', hrs >= 12);
        }
      }
    }
  }

  function updateFastTimers() {
    var cel = document.getElementById('open-countdown');
    if (cel) {
      var now = new Date();
      var isHoliday = isTWHoliday(now);
      var openToday = new Date(now);
      openToday.setHours(9, 0, 0, 0);
      var closeToday = new Date(now);
      closeToday.setHours(13, 30, 0, 0);

      if (!isHoliday && now >= openToday && now < closeToday) {
        var diffClose = closeToday - now;
        cel.textContent = '● 盤中撮合中｜收盤倒數 ' + formatCountdownHuman(diffClose);
        cel.classList.remove('closed');
      } else {
        var nextOpen = getNextTradingDayOpen(now);
        var diffOpen = nextOpen - now;
        var prefix = isHoliday ? '休市中' : '今日已收盤';
        cel.textContent = prefix + '｜下次 09:00 開盤倒數 ' + formatCountdownHuman(diffOpen);
        cel.classList.add('closed');
      }
    }
    updateEventCountdowns();
  }

  function startTimers() {
    updateSlowTimers();
    updateFastTimers();
    if (!liveTimer) liveTimer = setInterval(updateSlowTimers, 60000);
    if (!countdownTimer) countdownTimer = setInterval(updateFastTimers, 1000);
  }

  function stopTimers() {
    if (liveTimer) { clearInterval(liveTimer); liveTimer = null; }
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
  }

  // ==========================================
  // 10. Global Event Listeners & Init
  // ==========================================
  window.addEventListener('message', function(e) {
    if (!e.data || e.data.type !== 'embed-height') return;
    var f = document.getElementById('embed-' + e.data.id);
    if (f && e.data.height) f.style.height = (e.data.height + 12) + 'px';
  });

  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
      if (e.key === 'Enter' && e.target.id === 'watch-input') {
        window.saveWatch();
      }
      if (e.key === 'Escape') {
        e.target.blur();
        if (window.pm.closeStockModal) window.pm.closeStockModal();
        document.querySelectorAll('.modal-overlay.is-open').forEach(function(m) {
          m.classList.remove('is-open');
        });
      }
      return;
    }

    if (e.key === 'Escape') {
      if (document.body.classList.contains('snapshot-mode')) {
        document.body.classList.remove('snapshot-mode');
      }
      if (window.pm.closeStockModal) window.pm.closeStockModal();
      document.querySelectorAll('.modal-overlay.is-open').forEach(function(m) {
        m.classList.remove('is-open');
      });
      return;
    }

    if (e.key === '1') {
      document.getElementById('summary')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '2') {
      document.getElementById('alerts')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '3') {
      document.getElementById('watchlist')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '4') {
      document.getElementById('market-context')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '5') {
      document.getElementById('news-calendar')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '6') {
      document.getElementById('system-info')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '/') {
      e.preventDefault();
      var inp = document.getElementById('watch-input');
      if (inp) { inp.focus(); inp.select(); }
    } else if (e.key === 'r' || e.key === 'R') {
      location.reload(true);
    } else if (e.key === 'd' || e.key === 'D') {
      window.toggleTheme();
    } else if (e.key === 'w' || e.key === 'W') {
      window.pm.toggleWatchOnly();
    } else if (e.key === 'b' || e.key === 'B') {
      window.pm.toggleBriefingMode();
    } else if (e.key === 'e' || e.key === 'E') {
      window.pm.exportDailyMarkdown();
    } else if (e.key === 'c' || e.key === 'C') {
      window.pm.copyTodayHighImpact();
    } else if (e.key === 't' || e.key === 'T') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (e.key === '?' || (e.shiftKey && e.key === '/')) {
      window.pm.toggleShortcutsModal();
    }
  });

  var btt = document.getElementById('back-to-top');
  window.addEventListener('scroll', function() {
    if (btt) btt.style.display = window.scrollY > 600 ? 'flex' : 'none';
  }, { passive: true });

  var sections = document.querySelectorAll('.content-section, #system-info');
  var navLinks = document.querySelectorAll('.nav-link');
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var id = entry.target.getAttribute('id');
          navLinks.forEach(function(link) {
            link.classList.toggle('is-active', link.getAttribute('href') === '#' + id);
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(function(sec) { observer.observe(sec); });
  }

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) stopTimers();
    else startTimers();
  });

  document.addEventListener('DOMContentLoaded', function() {
    var savedTheme = localStorage.getItem('premarket.theme');
    var urlParams = new URLSearchParams(window.location.hash.split('?')[1] || '');
    if (urlParams.get('theme')) savedTheme = urlParams.get('theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia && !window.matchMedia('(prefers-color-scheme: light)').matches)) {
      document.documentElement.setAttribute('data-theme', 'dark');
      var b = document.getElementById('theme-toggle');
      if (b) b.textContent = '☀️ 淺色';
      var metaTheme = document.querySelector('meta[name="theme-color"]');
      if (metaTheme) metaTheme.content = '#0B1220';
    }

    var rawWatch = localStorage.getItem(window.WATCH_KEY);
    var codes = rawWatch ? JSON.parse(rawWatch) : [];
    var inp = document.getElementById('watch-input');
    if (inp && codes.length) inp.value = codes.join(', ');
    renderWatch();

    if (urlParams.get('watch') === '1') window.pm.watchOnly = true;
    if (window.pm.watchOnly) window.pm.applyWatchOnly();

    setTimeout(function() {
      document.querySelectorAll('iframe.unref-frame').forEach(function(iframe) {
        var curH = parseInt(iframe.style.height || '0');
        if (curH <= 80) {
          var card = iframe.closest('.card') || iframe.parentElement;
          var existing = card.querySelector('.embed-fallback-notice');
          if (!existing) {
            var n = document.createElement('div');
            n.className = 'embed-fallback-notice';
            n.style.cssText = 'padding:14px; font-size:12px; color:var(--text-muted); text-align:center; background:var(--bg-sub); border-radius:6px; margin:8px 0;';
            n.textContent = '⚠️ 資料載入超時（已沿用 build-time 快照）';
            iframe.parentElement.appendChild(n);
          }
        }
      });
    }, 5000);

    if (window.pm.calState && window.pm.calState.search) {
      var sinp = document.getElementById('cal-search-input');
      if (sinp) sinp.value = window.pm.calState.search;
    }
    if (window.pm.applyCalendarFilters) window.pm.applyCalendarFilters();
    document.querySelectorAll('.unref-accordion').forEach(function(det) {
      det.addEventListener('toggle', function() {
        if (det.open) {
          var iframe = det.querySelector('iframe');
          if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage({type: 'request-height'}, '*');
          }
        }
      });
    });
    if (window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        if (!localStorage.getItem('premarket.theme')) {
          var newTheme = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', newTheme);
          var b = document.getElementById('theme-toggle');
          if (b) b.textContent = newTheme === 'dark' ? '☀️ 淺色' : '🌙 深色';
          window.pm.syncIframeTheme(newTheme);
        }
      });
    }

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'sw-updated') {
          var toast = document.getElementById('toast');
          if (toast) {
            toast.innerHTML = '🔄 偵測到最新盤前資料 <button onclick="location.reload(true)" style="background:var(--blue); color:#fff; border:none; border-radius:4px; padding:2px 8px; margin-left:6px; cursor:pointer; font-weight:700;">點此更新</button>';
            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 8000);
          }
        }
      });
    }

    window.pm.syncIframeTheme();
    startTimers();
  });
</script>

  
  <!-- BATCH IMPORT MODAL -->
  <div id="batch-modal" class="modal-overlay" onclick="if(event.target===this)window.pm.closeBatchModal()">
    <div class="modal-card">
      <div class="modal-head">
        <div class="modal-title">📋 批次匯入自選股（支援 Excel / CSV 複製貼上）</div>
