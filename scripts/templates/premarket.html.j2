    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    if (window.pm.lastFocusedTrigger && typeof window.pm.lastFocusedTrigger.focus === 'function') {
      try { window.pm.lastFocusedTrigger.focus(); } catch(e) {}
    }
  };

