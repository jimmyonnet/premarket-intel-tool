  window.pm.importWatchlistJson = function(e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(evt) {
      try {
        var parsed = JSON.parse(evt.target.result);
        if (!parsed || typeof parsed !== 'object') throw new Error('無效的 JSON 檔案');
        var list = Array.isArray(parsed) ? parsed : (parsed.watchlist || []);
        if (!Array.isArray(list)) throw new Error('缺少 watchlist 代號陣列');
        var validCodes = [];
        list.forEach(function(c) {
          var sc = String(c).trim();
          if (/^\d{4,5}$/.test(sc) && validCodes.indexOf(sc) < 0) {
            validCodes.push(sc);
          }
        });
        if (validCodes.length > 0) {
          var area = document.getElementById('batch-input-area');
          if (area) {
            area.value = validCodes.join('\n');
            window.pm.previewBatchCodes();
          }
          window.pm.showToast('已讀取備份檔 (' + validCodes.length + ' 檔)，請點擊「追加」或「覆蓋」套用');
        } else {
          window.pm.showToast('⚠️ JSON 檔案內未找到有效的股票代號');
        }
      } catch(err) {
        alert('⚠️ 匯入失敗：' + (err.message || 'JSON 解析錯誤'));
        window.pm.showToast('⚠️ JSON 解析失敗，未變更自選股');
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  };

