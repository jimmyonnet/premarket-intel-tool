<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>盤前情報準備台</title>
<style>
  :root{
    --ink:#0B0E14; --panel:#151A24; --panel-2:#1B2130; --line:#262D3D;
    --text:#ECEFF3; --muted:#8B93A6; --rise:#F0453A; --fall:#29D398; --amber:#E8B339;
    --font-ui: -apple-system, "Segoe UI", "PingFang TC", "Microsoft JhengHei", sans-serif;
    --font-mono: "SF Mono", "Cascadia Code", Consolas, monospace;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--ink); color:var(--text);
    font-family:var(--font-ui); line-height:1.5; padding:24px 16px 64px;
  }
  .wrap{max-width:900px; margin:0 auto;}
  header{display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--line);}
  h1{font-size:20px; margin:0; letter-spacing:.02em;}
  .generated{color:var(--muted); font-size:12px; font-family:var(--font-mono);}
  .part-title{font-size:14px; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; margin:32px 0 12px;}
  .part-title:first-of-type{margin-top:0;}
  section.part{margin-bottom:8px;}

  .warning-banner{background:rgba(240,69,58,.12); border:1px solid var(--rise); color:var(--rise); padding:10px 14px; border-radius:8px; font-size:13px; margin-bottom:16px;}
  .ok-banner{background:rgba(41,211,152,.08); border:1px solid var(--line); color:var(--muted); padding:8px 14px; border-radius:8px; font-size:12px; margin-bottom:16px; font-family:var(--font-mono);}

  .card{background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:18px; margin-bottom:16px;}
  .card h2{font-size:14px; margin:0 0 14px; color:var(--text); font-weight:600;}
  .card h2 .sub{color:var(--muted); font-weight:400; font-size:12px; margin-left:8px;}

  /* stat tiles */
  .tiles{display:grid; grid-template-columns:repeat(auto-fit, minmax(140px,1fr)); gap:10px;}
  .tile{background:var(--panel-2); border:1px solid var(--line); border-radius:10px; padding:12px 14px;}
  .tile .name{font-size:12px; color:var(--muted); margin-bottom:6px;}
  .tile .value{font-family:var(--font-mono); font-size:18px; font-weight:600;}
  .tile .delta{font-family:var(--font-mono); font-size:12px; margin-top:4px;}
  .tile .updated{font-size:10px; color:var(--muted); margin-top:6px; font-family:var(--font-mono);}
  .rise{color:var(--rise);}
  .fall{color:var(--fall);}
  .flat{color:var(--muted);}
  .missing{color:var(--muted); font-style:italic; font-size:12px;}

  /* sparkline */
  .spark-wrap{margin-bottom:14px;}
  .spark-stats{display:flex; gap:18px; font-family:var(--font-mono); font-size:12px; color:var(--muted); margin-top:8px; flex-wrap:wrap;}
  .spark-stats b{color:var(--text); font-weight:600;}
  svg.spark{width:100%; height:auto; display:block;}
  svg.spark .line{fill:none; stroke:var(--amber); stroke-width:2; stroke-linecap:round; stroke-linejoin:round;}
  svg.spark .refline{stroke:var(--muted); stroke-width:1; stroke-dasharray:3,4; opacity:.6;}
  svg.spark .dot{fill:var(--ink); stroke-width:2;}
  svg.spark .dot.rise{stroke:var(--rise);}
  svg.spark .dot.fall{stroke:var(--fall);}
  svg.spark .endlabel{font-family:var(--font-mono); font-size:11px; fill:var(--muted);}

  /* tables */
  table{width:100%; border-collapse:collapse; font-size:13px;}
  th{text-align:left; color:var(--muted); font-weight:500; font-size:11px; text-transform:uppercase; letter-spacing:.04em; padding:6px 10px; border-bottom:1px solid var(--line);}
  th.num{text-align:right;}
  td{padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top;}
  tr:last-child td{border-bottom:none;}
  td.code{font-family:var(--font-mono); color:var(--muted);}
  td.name{font-weight:600;}
  td.num{font-family:var(--font-mono); text-align:right;}
  td.exit-today{color:var(--amber); font-weight:700; font-family:var(--font-mono);}
  td.condition{color:var(--muted); font-size:12px; max-width:340px;}
  .empty-row td{color:var(--muted); font-style:italic; text-align:center; padding:16px;}
  .badge{display:inline-block; font-size:10px; padding:1px 6px; border-radius:4px; border:1px solid var(--line); color:var(--muted); font-family:var(--font-mono);}
  .badge.exit-today-badge{border-color:var(--amber); color:var(--amber);}
  .source-note{color:var(--muted); font-size:12px; margin:4px 0 0;}

  /* Part 2 "3①/5/6/12" rule-progress cells: a row of small dot segments
     (N total, first X filled) plus a small X/Y fraction underneath --
     mirrors the source site's dot-progress widget, which only shows its
     numbers on hover (no hover available here, so the fraction is always
     visible instead). */
  .badge-col{text-align:center; white-space:nowrap;}
  .badge-dots{display:flex; gap:1px; align-items:center; justify-content:center;}
  .badge-dots .dot{width:5px; height:11px; background:var(--panel-2); border:1px solid var(--line); border-radius:1px; flex-shrink:0;}
  .badge-dots .dot.filled{background:var(--amber); border-color:var(--amber);}
  .badge-frac{display:block; font-family:var(--font-mono); font-size:10px; color:var(--muted); margin-top:3px;}

  /* tables on narrow screens don't reflow -- they scroll horizontally
     within their own card instead of breaking the page layout. min-width
     keeps columns from being squished unreadably thin before the scroll
     kicks in. */
  .table-scroll{overflow-x:auto; -webkit-overflow-scrolling:touch;}
  .table-scroll table{min-width:540px;}
  .scroll-hint{display:none;}

  /* Part 3 extra: per-stock 法人買賣/當沖 detail (collapsed by default,
     native <details>/<summary> -- no JS needed on this static site). */
  .inst-detail{border-top:1px solid var(--line); padding:10px 0 2px;}
  .inst-detail:first-of-type{border-top:none; padding-top:0;}
  .inst-detail summary{cursor:pointer; font-size:13px; font-weight:600; padding:4px 0;}
  .inst-body{margin-top:12px;}
  .inst-body > *{margin-bottom:14px;}
  .inst-body > *:last-child{margin-bottom:0;}
  .sub-label{font-size:12px; color:var(--muted); margin-bottom:6px; font-weight:600;}
  .bubble-chart{width:100%; height:auto; display:block;}
  .bubble-chart .bubble-axis{stroke:var(--line); stroke-width:1; stroke-dasharray:3,4;}
  .bubble-chart .bubble-grid{stroke:var(--line); stroke-width:1; stroke-dasharray:2,3; opacity:.55;}
  .bubble-chart .bubble-tick{font-size:9px; fill:var(--muted); font-family:var(--font-mono); paint-order:stroke; stroke:var(--panel); stroke-width:3px; stroke-linejoin:round;}
  .bubble-chart .bubble{fill-opacity:.72; stroke-width:1;}
  .bubble-chart .bubble.buy{fill:var(--rise); stroke:var(--rise);}
  .bubble-chart .bubble.sell{fill:var(--fall); stroke:var(--fall);}
  .bubble-chart .bubble-name{font-size:11px; fill:var(--muted); font-family:var(--font-ui); paint-order:stroke; stroke:var(--panel); stroke-width:3px; stroke-linejoin:round;}
  .bubble-chart .bubble-side-label{font-size:11px; fill:var(--muted); font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.04em;}

  /* mobile: reclaim horizontal space (tighter padding/type), let tiles
     pack 2-up instead of stacking to 1 column. Tables are handled above
     via .table-scroll, not here -- they keep desktop-size columns and
     scroll instead of shrinking past readability. */
  @media (max-width: 480px){
    body{padding:16px 10px 48px;}
    h1{font-size:18px;}
    .card{padding:14px;}
    .tiles{grid-template-columns:repeat(auto-fit, minmax(110px,1fr));}
    .spark-stats{gap:8px 14px;}
    table{font-size:12px;}
    th{padding:6px 8px;}
    td{padding:7px 8px;}
    td.condition{max-width:160px;}
    .scroll-hint{display:block; font-size:11px; color:var(--muted); text-align:right; margin-top:6px;}
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>盤前情報準備台</h1>
    <div class="generated">產生時間 {{ generated_at }}</div>
  </header>

  {% if date_check and date_check.applies_to_matches_today is sameas false %}
  <div class="warning-banner">
    ⚠ 處置股資料日期核對失敗 — 頁面顯示適用 {{ date_check.page_says_applies_to }}，但今天是 {{ date_check.today }}。第二部分資料可能不是最新的，請自行到 chengwaye.com 確認。
  </div>
  {% elif date_check %}
  <div class="ok-banner">✓ 處置股資料日期核對通過（下拉選單：{{ date_check.page_dropdown_selected }} → 適用 {{ date_check.page_says_applies_to }}）</div>
  {% endif %}

  <div class="part-title">第一部分</div>
  <section class="part">

    <div class="card">
      <h2>台指期夜盤走勢 <span class="sub">WTXP& · 玩股網</span></h2>
      {% if spark %}
      <div class="spark-wrap">
        <svg class="spark" viewBox="0 0 {{ spark.width }} {{ spark.height }}" preserveAspectRatio="xMidYMid meet">
          {% if spark.prev_close_y is not none %}
          <line class="refline" x1="0" y1="{{ spark.prev_close_y }}" x2="{{ spark.width }}" y2="{{ spark.prev_close_y }}"/>
          <text class="endlabel" x="4" y="{{ spark.prev_close_y - 4 }}">昨收 {{ '%.0f'|format(spark.prev_close) }}</text>
          {% endif %}
          <polyline class="line" points="{{ spark.polyline }}"/>
          {% if spark.last_dot %}
          <circle class="dot {{ 'rise' if spark.is_rise else 'fall' }}" cx="{{ spark.last_dot.x }}" cy="{{ spark.last_dot.y }}" r="4"/>
          {% endif %}
          {% for d in spark.dots %}<title>{{ d.label }}</title>{% endfor %}
        </svg>
      </div>
      <div class="spark-stats">
        <span>開盤 <b>{{ night.open if night.open is not none else '—' }}</b></span>
        <span>最高 <b>{{ night.high if night.high is not none else '—' }}</b></span>
        <span>最低 <b>{{ night.low if night.low is not none else '—' }}</b></span>
        <span>昨收 <b>{{ night.prev_close if night.prev_close is not none else '—' }}</b></span>
        {% if night.latest %}
        <span>最新 <b class="{{ 'rise' if night.latest.change_pct is not none and night.latest.change_pct >= 0 else 'fall' }}">{{ night.latest.price }} ({{ '%+.2f'|format(night.latest.change_pct) if night.latest.change_pct is not none else '—' }}%)</b></span>
        {% endif %}
      </div>
      {% else %}
      <p class="missing">尚無夜盤資料點（collect-night-session 這個工作流程還沒跑過，或今晚是非交易夜）。</p>
      {% endif %}
    </div>

    <div class="card">
      <h2>美股四大指數 <span class="sub">前一夜收盤</span></h2>
      <div class="tiles">
        {% for key, tile in us_indices.items() %}
        {% if tile %}
        <div class="tile">
          <div class="name">{{ tile.name }}</div>
          <div class="value">{{ '{:,.2f}'.format(tile.value) }}</div>
          <div class="delta {{ 'rise' if tile.change_pct >= 0 else 'fall' }}">{{ '%+.2f'|format(tile.change) }} ({{ '%+.2f'|format(tile.change_pct) }}%)</div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="card">
      <h2>日股／韓股 08:00 開盤走勢</h2>
      <div class="tiles">
        {% for key, tile in asia_open.items() %}
        {% if tile %}
        <div class="tile">
          <div class="name">{{ tile.name }}</div>
          <div class="value">{{ '{:,.2f}'.format(tile.value) }}</div>
          <div class="delta {{ 'rise' if tile.change_pct >= 0 else 'fall' }}">{{ '%+.2f'|format(tile.change) }} ({{ '%+.2f'|format(tile.change_pct) }}%)</div>
          {% if tile.updated_cst %}<div class="updated">{{ tile.updated_cst }}</div>{% endif %}
        </div>
        {% endif %}
        {% endfor %}
      </div>
      {% if indices_missing %}
      <p class="missing">缺少欄位：{{ indices_missing|join('、') }}（來源頁面格式可能變了，需要人工檢查）</p>
      {% endif %}
    </div>

  </section>

  <div class="part-title">第二部分</div>
  <section class="part">

    <div class="card">
      <h2>🔴 差1次就處置 <span class="sub">{{ disposal.one_flag_from_disposal|length }} 檔</span></h2>
      <div class="table-scroll">
      <table>
        <thead><tr>
          <th>所</th><th>代號</th><th>名稱</th><th class="num">收盤</th>
          <th>{{ (date_check.page_says_applies_to.replace('/', '-') + ' ') if date_check.page_says_applies_to else '' }}處置標準條件（本站估算）</th>
          <th class="num">最快處置</th>
          <th class="badge-col" title="連續3日第1款">3①</th>
          <th class="badge-col" title="連續5日（第1~7款）">5</th>
          <th class="badge-col" title="10日內6次（第1~7款）">6</th>
          <th class="badge-col" title="30日內12次（第1~7款）">12</th>
        </tr></thead>
        <tbody>
          {% for row in disposal.one_flag_from_disposal %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}</td>
            <td class="num">{{ row.close }}</td>
            <td class="condition">{{ row.condition }}</td>
            <td class="num">{{ row.earliest_disposal }}</td>
            {% for bd in row.badges or [{}, {}, {}, {}] %}
            <td class="badge-col"{% if bd.title %} title="{{ bd.title }}"{% endif %}>
              {% if bd.threshold %}
              <div class="badge-dots">{% for i in range(bd.threshold) %}<span class="dot{{ ' filled' if i < bd.current else '' }}"></span>{% endfor %}</div>
              <span class="badge-frac">{{ bd.current }}/{{ bd.threshold }}</span>
              {% else %}
              <span class="badge-frac">—</span>
              {% endif %}
            </td>
            {% endfor %}
          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="10">今天沒有差1次就處置的股票</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if disposal.one_flag_from_disposal %}<div class="scroll-hint">← 左右滑動看更多欄位 →</div>{% endif %}
    </div>

    <div class="card">
      <h2>🟡 差2次處置 <span class="sub">{{ disposal.two_flags_from_disposal|length }} 檔</span></h2>
      <div class="table-scroll">
      <table>
        <thead><tr>
          <th>所</th><th>代號</th><th>名稱</th><th class="num">收盤</th>
          <th>{{ (date_check.page_says_applies_to.replace('/', '-') + ' ') if date_check.page_says_applies_to else '' }}注意股觸發價（本站估算）</th>
          <th class="num">最快處置</th>
          <th class="badge-col" title="連續3日第1款">3①</th>
          <th class="badge-col" title="連續5日（第1~7款）">5</th>
          <th class="badge-col" title="10日內6次（第1~7款）">6</th>
          <th class="badge-col" title="30日內12次（第1~7款）">12</th>
        </tr></thead>
        <tbody>
          {% for row in disposal.two_flags_from_disposal %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}</td>
            <td class="num">{{ row.close }}</td>
            <td class="condition">{{ row.condition }}</td>
            <td class="num">{{ row.earliest_disposal }}</td>
            {% for bd in row.badges or [{}, {}, {}, {}] %}
            <td class="badge-col"{% if bd.title %} title="{{ bd.title }}"{% endif %}>
              {% if bd.threshold %}
              <div class="badge-dots">{% for i in range(bd.threshold) %}<span class="dot{{ ' filled' if i < bd.current else '' }}"></span>{% endfor %}</div>
              <span class="badge-frac">{{ bd.current }}/{{ bd.threshold }}</span>
              {% else %}
              <span class="badge-frac">—</span>
              {% endif %}
            </td>
            {% endfor %}
          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="10">今天沒有差2次處置的股票</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if disposal.two_flags_from_disposal %}<div class="scroll-hint">← 左右滑動看更多欄位 →</div>{% endif %}
    </div>

    <div class="card">
      <h2>⚫ 目前處置中 <span class="sub">{{ disposal.currently_in_disposal|length }} 檔 · 分盤交易</span></h2>
      <div class="table-scroll">
      <table>
        <thead><tr><th>市場</th><th>代號</th><th>名稱</th><th>撮合</th><th class="num">開始</th><th class="num">結束</th><th class="num">出關日</th><th class="num">剩餘交易日</th><th>處置原因</th></tr></thead>
        <tbody>
          {% for row in disposal.currently_in_disposal %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}</td>
            <td>{{ row.matching }}</td>
            <td class="num">{{ row.start_date }}</td>
            <td class="num">{{ row.end_date }}</td>
            <td class="num{{ ' exit-today' if row.trading_days_left == '出關' else '' }}">{{ row.exit_date }}</td>
            <td class="num">{% if row.trading_days_left == '出關' %}<span class="badge exit-today-badge">出關</span>{% else %}{{ row.trading_days_left }}{% endif %}</td>
            <td class="condition">{{ row.reason }}</td>
          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="9">目前沒有股票在處置中</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if disposal.currently_in_disposal %}<div class="scroll-hint">← 左右滑動看更多欄位 →</div>{% endif %}
    </div>

  </section>

  <div class="part-title">第三部分</div>
  <section class="part">

    <div class="card">
      <h2>目前沒找到族群 <span class="sub">{{ pressplay.not_found_group.matched|length }}/{{ pressplay.not_found_group.raw_tokens|length }} 檔已比對</span></h2>
      {% if pressplay.source_article.title %}
      <div class="table-scroll">
      <table>
        <thead><tr><th>所</th><th>代號</th><th>名稱</th><th class="num">收盤</th><th class="num">量(張)</th><th class="num">外資</th><th class="num">投信</th><th class="num">自營</th><th>AI 理由</th><th>族群</th></tr></thead>
        <tbody>
          {% for row in pressplay.not_found_group.matched %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">疑似打錯字</span>{% endif %}</td>
            <td class="num">{{ row.close }}</td>
            <td class="num">{{ row.volume }}</td>
            <td class="num">{{ row.foreign }}</td>
            <td class="num">{{ row.trust }}</td>
            <td class="num">{{ row.dealer }}</td>
            <td class="condition">{{ row.ai_reason }}</td>
            <td>{{ row.group }}</td>
          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="10">今天此區塊沒有標的</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if pressplay.not_found_group.matched %}<div class="scroll-hint">← 左右滑動看更多欄位 →</div>{% endif %}
      {% if pressplay.not_found_group.unmatched %}
      <p class="missing">未比對到：{{ pressplay.not_found_group.unmatched|join('、') }}（原文可能打錯字或非台股代號，請自行到 chengwaye.com 確認）</p>
      {% endif %}
      {% else %}
      <p class="missing">尚無資料（PressPlay 收集流程還沒跑過，或今天沒有盤前文章）。</p>
      {% endif %}
    </div>

    <div class="card">
      <h2>目前發現有族群 <span class="sub">{{ pressplay.found_group.matched|length }}/{{ pressplay.found_group.raw_tokens|length }} 檔已比對</span></h2>
      {% if pressplay.source_article.title %}
      <div class="table-scroll">
      <table>
        <thead><tr><th>所</th><th>代號</th><th>名稱</th><th class="num">收盤</th><th class="num">量(張)</th><th class="num">外資</th><th class="num">投信</th><th class="num">自營</th><th>AI 理由</th><th>族群</th></tr></thead>
        <tbody>
          {% for row in pressplay.found_group.matched %}
          <tr>
            <td>{{ row.market }}</td>
            <td class="code">{{ row.code }}</td>
            <td class="name">{{ row.name }}{% if row.match_type == 'fuzzy_name' %} <span class="badge" title="原文：{{ row.raw_token }}">疑似打錯字</span>{% endif %}</td>
            <td class="num">{{ row.close }}</td>
            <td class="num">{{ row.volume }}</td>
            <td class="num">{{ row.foreign }}</td>
            <td class="num">{{ row.trust }}</td>
            <td class="num">{{ row.dealer }}</td>
            <td class="condition">{{ row.ai_reason }}</td>
            <td>{{ row.group }}</td>
          </tr>
          {% else %}
          <tr class="empty-row"><td colspan="10">今天此區塊沒有標的</td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% if pressplay.found_group.matched %}<div class="scroll-hint">← 左右滑動看更多欄位 →</div>{% endif %}
      {% if pressplay.found_group.unmatched %}
      <p class="missing">未比對到：{{ pressplay.found_group.unmatched|join('、') }}（原文可能打錯字或非台股代號，請自行到 chengwaye.com 確認）</p>
      {% endif %}
      {% else %}
      <p class="missing">尚無資料（PressPlay 收集流程還沒跑過，或今天沒有盤前文章）。</p>
      {% endif %}
    </div>

    {% if institutional.stocks %}
    <div class="card">
      <h2>個股法人買賣＋當沖明細 <span class="sub">{{ institutional.matched_count }}/{{ institutional.candidate_count }} 檔有資料{% if institutional.page_date %} · chengwaye.com 資料日期 {{ institutional.page_date }}{% endif %}</span></h2>
      {% for item in institutional.stocks %}
      <details class="inst-detail">
        <summary>{{ item.market }} {{ item.code }} {{ item.name }}　外資 {{ item.foreign }}／投信 {{ item.trust }}／自營 {{ item.dealer }}</summary>
        <div class="inst-body">
          {% if item.bubble %}
          <div>
            <div class="sub-label">買超／賣超氣泡圖（Y軸＝均價，X軸／面積＝買賣超張數 sqrt 比例）</div>
            <svg class="bubble-chart" viewBox="0 0 {{ item.bubble.width }} {{ item.bubble.height }}" preserveAspectRatio="xMidYMid meet">
              {% for pl in item.bubble.price_lines %}
              <line class="bubble-grid" x1="0" y1="{{ pl.y }}" x2="{{ item.bubble.width }}" y2="{{ pl.y }}"/>
              <text class="bubble-tick" x="2" y="{{ pl.y - 3 }}">{{ pl.label }}</text>
              {% endfor %}
              {% for vl in item.bubble.volume_lines %}
              <line class="bubble-grid" x1="{{ vl.x }}" y1="{{ item.bubble.plot_top }}" x2="{{ vl.x }}" y2="{{ item.bubble.plot_bottom }}"/>
              <text class="bubble-tick" x="{{ vl.x }}" y="{{ item.bubble.axis_label_y }}" text-anchor="middle">{{ vl.label }}</text>
              {% endfor %}
              <line class="bubble-axis" x1="{{ item.bubble.center_x }}" y1="{{ item.bubble.plot_top }}" x2="{{ item.bubble.center_x }}" y2="{{ item.bubble.plot_bottom }}"/>
              <text class="bubble-side-label buy" x="4" y="11">買超</text>
              <text class="bubble-side-label sell" x="{{ item.bubble.width - 4 }}" y="11" text-anchor="end">賣超</text>
              {% for b in item.bubble.bubbles %}
              <circle class="bubble {{ b.side }}" cx="{{ b.cx }}" cy="{{ b.cy }}" r="{{ b.r }}"><title>{{ b.title_text }}</title></circle>
              <text class="bubble-name" x="{{ b.cx }}" y="{{ b.cy - b.r - 6 }}" text-anchor="middle">{{ b.name }}</text>
              {% endfor %}
            </svg>
          </div>
          {% endif %}

          <div>
            <div class="sub-label">買超 Top15</div>
            <div class="table-scroll">
            <table>
              <thead><tr><th>券商</th><th class="num">買超</th><th class="num">買均</th><th class="num">買張</th><th class="num">賣張</th><th class="num">賣均</th></tr></thead>
              <tbody>
                {% for r in item.buyers %}
                <tr>
                  <td class="name">{{ r.name }}</td>
                  <td class="num rise">{{ r.net }}</td>
                  <td class="num">{{ r.buyP }}</td>
                  <td class="num">{{ r.buyV }}</td>
                  <td class="num">{{ r.sellV }}</td>
                  <td class="num">{{ r.sellP }}</td>
                </tr>
                {% else %}
                <tr class="empty-row"><td colspan="6">無資料</td></tr>
                {% endfor %}
              </tbody>
            </table>
            </div>
          </div>

          <div>
            <div class="sub-label">賣超 Top15</div>
            <div class="table-scroll">
            <table>
              <thead><tr><th>券商</th><th class="num">賣超</th><th class="num">買均</th><th class="num">買張</th><th class="num">賣張</th><th class="num">賣均</th></tr></thead>
              <tbody>
                {% for r in item.sellers %}
                <tr>
                  <td class="name">{{ r.name }}</td>
                  <td class="num fall">{{ r.net }}</td>
                  <td class="num">{{ r.buyP }}</td>
                  <td class="num">{{ r.buyV }}</td>
                  <td class="num">{{ r.sellV }}</td>
                  <td class="num">{{ r.sellP }}</td>
                </tr>
                {% else %}
                <tr class="empty-row"><td colspan="6">無資料</td></tr>
                {% endfor %}
              </tbody>
            </table>
            </div>
          </div>

          <div>
            <div class="sub-label">當沖 Top10</div>
            <div class="table-scroll">
            <table>
              <thead><tr><th>券商</th><th class="num">交易總數</th><th class="num">買張</th><th class="num">買均</th><th class="num">賣張</th><th class="num">賣均</th></tr></thead>
              <tbody>
                {% for r in item.daytraders %}
                <tr>
                  <td class="name">{{ r.name }}</td>
                  <td class="num">{{ r.total }}</td>
                  <td class="num">{{ r.buyV }}</td>
                  <td class="num">{{ r.buyP }}</td>
                  <td class="num">{{ r.sellV }}</td>
                  <td class="num">{{ r.sellP }}</td>
                </tr>
                {% else %}
                <tr class="empty-row"><td colspan="6">無資料</td></tr>
                {% endfor %}
              </tbody>
            </table>
            </div>
            <p class="source-note">原網頁另有「總損益」欄位；此欄位無法從可取得的資料可靠推算，避免顯示錯誤數字，故先省略。</p>
          </div>
        </div>
      </details>
      {% endfor %}
      <p class="source-note">資料來源：chengwaye.com/daily（僅涵蓋當日28檔清單，未在清單中的標的不會顯示此區塊）。</p>
    </div>
    {% endif %}

    {% if pressplay.source_article.title %}
    <p class="missing">資料來源：{{ pressplay.source_article.title }}{% if pressplay.chengwaye_date %} · chengwaye.com 適用 {{ pressplay.chengwaye_date }}{% endif %}</p>
    {% endif %}

  </section>

</div>
</body>
</html>
