  // ==========================================
  // 6. Robust Table Column Sorter
  // ==========================================
  window.pm.sortTable = function(th, colIdx) {
    var table = th.closest('table');
    if (!table) return;
    var tbody = table.querySelector('tbody');
    if (!tbody) return;
    var rows = Array.from(tbody.querySelectorAll('tr'));
    if (!rows.length) return;
    
    var curAsc = th.classList.contains('sort-asc') || th.classList.contains('asc');
    var isAsc = !curAsc;
    
    table.querySelectorAll('th').forEach(function(h) {
      h.classList.remove('sort-asc', 'sort-desc', 'asc', 'desc', 'sorted');
    });
    th.classList.add('sorted', isAsc ? 'sort-asc' : 'sort-desc', isAsc ? 'asc' : 'desc');

    function getVal(row) {
      var cell = row.children[colIdx];
      if (!cell) return '';
      if (cell.hasAttribute('data-sort')) {
        var sv1 = parseFloat(cell.getAttribute('data-sort'));
        return isNaN(sv1) ? cell.getAttribute('data-sort') : sv1;
      }
      if (cell.hasAttribute('data-sort-value')) {
        var sv2 = parseFloat(cell.getAttribute('data-sort-value'));
        return isNaN(sv2) ? cell.getAttribute('data-sort-value') : sv2;
      }
      var text = cell.textContent.trim();
      var dateMatch = text.match(/\b(?:\d{4}[-/])?(\d{2})[-/](\d{2})\b/);
      if (dateMatch) {
        return parseInt(dateMatch[1] + dateMatch[2], 10);
      }
      var numMatch = text.replace(/,/g, '').match(/[-+]?\d*\.?\d+/);
      if (numMatch) {
        var num = parseFloat(numMatch[0]);
        if (!isNaN(num)) return num;
      }
      return text.toLowerCase();
    }

    rows.sort(function(a, b) {
      var va = getVal(a);
      var vb = getVal(b);
      if (typeof va === 'number' && typeof vb === 'number') {
        return isAsc ? (va - vb) : (vb - va);
      }
      return isAsc ? String(va).localeCompare(String(vb), 'zh-Hant') : String(vb).localeCompare(String(va), 'zh-Hant');
    });

    rows.forEach(function(r) { tbody.appendChild(r); });
  };

