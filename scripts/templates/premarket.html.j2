      sec.querySelectorAll('.cal-event-card').forEach(function(card) {
        var imp = parseInt(card.getAttribute('data-importance') || '1');
        var country = card.getAttribute('data-country');
        var cat = card.getAttribute('data-category');
        var title = (card.getAttribute('data-title') || '').toLowerCase();
        var match = true;

        if (window.pm.calState.quick === 'star3' && imp < 3) match = false;
        if (window.pm.calState.quick === 'today' && !isToday) match = false;
        
        if (match && window.pm.calState.countries.length > 0) {
          if (window.pm.calState.countries.indexOf(country) < 0) match = false;
        }

        if (match && window.pm.calState.categories.length > 0) {
          if (window.pm.calState.categories.indexOf(cat) < 0) match = false;
        }

        if (match && window.pm.calState.search) {
          if (title.indexOf(window.pm.calState.search) < 0) match = false;
        }

        card.style.display = match ? '' : 'none';
        if (match) {
