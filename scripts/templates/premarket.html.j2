<!doctype html>
<html lang="zh-Hant" data-theme="light" data-density="comfortable">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="盤前情報準備台：處置股、籌碼股與盤前市場訊號">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="white">
  <title>盤前情報準備台 · {{ data_date or '今日' }}</title>
  <link rel="manifest" href="manifest.json">
  <link rel="stylesheet" href="assets/tokens.css">
  <link rel="stylesheet" href="assets/layout.css">
</head>
<body data-build-version="{{ build_version or '' }}">
  {%- set h = health if (health is defined and health) else (meta.health if (meta is defined and meta and meta.health is defined) else {}) %}
  {%- set o_status = h.overall_status or (meta.overall_status if meta is defined and meta else 'caution') %}
  {%- set o_label = h.status_label or (meta.status_label if meta is defined and meta else '請先確認資料') %}
  {%- set o_badge = h.status_badge_class or (meta.status_badge_class if meta is defined and meta else 'is-caution') %}
  {%- set o_reasons = (h.summary_reasons if (h.summary_reasons is defined and h.summary_reasons) else (meta.summary_reasons if (meta is defined and meta and meta.summary_reasons) else [])) or [] %}

  <header class="topbar" id="topbar">
    <a class="brand" href="#summary" aria-label="回到盤前摘要">盤前</a>
    <span class="date-chip" id="date-chip">{{ data_date or '今日' }} · {{ build_time or '—' }}{% if date_check_eval %}<span class="status-badge {{ date_check_eval.class_name }}" title="{{ date_check_eval.tooltip }}">{{ date_check_eval.label }}</span>{% endif %}</span>
    <button type="button" class="health-dot {{ o_badge }}" id="source-status-btn" aria-label="資料健康度：{{ o_label }}" aria-expanded="false" title="{{ o_reasons|join('；') }}">
      <span class="status-dot" aria-hidden="true"></span><span class="health-label">{{ o_label }}</span>
    </button>
    <nav class="tabs" aria-label="主要區塊">
      <a href="#summary" class="tab is-active">摘要</a>
      <a href="#alerts" class="tab">⚠️ 處置股</a>
      <a href="#watchlist" class="tab">🎯 籌碼股</a>
      <a href="#announcements" class="tab">財報</a>
      <a href="#market-context" class="tab">市場</a>
    </nav>
    <a class="cmdk manual-update-link" href="https://github.com/jimmyonnet/premarket-intel-tool/actions/workflows/build-premarket-page.yml" target="_blank" rel="noopener noreferrer" aria-label="開啟 GitHub Actions 手動更新頁面" title="開啟 GitHub Actions 手動更新頁面">🔄 手動更新資料</a>
    <button type="button" class="cmdk" id="cmdk-button" aria-keyshortcuts="Meta+K" aria-label="開啟命令面板">⌘K</button>
  </header>

  <div class="health-popover" id="health-popover" hidden>
    <div class="popover-head"><strong>資料健康度</strong><button type="button" class="icon-btn" data-close-health aria-label="關閉">×</button></div>
    <p id="health-summary">{{ o_reasons[0] if o_reasons else '所有必要來源均在時限內' }}</p>
    <div id="health-list" class="health-list"></div>
  </div>

  <main id="app" class="page-shell">
    {% if meta is defined and meta.show_banner %}<div class="briefing-card is-caution-alert" id="conditional-health-banner"><span>⚠️ 資料健康度需要確認</span><span class="briefing-reason">{{ o_reasons|join('；') }}</span></div>{% endif %}
    <section id="summary" class="summary-section" aria-labelledby="summary-title">
      <div class="section-heading"><div><span class="eyebrow">PREMARKET · {{ data_date or 'TODAY' }}</span><h1 id="summary-title">今日決策摘要</h1></div><span class="build-note">建置 {{ build_time or '—' }}</span></div>
      <details class="briefing-details" id="today-briefing-details">
        <summary class="briefing-summary" aria-label="展開資料可用性">
          <strong>📊 資料可用性</strong><span>{{ o_label }}</span>
        </summary>
        <div class="briefing-card {{ 'is-unsafe-alert' if o_status == 'unsafe' else ('is-caution-alert' if o_status == 'caution' else 'is-ready-card') }}" id="today-briefing-block">
          <strong>資料可用性 · 首屏契約</strong><span>{{ o_label }}</span><span class="briefing-reason">{{ o_reasons[0] if o_reasons else '處置、出關與籌碼訊號優先' }}</span>
        </div>
      </details>
      <section id="market-context" class="content-section market-context--hero" aria-labelledby="market-title">
        <div class="section-heading compact"><div><span class="eyebrow">CONTEXT</span><h2 id="market-title">市場背景</h2></div><span class="section-note">降級資訊</span></div>
        <div id="macro-panel" class="native-panel lazy-block" data-package="macro"><div class="loading">載入市場背景中…</div>{% if night is defined and night and night.latest %}<span hidden>來源：{{ night.latest.provider_name or night.provider_name }}</span>{% if night.latest.is_fallback %}<span hidden>⚠️ 抓取失敗，使用最近一次 fixtures/{{ night.date }}</span>{% endif %}{% endif %}</div>
      </section>
      <div class="action-deck" id="action-deck" aria-live="polite">
        <article class="deck deck-disposition"><header><h2>🔴 處置倒數</h2><span class="deck-count" id="disposition-count">—</span></header><div class="deck-body" id="disposition-deck"><div class="loading">載入中…</div></div></article>
        <article class="deck deck-release"><header><h2>🟢 今日出關</h2><span class="deck-count" id="release-count">—</span></header><div class="deck-body" id="release-deck"><div class="loading">載入中…</div></div></article>
        <article class="deck deck-watch"><header><h2>⭐ 自選命中</h2><span class="deck-count" id="watch-count">—</span></header><div class="deck-body" id="watch-deck"><div class="loading">載入中…</div></div></article>
      </div>
    </section>

    <section id="alerts" class="content-section block--offscreen" aria-labelledby="alerts-title">
      <div class="section-heading compact"><div><span class="eyebrow">RISK / RELEASE</span><h2 id="alerts-title">⚠️ 處置股</h2></div><span class="section-note">時間敏感訊號</span></div>
      <div id="disposition-panel" class="native-panel"><div class="loading">載入處置資料中…</div></div>
    </section>

    <section id="watchlist" class="content-section block--offscreen" aria-labelledby="watchlist-title">
      <div class="section-heading compact"><div><span class="eyebrow">FLOW / MOMENTUM</span><h2 id="watchlist-title">🎯 籌碼股</h2></div><span class="section-note" id="candidate-source">PressPlay · —</span></div>
      <div class="watchlist-manager" id="watchlist-manager">
        <div class="panel-toolbar"><label for="watchlist-input"><strong>自選股</strong></label><input class="filter-input" id="watchlist-input" type="text" inputmode="numeric" autocomplete="off" placeholder="輸入代號，例如 2330；可用逗號分隔多檔"><button class="ghost-btn" id="watchlist-add" type="button">加入</button></div>
        <p class="watchlist-hint">輸入股票代號後按 Enter 或「加入」；點選代號旁的 × 可移除。設定只儲存在本瀏覽器。</p>
        <div class="watchlist-chips" id="watchlist-chips" aria-live="polite"></div>
      </div>
      <div id="candidate-panel" class="native-panel"><div class="loading">載入籌碼股中…</div></div>
      <div id="crossmatch-panel" class="native-panel block--offscreen" hidden></div>
    </section>

    <details id="announcements" class="content-section block--offscreen" aria-labelledby="announcements-title" open>
      <summary class="section-heading compact" style="cursor:pointer; list-style:none;"><div><span class="eyebrow">EARNINGS ALPHA</span><h2 id="announcements-title">市場未反映公告</h2></div><span class="section-note">Δ 優先 · 7 欄</span></summary>
      <div id="announcements-panel" class="native-panel lazy-block" data-package="announcements"><div class="loading">展開或捲動後載入財報資料…</div></div>
    </details>


    <section id="news-calendar" class="content-section block--offscreen" aria-labelledby="calendar-title">
      <div class="section-heading compact"><div><span class="eyebrow">CATALYSTS</span><h2 id="calendar-title">補充資訊</h2></div><span class="section-note">行事曆 · 新聞</span></div>
      <div class="split-panels">
        <div id="calendar-panel" class="native-panel lazy-block" data-package="calendar"><div class="loading">載入行事曆中…</div></div>
        <div id="news-panel" class="native-panel lazy-block" data-package="news"><div class="loading">載入新聞中…</div></div>
      </div>
    </section>

    <section id="system-info" class="content-section system-section" aria-labelledby="system-title">
      <div class="section-heading compact"><div><span class="eyebrow">SYSTEM</span><h2 id="system-title">系統</h2></div><span class="section-note">Build {{ build_version or '—' }}</span></div>
      <div class="system-grid"><p>資料採分包載入；P0 優先顯示處置與市場，財報、行事曆與新聞採閒置或進入視窗後載入。</p><p id="package-status">尚未完成資料分包載入。</p></div>
    </section>
  </main>

  <dialog class="command-dialog" id="command-dialog" aria-labelledby="command-title">
    <div class="command-head"><h2 id="command-title">命令面板</h2><span>⌘K</span></div>
    <input id="command-input" type="search" autocomplete="off" placeholder="搜尋股票、區塊或功能…" aria-label="搜尋命令">
    <div id="command-list" class="command-list"></div>
    <p class="command-help">↑↓ 選擇 · Enter 執行 · Esc 關閉</p>
  </dialog>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  {% if not (meta is defined and meta and meta.schema_version is defined) %}
  {%- set legacy_hidden = (disposal.currently_in_disposal | selectattr('trading_days_left', 'none') | list) if disposal is defined and disposal else [] %}
  {% if legacy_hidden|length > 0 %}<!-- 隱藏 {{ legacy_hidden|length }} 筆（資料缺欄位，請回報） -->{% endif %}
  <div class="legacy-render-contract" hidden>{% for row in (disposal.currently_in_disposal if disposal is defined and disposal else []) %}{{ row.code }} {% endfor %}</div>
  {% endif %}

  <div class="source-status-modal" id="source-status-modal" role="dialog" aria-modal="true" aria-labelledby="source-status-title" hidden>
    <div class="modal-card"><div class="popover-head"><h2 id="source-status-title">資料來源狀態</h2><button type="button" class="icon-btn" data-close-health aria-label="關閉">×</button></div>
      <div id="source-status-content">
      {% for source in (h.sources if h.sources is defined and h.sources else []) %}<div class="health-row"><span>{{ source.name or source.source_id }}</span><span>{{ source.status or 'unknown' }}</span></div>{% endfor %}
      </div>
    </div>
  </div>
  <script type="module" src="assets/app.js"></script>
</body>
</html>
