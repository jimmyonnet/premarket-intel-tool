  // ==========================================
  // 6. Watchlist Core, Smart Parser & Grouping
  // ==========================================
  window.WATCH_KEY = 'pmit_watchlist';

  function smartParseWatchlist(rawText) {
    if (!rawText) return { valid: [], duplicates: [], invalid: [] };
    var lines = String(rawText).split(/[\r\n]+/);
    var valid = [];
    var duplicates = [];
    var invalid = [];
    var seen = {};

    lines.forEach(function(line) {
      var trimmed = line.trim();
      if (!trimmed) return;
      var tokens = trimmed.split(/[\t,;|\s]+/);

      tokens.forEach(function(tok) {
        tok = tok.trim();
        if (!tok) return;

        // Date formats: 2026/08/21, 2026-08-21, 08/21, 08-21
        if (/^\d{4}[\/\-]\d{1,2}[\/\-]\d{1,2}$/.test(tok) || /^\d{1,2}[\/\-]\d{1,2}$/.test(tok)) {
          invalid.push(tok + ' (疑似日期)');
          return;
        }

        // Time formats: 14:30, 09:00:00
        if (/^\d{1,2}:\d{2}(:\d{2})?$/.test(tok)) {
          invalid.push(tok + ' (疑似時間)');
          return;
        }

        // Percentages & Decimals: 12.34, +5.2%, -1.2%
        if (/^[+\-]?\d+(\.\d+)?%?$/.test(tok) && (tok.indexOf('.') >= 0 || tok.indexOf('%') >= 0)) {
          invalid.push(tok + ' (數值/比例)');
          return;
        }

        // Currency / formatting: $100, NT$100, 1,000
        if (/^[\$NT\$]?\d{1,3}(,\d{3})*(\.\d+)?$/.test(tok) && (tok.indexOf('$') >= 0 || tok.indexOf(',') >= 0)) {
          invalid.push(tok + ' (金額格式)');
          return;
        }

        // Stock code: 4 to 5 digits (e.g. 2330, 2454, 0050, 6716, 2330.TW)
        var match = tok.match(/^(\d{4,5})(\.TW|\.TWO)?$/i);
        if (match) {
          var code = match[1];
          if (!seen[code]) {
            seen[code] = 1;
            valid.push(code);
          } else {
            seen[code]++;
            if (duplicates.indexOf(code) < 0) duplicates.push(code);
          }
        } else {
          if (/^\d{6,}$/.test(tok)) {
            invalid.push(tok + ' (超過5位數字)');
          } else if (!/^[\u4e00-\u9fa5a-zA-Z]+$/.test(tok)) {
            invalid.push(tok);
          }
        }
      });
    });

    return { valid: valid, duplicates: duplicates, invalid: invalid };
  }

  function extractStockCodes(rawText) {
    return smartParseWatchlist(rawText).valid;
  }

  window.pm.previewBatchCodes = function() {
    var area = document.getElementById('batch-input-area');
    var valChips = document.getElementById('batch-chips-valid');
    var dupChips = document.getElementById('batch-chips-dup');
    var invChips = document.getElementById('batch-chips-invalid');
    var secDup = document.getElementById('batch-sec-dup');
    var secInv = document.getElementById('batch-sec-invalid');
    var cntVal = document.getElementById('batch-count-valid');
    var cntDup = document.getElementById('batch-count-dup');
    var cntInv = document.getElementById('batch-count-invalid');

    if (!area || !valChips) return;
    var parsed = smartParseWatchlist(area.value || '');

    if (cntVal) cntVal.textContent = String(parsed.valid.length);
    if (cntDup) cntDup.textContent = String(parsed.duplicates.length);
    if (cntInv) cntInv.textContent = String(parsed.invalid.length);

    valChips.innerHTML = '';
    parsed.valid.slice(0, 60).forEach(function(c) {
      var sp = document.createElement('span');
      sp.className = 'batch-chip is-valid';
      sp.textContent = c;
      valChips.appendChild(sp);
    });
    if (parsed.valid.length > 60) {
      var more = document.createElement('span');
      more.className = 'batch-chip';
      more.textContent = '...還有 ' + (parsed.valid.length - 60) + ' 檔';
      valChips.appendChild(more);
    }

    if (dupChips && secDup) {
      dupChips.innerHTML = '';
      if (parsed.duplicates.length > 0) {
        secDup.style.display = 'block';
        parsed.duplicates.forEach(function(c) {
          var sp = document.createElement('span');
          sp.className = 'batch-chip is-dup';
          sp.textContent = c;
          dupChips.appendChild(sp);
        });
      } else {
        secDup.style.display = 'none';
      }
    }

    if (invChips && secInv) {
      invChips.innerHTML = '';
      if (parsed.invalid.length > 0) {
        secInv.style.display = 'block';
        parsed.invalid.slice(0, 20).forEach(function(s) {
          var sp = document.createElement('span');
          sp.className = 'batch-chip is-invalid';
          sp.textContent = s;
          invChips.appendChild(sp);
        });
      } else {
        secInv.style.display = 'none';
      }
    }
  };

  window.pm.applyBatchCodes = function(override) {
    var area = document.getElementById('batch-input-area');
    var parsed = smartParseWatchlist(area.value || '');
    if (!parsed.valid.length) {
      window.pm.showToast('未識別到有效的股票代號');
      return;
    }

    var curCodes = safeJsonParse(window.WATCH_KEY, []);
    var finalCodes = [];

    if (override) {
      if (curCodes.length > 0 && !confirm('⚠️ 確認覆蓋自選股：\n現有自選股共 ' + curCodes.length + ' 檔，即將覆蓋為 ' + parsed.valid.length + ' 檔。\n確定要覆蓋嗎？')) {
        return;
      }
      finalCodes = parsed.valid;
    } else {
      finalCodes = curCodes.slice();
      parsed.valid.forEach(function(c) {
        if (finalCodes.indexOf(c) < 0) finalCodes.push(c);
      });
    }

    localStorage.setItem(window.WATCH_KEY, JSON.stringify(finalCodes));
    var inp = document.getElementById('watch-input');
    if (inp) inp.value = finalCodes.join(', ');
    renderWatch();
    if (window.pm.applyWatchOnly) window.pm.applyWatchOnly();
    window.pm.closeBatchModal();
    window.pm.showToast((override ? '已覆蓋自選股：' : '已追加自選股，共：') + finalCodes.length + ' 檔');
  };

