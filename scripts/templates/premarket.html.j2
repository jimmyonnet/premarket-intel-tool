  window.pm.showToast = function(msg) {
    var toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(function() { toast.classList.remove('show'); }, 1500);
  };

  window.pm.toggleCondCollapsible = function(btn) {
    var box = btn.closest('.cond-collapsible');
    if (!box) return;
    var hidden = box.querySelector('.cond-hidden');
    if (!hidden) return;
    var isExp = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', !isExp);
    hidden.classList.toggle('is-open', !isExp);
    var conditionKey = box.getAttribute('data-pmit-condition-key');
    if (conditionKey) {
      window.pm.uiState.conditions[conditionKey] = !isExp;
      window.pm.saveUiState();
    }
    var count = btn.textContent.match(/\d+/);
    btn.textContent = !isExp ? '收合 ▲' : '+' + (count ? count[0] : '') + ' 條件 ▾';
  };

  // ==========================================
  // 9. Timers & Live Calculations
  // ==========================================
  var liveTimer = null;
  var countdownTimer = null;

  const TW_HOLIDAYS = {{ (twse_holidays_list or []) | tojson }};

  function isTWHoliday(d) {
    var dow = d.getDay();
    if (dow === 0 || dow === 6) return true;
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    var isoDate = y + '-' + m + '-' + day;
    if (TW_HOLIDAYS && TW_HOLIDAYS.length > 0) {
      return TW_HOLIDAYS.indexOf(isoDate) >= 0;
    }
    return false;
  }

  function getNextTradingDayOpen(now) {
    var target = new Date(now.getTime());
    target.setHours(9, 0, 0, 0);
    if (!isTWHoliday(now) && now < target) {
      return target;
    }
    do {
      target.setDate(target.getDate() + 1);
    } while (isTWHoliday(target));
    return target;
  }

  function formatCountdownHuman(diffMs) {
    if (diffMs <= 0) return '00:00';
    var totalSec = Math.floor(diffMs / 1000);
    var days = Math.floor(totalSec / 86400);
    var hours = Math.floor((totalSec % 86400) / 3600);
    var mins = Math.floor((totalSec % 3600) / 60);
    var secs = totalSec % 60;

    if (days > 0) {
      return days + ' 天 ' + hours + ' 時 ' + mins + ' 分';
    } else if (hours > 0) {
      return hours + ' 時 ' + mins + ' 分';
    } else {
      return String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
    }
  }

  function updateSlowTimers() {
    var meta = window.__PM_META__ || {};
    var genStr = meta.build_time || '{{ meta.build_time if meta and meta.build_time else generated_at }}';
    if (!genStr) return;

    var genTime = new Date(genStr.replace(/\//g, '-').replace(' ', 'T') + ':00+08:00').getTime();
    if (isNaN(genTime)) genTime = new Date(genStr).getTime();
    if (isNaN(genTime)) return;

    var diffMs = Math.max(0, Date.now() - genTime);
    var hrs = diffMs / 36e5;

    // Update Header Age Badge
    var headerAge = document.getElementById('header-age-display');
    if (headerAge) {
      if (hrs < 0.1) {
        headerAge.textContent = '（剛剛）';
      } else if (hrs < 1) {
        headerAge.textContent = '（' + Math.max(1, Math.round(diffMs / 60000)) + 'm 前）';
      } else {
        headerAge.textContent = '（' + hrs.toFixed(1) + 'h 前）';
      }
    }

    var banner = document.querySelector('.stale-banner');
    if (banner) {
      if (hrs >= 12) {
        banner.textContent = '資料建置於 ' + genStr + '，距今 ' + hrs.toFixed(1) + ' 小時 (⚠️ 資料已逾 12 小時，建議於 GitHub Actions 手動重新觸發)';
        banner.dataset.hours = String(Math.min(48, Math.floor(hrs)));
        banner.className = 'stale-banner' + (hrs >= 24 ? ' is-danger' : ' is-warning');
        banner.style.display = 'block';
      } else {
        banner.style.display = 'none';
      }
    }

    var todayStr = new Date().toLocaleDateString('zh-TW', { month: '2-digit', day: '2-digit' }).replace('/', '-');
    document.querySelectorAll('tr[data-cat="amber"]').forEach(function(r) {
      var exitDateCell = r.querySelector('[data-label="預計出關"]');
      if (exitDateCell) {
        var rawSort = exitDateCell.getAttribute('data-sort') || '';
        var rawText = exitDateCell.textContent.replace(/🎉\s*今日出關/g, '').replace(/出關日\s*/g, '').trim();
        var cleanDate = (rawSort || rawText).replace('/', '-');
        if (cleanDate.indexOf(todayStr) >= 0 || (rawSort && rawSort.indexOf(todayStr) >= 0)) {
          exitDateCell.innerHTML = '<span class="badge badge-green">🎉 今日出關</span> <span class="font-mono">' + cleanDate + '</span>';
        } else if (cleanDate) {
          exitDateCell.innerHTML = '<span class="badge badge-amber">出關日 ' + cleanDate + '</span>';
        }
      }
    });
  }

  function updateFastTimers() {
    updateEventCountdowns();
  }

  function startTimers() {
    updateSlowTimers();
    updateFastTimers();
    if (!liveTimer) liveTimer = setInterval(updateSlowTimers, 60000);
    if (!countdownTimer) countdownTimer = setInterval(updateFastTimers, 1000);
  }

  function stopTimers() {
    if (liveTimer) { clearInterval(liveTimer); liveTimer = null; }
    if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
  }

  // ==========================================
  // 10. Global Event Listeners & Init
  // ==========================================
  window.addEventListener('message', function(e) {
    if (!e.data) return;
    if (window.location.origin && window.location.origin !== 'null' && e.origin && e.origin !== 'null' && e.origin !== window.location.origin) {
      return;
    }
    if (e.data.type === 'embed-height' && e.data.id) {
      var f = document.getElementById('embed-' + e.data.id);
      if (f && e.data.height) {
        var h = Math.min(1200, e.data.height + 8);
        f.style.height = h + 'px';
        f.style.overflowY = (e.data.height > 1200) ? 'auto' : 'hidden';
        var wrapper = document.getElementById('wrapper-' + e.data.id);
        if (wrapper) wrapper.classList.remove('is-loading');
        var fb = document.getElementById('fallback-' + e.data.id);
        if (fb) fb.style.display = 'none';
      }
    }
  });

  document.addEventListener('keydown', function(e) {
    var openModal = document.querySelector('.modal-overlay.is-open');

    // Focus trap within open modal
    if (openModal && e.key === 'Tab') {
      var focusables = Array.prototype.slice.call(openModal.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
      if (focusables.length > 0) {
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        if (e.shiftKey) {
          if (document.activeElement === first || !openModal.contains(document.activeElement)) {
            last.focus();
            e.preventDefault();
          }
        } else {
          if (document.activeElement === last || !openModal.contains(document.activeElement)) {
            first.focus();
            e.preventDefault();
          }
        }
      }
      return;
    }

    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
      if (e.key === 'Enter' && e.target.id === 'watch-input') {
        window.saveWatch();
      }
      if (e.key === 'Escape') {
        e.target.blur();
        if (openModal) {
          window.pm.closeModal(openModal.id);
        }
      }
      return;
    }

    if (e.key === 'Escape') {
      if (document.body.classList.contains('snapshot-mode')) {
        document.body.classList.remove('snapshot-mode');
      }
      if (openModal) {
        window.pm.closeModal(openModal.id);
      }
      return;
    }

    if (e.key === '1') {
      document.getElementById('summary')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '2') {
      document.getElementById('alerts')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '3') {
      document.getElementById('watchlist')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '4') {
      document.getElementById('market-context')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '5') {
      document.getElementById('news-calendar')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '6') {
      document.getElementById('system-info')?.scrollIntoView({ behavior: 'smooth' });
    } else if (e.key === '/') {
      e.preventDefault();
      var inp = document.getElementById('watch-input');
      if (inp) { inp.focus(); inp.select(); }
    } else if (e.key === 'r' || e.key === 'R') {
      location.reload(true);
    } else if (e.key === 'd' || e.key === 'D') {
      window.toggleTheme();
    } else if (e.key === 's' || e.key === 'S') {
      window.pm.toggleSnapshot();
    } else if (e.key === 'w' || e.key === 'W') {
      window.pm.toggleWatchOnly();
    } else if (e.key === 'b' || e.key === 'B') {
      window.pm.toggleBriefingMode();
    } else if (e.key === 'e' || e.key === 'E') {
      window.pm.exportDailyMarkdown();
    } else if (e.key === 'c' || e.key === 'C') {
      window.pm.copyTodayHighImpact();
    } else if (e.key === 't' || e.key === 'T') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (e.key === '?' || (e.shiftKey && e.key === '/')) {
      window.pm.toggleShortcutsModal();
    }
  });

  var btt = document.getElementById('back-to-top');
  window.addEventListener('scroll', function() {
    if (btt) btt.style.display = window.scrollY > 600 ? 'flex' : 'none';
  }, { passive: true });

  var sections = document.querySelectorAll('.content-section, #system-info');
  var navLinks = document.querySelectorAll('.nav-link');
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var id = entry.target.getAttribute('id');
          navLinks.forEach(function(link) {
            link.classList.toggle('is-active', link.getAttribute('href') === '#' + id);
          });
          if (window.matchMedia && window.matchMedia('(max-width: 768px)').matches) {
            var activeLink = Array.from(navLinks).find(function(link) {
              return link.getAttribute('href') === '#' + id;
            });
            if (activeLink) activeLink.scrollIntoView({ inline: 'center', block: 'nearest' });
          }
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(function(sec) { observer.observe(sec); });
  }

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) stopTimers();
    else startTimers();
  });

  window.pm.hydrateNews = function() {
    var block = document.getElementById('news-lazy-block');
    if (!block || block.getAttribute('data-news-loaded') === 'true' || block.getAttribute('data-news-loading') === 'true') return;
    block.setAttribute('data-news-loading', 'true');
    var src = block.getAttribute('data-news-src') || 'data/news.json';
    var list = document.getElementById('news-list');
    var empty = document.getElementById('news-empty');
    var badge = document.getElementById('news-count-badge');
    fetch(src, { credentials: 'same-origin' })
      .then(function(response) {
        if (!response.ok) throw new Error('news package unavailable');
        return response.json();
      })
      .then(function(payload) {
        var items = Array.isArray(payload) ? payload : (payload && Array.isArray(payload.items) ? payload.items : []);
        items = items.slice(0, 10);
        if (badge) badge.textContent = items.length + ' 則';
        if (!items.length) {
          if (list) { list.innerHTML = ''; list.hidden = true; }
          if (empty) empty.hidden = false;
          return;
        }
        if (list) {
          list.innerHTML = '';
          items.forEach(function(item) {
            var link = document.createElement('a');
            link.href = item.link || '#';
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className = 'news-item';
            link.style.cssText = 'text-decoration:none; color:inherit; padding:8px 0; border-bottom:1px solid var(--border);';
            var title = document.createElement('div');
            title.className = 'news-title';
            title.style.cssText = 'font-weight:600; font-size:13px; margin-bottom:4px;';
            title.textContent = item.title || '未提供標題';
            var meta = document.createElement('div');
            meta.className = 'news-meta font-mono';
            meta.style.cssText = 'font-size:11px; color:var(--text-muted); display:flex; gap:12px;';
            [item.source, item.time].forEach(function(value) {
              var span = document.createElement('span');
              span.textContent = value || '—';
              meta.appendChild(span);
            });
            link.appendChild(title);
            link.appendChild(meta);
            list.appendChild(link);
          });
          list.hidden = false;
        }
        if (empty) empty.hidden = true;
      })
      .catch(function() {
        if (list) { list.innerHTML = ''; list.hidden = true; }
        if (empty) empty.hidden = false;
      })
      .finally(function() {
        block.setAttribute('data-news-loading', 'false');
        block.setAttribute('data-news-loaded', 'true');
      });
  };

  window.pm.updateBriefingFreshness = function() {
    var target = document.getElementById('briefing-built-relative');
    if (!target) return;
    var meta = window.__PM_META__ || {};
    var stamp = meta.built_at || meta.build_time;
    if (!stamp) {
      target.textContent = '';
      return;
    }
    var normalized = String(stamp).trim().replace(' ', 'T');
    var parsed = new Date(normalized);
    if (isNaN(parsed.getTime())) {
      target.textContent = '';
      return;
    }
    var minutes = Math.max(0, Math.round((Date.now() - parsed.getTime()) / 60000));
    var label = minutes < 1 ? '剛剛更新' : (minutes < 60 ? minutes + ' 分鐘前更新' : (minutes < 1440 ? Math.floor(minutes / 60) + ' 小時前更新' : Math.floor(minutes / 1440) + ' 天前更新'));
    target.textContent = '· ' + label;
    target.title = '最後建置時間：' + String(stamp);
  };

  window.pm.refreshMobileScrollHints = function() {
    document.querySelectorAll('.table-scroll').forEach(function(scroller) {
      var overflowing = scroller.scrollWidth > scroller.clientWidth + 2;
      scroller.classList.toggle('is-overflowing', overflowing);
      if (!overflowing) scroller.classList.remove('is-scrolled');
    });
  };

  window.pm.bindMobileScrollHints = function() {
    document.querySelectorAll('.table-scroll').forEach(function(scroller) {
      if (scroller.dataset.mobileScrollBound === '1') return;
      scroller.dataset.mobileScrollBound = '1';
      scroller.addEventListener('scroll', function() {
        if (scroller.scrollLeft > 2) scroller.classList.add('is-scrolled');
      }, { passive: true });
    });
    window.pm.refreshMobileScrollHints();
  };

  window.pm.ensureDataLabels = function() {
    document.querySelectorAll('.data-table').forEach(function(tbl) {
      var heads = Array.from(tbl.querySelectorAll('thead th')).map(function(th) {
        return th.textContent.replace(/[▲▼\s]+/g, '').trim();
      });
      tbl.querySelectorAll(':scope > tbody > tr').forEach(function(tr) {
        Array.from(tr.children).forEach(function(td, i) {
          if (td.tagName === 'TD' && !td.hasAttribute('data-label') && heads[i]) {
            td.setAttribute('data-label', heads[i]);
          }
        });
      });
    });
  };

  document.addEventListener('DOMContentLoaded', function() {
    window.pm.updateBriefingFreshness();
    window.pm.ensureDataLabels();
    window.pm.bindMobileScrollHints();
    window.addEventListener('resize', window.pm.refreshMobileScrollHints, { passive: true });
    ['wheel', 'touchstart', 'keydown'].forEach(function(eventName) {
      document.addEventListener(eventName, function() { window.pm.calendarUserScrolled = true; }, { once: true, passive: true });
    });
    var savedTheme = localStorage.getItem('pmit_theme') || localStorage.getItem('premarket.theme');
    var urlParams = new URLSearchParams(window.location.hash.split('?')[1] || '');
    if (urlParams.get('theme')) savedTheme = urlParams.get('theme');
    var activeTheme = (savedTheme === 'dark') ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', activeTheme);
    var b = document.getElementById('theme-toggle');
    if (b) b.textContent = activeTheme === 'dark' ? '☀️ 淺色' : '🌙 深色';
    var metaTheme = document.querySelector('meta[name="theme-color"]');
    if (metaTheme) metaTheme.content = activeTheme === 'dark' ? '#0B1220' : '#F8FAFC';

    var rawWatch = localStorage.getItem(window.WATCH_KEY);
    var codes = safeJsonParse(window.WATCH_KEY, []);
    var inp = document.getElementById('watch-input');
    if (inp && codes.length) inp.value = codes.join(', ');
    renderWatch();

    if (window.pm.uiState.watchEditOpen) {
      var watchEditContainer = document.getElementById('watch-input-container');
      var watchEditButton = document.getElementById('watch-edit-toggle-btn');
      if (watchEditContainer) watchEditContainer.style.display = 'flex';
      if (watchEditButton) watchEditButton.innerHTML = '✕ 關閉編輯';
    }

    if (urlParams.get('watch') === '1') window.pm.watchOnly = true;
    if (window.pm.watchOnly) window.pm.applyWatchOnly();

    document.querySelectorAll('#watchlist tr.candidate-stock-row[data-detail-id]').forEach(function(row) {
      var detailId = row.getAttribute('data-detail-id');
      var detailRow = detailId ? document.getElementById(detailId) : null;
      if (detailRow && window.pm.uiState.candidateDetails[detailId] === true && row.style.display !== 'none') {
        detailRow.hidden = false;
        row.setAttribute('aria-expanded', 'true');
        row.classList.add('is-expanded');
      }
    });

    // Restore Briefing Mode
    if (localStorage.getItem('pmit_briefing_mode') === '1') {
      document.body.classList.add('briefing-mode');
      var bt = document.getElementById('briefing-toggle');
      if (bt) {
        bt.classList.add('is-active');
        bt.setAttribute('aria-pressed', 'true');
      }
    }
    if (window.pm.uiState.snapshotMode) document.body.classList.add('snapshot-mode');

    // 3-second timeout fallback check for embeds
    setTimeout(function() {
      ['att', 'fin', 'rev'].forEach(function(id) {
        var f = document.getElementById('embed-' + id);
        if (f) {
          var curH = parseInt(f.style.height || '0');
          if (curH <= 60) {
            var wrapper = document.getElementById('wrapper-' + id);
            if (wrapper) wrapper.classList.remove('is-loading');
            var fb = document.getElementById('fallback-' + id);
            if (fb) fb.style.display = 'flex';
          }
        }
      });
    }, 3000);

    if (window.pm.calState && window.pm.calState.search) {
      var sinp = document.getElementById('cal-search-input');
      if (sinp) sinp.value = window.pm.calState.search;
    }
    if (window.pm.applyCalendarFilters) window.pm.applyCalendarFilters();

    var newsBlock = document.getElementById('news-lazy-block');
    if (newsBlock) {
      if ('IntersectionObserver' in window) {
        var newsObserver = new IntersectionObserver(function(entries, observer) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              window.pm.hydrateNews();
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '500px 0px' });
        newsObserver.observe(newsBlock);
      } else {
        setTimeout(window.pm.hydrateNews, 0);
      }
    }

    var hasSavedCalendarGroups = Object.keys(window.pm.uiState.calendarGroups).length > 0;
    document.querySelectorAll('.cal-date-section[data-date]').forEach(function(sec) {
      var savedOpen = window.pm.uiState.calendarGroups[sec.getAttribute('data-date')];
      if (typeof savedOpen === 'boolean') {
        var savedBody = sec.querySelector('.cal-date-body');
        if (savedBody) savedBody.classList.toggle('is-open', savedOpen);
        sec.classList.toggle('open-sec', savedOpen);
      }
    });
    document.querySelectorAll('.cal-event-card[data-id]').forEach(function(card) {
      var savedEventOpen = window.pm.uiState.calendarEvents[card.getAttribute('data-id')];
      if (typeof savedEventOpen === 'boolean') card.classList.toggle('open', savedEventOpen);
    });

    // Auto-expand today's section only when no prior calendar preference exists.
    var todayDateSec = document.querySelector('.cal-date-section.is-today-section');
    if (todayDateSec && !hasSavedCalendarGroups) {
      var dBody = todayDateSec.querySelector('.cal-date-body');
      if (dBody && !dBody.classList.contains('is-open')) {
        dBody.classList.add('is-open');
        todayDateSec.classList.add('open-sec');
      }
    }
    window.pm.updateNextHighImpactPresentation();
    if (!todayDateSec) {
      setTimeout(function() { window.pm.autoFocusNextHighImpactEvent(hasSavedCalendarGroups); }, 0);
    }

    var detailCounters = {};
    document.querySelectorAll('details').forEach(function(det) {
      var section = det.closest('section');
      var scope = (section && section.id) || 'page';
      var classToken = (det.className || 'details').split(/\s+/)[0] || 'details';
      var counterKey = scope + ':' + classToken;
      detailCounters[counterKey] = (detailCounters[counterKey] || 0) + 1;
      var stateKey = det.id || (counterKey + ':' + detailCounters[counterKey]);
      det.setAttribute('data-pmit-state-key', stateKey);
      if (typeof window.pm.uiState.details[stateKey] === 'boolean') det.open = window.pm.uiState.details[stateKey];
      det.addEventListener('toggle', function() {
        window.pm.uiState.details[stateKey] = det.open;
        window.pm.saveUiState();
        if (det.open) {
          var iframe = det.querySelector('iframe');
          if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage({type: 'request-height'}, '*');
          }
        }
      });
    });
    document.querySelectorAll('.cond-collapsible').forEach(function(box, index) {
      var conditionKey = box.id || ('condition:' + index);
      box.setAttribute('data-pmit-condition-key', conditionKey);
      var desiredOpen = window.pm.uiState.conditions[conditionKey];
      var currentOpen = box.querySelector('.cond-hidden')?.classList.contains('is-open');
      var button = box.querySelector('[aria-expanded]');
      if (typeof desiredOpen === 'boolean' && button && desiredOpen !== currentOpen) {
        window.pm.toggleCondCollapsible(button);
      }
    });
    if (window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        if (!localStorage.getItem('pmit_theme') && !localStorage.getItem('premarket.theme')) {
          var newTheme = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', newTheme);
          var b = document.getElementById('theme-toggle');
          if (b) b.textContent = newTheme === 'dark' ? '☀️ 淺色' : '🌙 深色';
          window.pm.syncIframeTheme(newTheme);
        }
      });
    }

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'sw-updated') {
          var toast = document.getElementById('toast');
          if (toast) {
            toast.innerHTML = '🔄 偵測到最新盤前資料 <button onclick="location.reload()" style="background:var(--blue); color:#fff; border:none; border-radius:4px; padding:2px 8px; margin-left:6px; cursor:pointer; font-weight:700;">點此更新</button>';
            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 8000);
          }
        }
      });
    }

    window.pm.syncIframeTheme();
    startTimers();
  });
</script>


  <!-- BATCH IMPORT MODAL -->
  <div id="batch-modal" class="modal-overlay" onclick="if(event.target===this)window.pm.closeBatchModal()" role="dialog" aria-modal="true" aria-labelledby="batch-modal-title" aria-hidden="true">
    <div class="modal-card modal-lg">
      <div class="modal-head">
        <div class="modal-title" id="batch-modal-title">📋 批次匯入自選股（支援 Excel / CSV 複製貼上）</div>
        <button class="modal-close" type="button" onclick="window.pm.closeBatchModal()" aria-label="關閉批次匯入視窗">✕</button>
      </div>
      <div class="modal-body">
        <div style="font-size:12.5px; color:var(--text-muted); margin-bottom:10px; line-height:1.6;">
          💡 <strong>使用方式：</strong>直接複製 Excel 欄位貼在下方（代號或含名稱皆可），系統會自動排除日期（如 2026/08/21）、金額與符號並精準去重。
        </div>
        <textarea id="batch-input-area" class="batch-textarea" placeholder="在此貼上 Excel 欄位內容，例如：&#10;2330&#10;2454 聯發科&#10;3163 波若威&#10;6716&#10;...&#10;" oninput="window.pm.previewBatchCodes()"></textarea>

        <div class="batch-preview-box" id="batch-preview-box">
          <div class="batch-preview-sec" id="batch-sec-valid">
            <div class="batch-sec-head">
              <span style="color:var(--success-fg);">✅ 有效標的（<span id="batch-count-valid" class="font-mono">0</span> 檔）</span>
              <button type="button" class="btn-clear-preview" onclick="document.getElementById('batch-input-area').value=''; window.pm.previewBatchCodes();">清空輸入</button>
            </div>
            <div id="batch-chips-valid" class="batch-chips-container"></div>
          </div>
          <div class="batch-preview-sec" id="batch-sec-dup" style="display:none;">
            <div class="batch-sec-head">
              <span style="color:var(--blue-fg);">ℹ️ 重複標的（<span id="batch-count-dup" class="font-mono">0</span> 檔 · 已自動去重）</span>
            </div>
            <div id="batch-chips-dup" class="batch-chips-container"></div>
          </div>
          <div class="batch-preview-sec" id="batch-sec-invalid" style="display:none;">
            <div class="batch-sec-head">
              <span style="color:var(--warning-fg);">⚠️ 忽略項目 / 疑似日期（<span id="batch-count-invalid" class="font-mono">0</span> 項）</span>
            </div>
            <div id="batch-chips-invalid" class="batch-chips-container"></div>
          </div>
        </div>
      </div>
      <div class="modal-foot" style="justify-content: space-between; flex-wrap: wrap;">
        <div style="display:flex; gap:6px;">
          <button type="button" class="watch-btn" onclick="window.pm.exportWatchlistJson()" title="下載 JSON 備份檔">💾 匯出 JSON</button>
          <input type="file" id="json-backup-input" accept=".json" style="display:none;" aria-label="選擇自選股備份 JSON 檔案" onchange="window.pm.importWatchlistJson(event)">
          <button type="button" class="watch-btn" onclick="document.getElementById('json-backup-input').click()" title="從 JSON 備份檔還原">📥 匯入 JSON</button>
        </div>
        <div style="display:flex; gap:6px;">
          <button type="button" class="watch-btn" onclick="window.pm.closeBatchModal()">取消</button>
          <button type="button" class="watch-btn" onclick="window.pm.applyBatchCodes(false)">➕ 追加至現有</button>
          <button type="button" class="watch-btn primary" onclick="window.pm.applyBatchCodes(true)">🔄 覆蓋現有清單</button>
        </div>
      </div>
    </div>
  </div>

