  // ==========================================
  // 4. Daily Markdown Export & Download
  // ==========================================
  window.pm.generateDailyMarkdownText = function() {
    var lines = [];
    var meta = window.__PM_META__ || {};
    var buildTime = document.querySelector('.meta-item:nth-child(2) .meta-val')?.textContent.trim() || meta.build_time || '';
    var dataDate = document.querySelector('.meta-item:nth-child(1) .meta-val')?.textContent.trim() || meta.data_date || new Date().toISOString().split('T')[0];
    var twiiVal = document.querySelector('[data-metric="twii-close"]')?.textContent.trim() || '—';
    var twiiChg = document.querySelector('[data-metric="twii-change"]')?.textContent.trim() || '';
    var unrefVal = document.querySelector('[data-metric="unreflected-count"]')?.textContent.trim() || '0';

    var instEl = document.querySelector('[data-metric="institutional-chips"]');
    var instParts = [];
    if (instEl) {
      instEl.querySelectorAll('.chip').forEach(function(ch) {
        instParts.push(ch.textContent.trim().replace(/\s+/g, ' '));
      });
    }
    var alertRows = document.querySelectorAll('#alerts tr[data-code]');
    var isCautionOrUnsafe = meta.overall_status === 'unsafe' || meta.overall_status === 'caution';

    // YAML Frontmatter
    lines.push('---');
    lines.push('date: ' + dataDate);
    lines.push('type: premarket-journal');
    lines.push('tags:');
    lines.push('  - 盤前準備');
    lines.push('  - 交易決策');
    lines.push('twii_close: "' + twiiVal + '"');
    lines.push('twii_change: "' + twiiChg + '"');
    lines.push('institutional_chips: "' + (instParts.join(' | ') || '—') + '"');
    lines.push('disposal_alerts_count: ' + alertRows.length);
    lines.push('unreflected_announcements: "' + unrefVal + '"');
    lines.push('build_time: "' + buildTime + '"');
    lines.push('data_reliability: "' + (meta.status_label || '可用') + '"');
    lines.push('---\n');

    lines.push('# 📈 盤前情報決策總覽 · ' + dataDate);
    lines.push('> 產生時間：' + buildTime + ' ｜ 資料日期：' + dataDate);
    if (isCautionOrUnsafe) {
      lines.push('> ⚠️ **資料健康度警示**：' + (meta.summary_reasons || ['部分資料時效可能需確認']).join('；') + '\n');
    } else {
      lines.push('> ✅ 資料健康度：所有必要來源均已對齊且在時限內\n');
    }

    // 1. Market & Chips
    lines.push('## 1. 大盤與籌碼概況');
    lines.push('- **加權指數昨收**：' + twiiVal + (twiiChg ? ' (' + twiiChg + ')' : ''));
    lines.push('- **三大法人籌碼**：' + (instParts.length ? instParts.join(' ｜ ') : '—'));
    lines.push('- **市場未反映公告**：' + unrefVal);

    // 2. Alerts
    lines.push('\n## 2. 今日重點警示 (共 ' + alertRows.length + ' 檔)');
    if (alertRows.length > 0) {
      alertRows.forEach(function(r) {
        var code = r.getAttribute('data-code');
        var name = r.getAttribute('data-label') || '';
        var cat = r.getAttribute('data-cat') === 'alert' ? '差1次處置' : '今日出關';
        lines.push('- [' + cat + '] `' + code + '` ' + name);
      });
    } else {
      lines.push('- 今日無處置或出關預警標的');
    }

    // 3. High impact calendar
    lines.push('\n## 3. 今日重大財經事件 (★★★)');
    var events = document.querySelectorAll('.cal-date-section.is-today-section .cal-event-card[data-importance="3"]');
    if (events.length) {
      events.forEach(function(c) {
        var time = c.querySelector('.cal-time-tpe')?.textContent.trim() || '';
        var title = c.getAttribute('data-title') || '';
        lines.push('- ' + (time ? time + ' ' : '') + title);
      });
    } else {
      lines.push('- 今日無 ★★★ 重大事件');
    }

    return lines.join('\n');
  };

