  window.WATCH_KEY = 'premarket.watchlist';

  function extractStockCodes(rawText) {
    if (!rawText) return [];
    var matches = String(rawText).match(/\b\d{4,5}\b/g) || [];
    var unique = [];
    matches.forEach(function(c) {
      if (unique.indexOf(c) < 0) unique.push(c);
    });
    return unique;
  }

